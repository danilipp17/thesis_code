@prefix : <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@base <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> rdf:type owl:Ontology ;
                                                                       owl:imports <http://www.w3id.org/agentic-ai/onto> ;
                                                                       dc:creator "Dani Lippmann" ;
                                                                       dc:title "AgentOSCIn — Extension of the Agentic AI Ontology" ;
                                                                       dc:description "Extension of agentO adding agentic-system orchestration, coordination & reasoning patterns, memory bindings, guardrails, human checkpoints, termination conditions, schemas, and framework-mapping properties."@en ;
                                                                       rdfs:label "AgentOSCIn Ontology" ;
                                                                       owl:versionInfo 0.1 .

#################################################################
#    Object Properties
#################################################################

###  bindsMemory
:bindsMemory rdf:type owl:ObjectProperty ;
             rdfs:domain :MemoryBinding ;
             rdfs:range agento:Memory ;
             rdfs:comment "Links a memory binding to the memory it binds." ;
             rdfs:label "binds memory" .


###  containsAgent
:containsAgent rdf:type owl:ObjectProperty ;
               rdfs:domain :AgenticSystem ;
               rdfs:range agento:LLMAgent ;
               rdfs:comment "Relates an agentic system to an agent it contains." ;
               rdfs:label "contains agent" .


###  containsOrchestration
:containsOrchestration rdf:type owl:ObjectProperty ;
                       rdfs:domain :AgenticSystem ;
                       rdfs:range :Orchestration ;
                       rdfs:comment "Relates an agentic system to its orchestration." ;
                       rdfs:label "contains orchestration" .


###  containsTeam
:containsTeam rdf:type owl:ObjectProperty ;
              rdfs:domain :AgenticSystem ;
              rdfs:range agento:Team ;
              rdfs:comment "Relates an agentic system to a team it contains." ;
              rdfs:label "contains team" .


###  dependsOn
:dependsOn rdf:type owl:ObjectProperty ;
           rdfs:domain agento:Task ;
           rdfs:range agento:Task ;
           rdfs:comment "Indicates that one task depends on another." ;
           rdfs:label "depends on" .


###  employsCoordinationPattern
:employsCoordinationPattern rdf:type owl:ObjectProperty ;
                            rdfs:domain agento:Team ;
                            rdfs:range :CoordinationPattern ;
                            rdfs:comment "Relates a team to the coordination pattern it employs." ;
                            rdfs:label "employs coordination pattern" .


###  employsReasoningPattern
:employsReasoningPattern rdf:type owl:ObjectProperty ;
                         rdfs:domain agento:LLMAgent ;
                         rdfs:range :ReasoningPattern ;
                         rdfs:comment "Relates an agent to the reasoning pattern it employs." ;
                         rdfs:label "employs reasoning pattern" .


###  hasAgentMemoryBinding
:hasAgentMemoryBinding rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasMemoryBinding ;
                       rdfs:domain agento:LLMAgent ;
                       rdfs:range :MemoryBinding ;
                       rdfs:comment "Memory binding attached to an individual agent." ;
                       rdfs:label "has agent memory binding" .


###  hasAssociatedAgent
:hasAssociatedAgent rdf:type owl:ObjectProperty ;
                    rdfs:domain agento:WorkflowStep ;
                    rdfs:range agento:LLMAgent ;
                    rdfs:comment "Links a workflow step to the agent that executes it (e.g. a LangGraph node function implemented by a specific LLMAgent)." ;
                    rdfs:label "has associated agent" .


###  hasGuardrail
:hasGuardrail rdf:type owl:ObjectProperty ;
              rdfs:domain agento:Task ;
              rdfs:range :Guardrail ;
              rdfs:comment "Associates a guardrail with a task." ;
              rdfs:label "has guardrail" .


###  hasHumanCheckpoint
:hasHumanCheckpoint rdf:type owl:ObjectProperty ;
                    rdfs:domain agento:Task ;
                    rdfs:range :HumanCheckpoint ;
                    rdfs:comment "Associates a human-in-the-loop checkpoint with a task." ;
                    rdfs:label "has human checkpoint" .


###  hasMemoryBinding
:hasMemoryBinding rdf:type owl:ObjectProperty ;
                  rdfs:range :MemoryBinding ;
                  rdfs:comment "Associates a subject (agent, team, system) with a memory binding." ;
                  rdfs:label "has memory binding" .


###  hasOutputSchema
:hasOutputSchema rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Orchestration
                                             agento:Task
                                           )
                             ] ;
                 rdfs:range :Schema ;
                 rdfs:comment "Specifies the schema of the structured output produced by an orchestration or task." ;
                 rdfs:label "has output schema" .


###  hasSubCondition
:hasSubCondition rdf:type owl:ObjectProperty ;
                 rdfs:domain :CompositeTermination ;
                 rdfs:range :TerminationCondition ;
                 rdfs:comment "A sub-condition combined within a composite termination condition." ;
                 rdfs:label "has sub condition" .


###  hasTeamMemoryBinding
:hasTeamMemoryBinding rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasMemoryBinding ;
                      rdfs:domain agento:Team ;
                      rdfs:range :MemoryBinding ;
                      rdfs:comment "Memory binding attached to a team." ;
                      rdfs:label "has team memory binding" .


###  hasTerminationCondition
:hasTerminationCondition rdf:type owl:ObjectProperty ;
                         rdfs:domain agento:Team ;
                         rdfs:range :TerminationCondition ;
                         rdfs:comment "Relates a team to a termination condition that ends its execution." ;
                         rdfs:label "has termination condition" .


###  memoryBoundTo
:memoryBoundTo rdf:type owl:ObjectProperty ;
               rdfs:domain :MemoryBinding ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :AgenticSystem
                                          agento:LLMAgent
                                          agento:Team
                                        )
                          ] ;
               rdfs:comment "Links a memory binding to the agent, team, or system that owns it." ;
               rdfs:label "memory bound to" .


###  orchestratesTeam
:orchestratesTeam rdf:type owl:ObjectProperty ;
                  rdfs:domain :Orchestration ;
                  rdfs:range agento:Team ;
                  rdfs:comment "Relates an orchestration to the team it orchestrates." ;
                  rdfs:label "orchestrates team" .


###  taskToolUsage
:taskToolUsage rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf agento:toolUsage ;
               rdfs:domain agento:Task ;
               rdfs:range agento:Tool ;
               rdfs:comment "A tool used in the execution of a task." ;
               rdfs:label "task tool usage" .


#################################################################
#    Data properties
#################################################################

###  agentType
:agentType rdf:type owl:DatatypeProperty ;
           rdfs:domain agento:LLMAgent ;
           rdfs:range xsd:string ;
           rdfs:label "agent type" .


###  callsCrew
:callsCrew rdf:type owl:DatatypeProperty ;
           rdfs:domain agento:WorkflowStep ;
           rdfs:range xsd:string ;
           rdfs:comment "Key of the team/crew invoked by this workflow step (e.g. CrewAI @listen method calling crew.kickoff()). Enables per-step crew binding through the ontology round-trip." ;
           rdfs:label "calls crew" .


###  hasAggregationCombinator
:hasAggregationCombinator rdf:type owl:DatatypeProperty ;
                          rdfs:domain agento:WorkflowStep ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Combinator used to aggregate multiple predecessor steps in the source decorator (e.g. CrewAI @listen(or_(step_a, step_b)) stores \"or_\"). Values: \"or_\", \"and_\", or empty for single-predecessor steps." ;
                          rdfs:label "has aggregation combinator" .


###  hasCheckpointPosition
:hasCheckpointPosition rdf:type owl:DatatypeProperty ;
                       rdfs:domain :HumanCheckpoint ;
                       rdfs:range xsd:string ;
                       rdfs:label "has checkpoint position" .


###  hasCheckpointType
:hasCheckpointType rdf:type owl:DatatypeProperty ;
                   rdfs:domain :HumanCheckpoint ;
                   rdfs:range xsd:string ;
                   rdfs:label "has checkpoint type" .


###  hasDecoratorArgument
:hasDecoratorArgument rdf:type owl:DatatypeProperty ;
                      rdfs:domain agento:WorkflowStep ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Original literal argument(s) of the framework decorator that defined this step (e.g. CrewAI @start(\"wait_next_run\") or @listen(\"label\")). Preserves source-level identifiers that are not method names and therefore cannot be reconstructed from the inverse of nextStep edges." ;
                      rdfs:label "has decorator argument" .


###  hasDelegationStrategy
:hasDelegationStrategy rdf:type owl:DatatypeProperty ;
                       rdfs:domain agento:Task ;
                       rdfs:range xsd:string ;
                       rdfs:label "has delegation strategy" .


###  hasDependencyType
:hasDependencyType rdf:type owl:DatatypeProperty ;
                   rdfs:domain agento:Task ;
                   rdfs:range xsd:string ;
                   rdfs:label "has dependency type" .


###  hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string ;
                rdfs:label "has description" .


###  hasDirectiveFunction
:hasDirectiveFunction rdf:type owl:DatatypeProperty ;
                      rdfs:domain agento:Prompt ;
                      rdfs:range xsd:string ;
                      rdfs:label "has directive function" .


###  hasEdgeMapping
:hasEdgeMapping rdf:type owl:DatatypeProperty ;
                rdfs:domain agento:WorkflowStep ;
                rdfs:range xsd:string ;
                rdfs:label "has edge mapping" .


###  hasExpectedOutput
:hasExpectedOutput rdf:type owl:DatatypeProperty ;
                   rdfs:domain agento:Task ;
                   rdfs:range xsd:string ;
                   rdfs:label "has expected output" .


###  hasGuardrailType
:hasGuardrailType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Guardrail ;
                  rdfs:range xsd:string ;
                  rdfs:label "has guardrail type" .


###  hasImplementationReference
:hasImplementationReference rdf:type owl:DatatypeProperty ;
                            rdfs:domain agento:Tool ;
                            rdfs:range xsd:string ;
                            rdfs:label "has implementation reference" .


###  hasInputSchema
:hasInputSchema rdf:type owl:DatatypeProperty ;
                rdfs:domain agento:Tool ;
                rdfs:range xsd:string ;
                rdfs:label "has input schema" .


###  hasMaxReasoningAttempts
:hasMaxReasoningAttempts rdf:type owl:DatatypeProperty ;
                         rdfs:domain agento:LLMAgent ;
                         rdfs:range xsd:integer ;
                         rdfs:label "has max reasoning attempts" .


###  hasMaxRetries
:hasMaxRetries rdf:type owl:DatatypeProperty ;
               rdfs:domain :Guardrail ;
               rdfs:range xsd:integer ;
               rdfs:label "has max retries" .


###  hasMaxTurns
:hasMaxTurns rdf:type owl:DatatypeProperty ;
             rdfs:domain :TurnLimitTermination ;
             rdfs:range xsd:integer ;
             rdfs:label "has max turns" .


###  hasMemoryScope
:hasMemoryScope rdf:type owl:DatatypeProperty ;
                rdfs:domain :MemoryBinding ;
                rdfs:range xsd:string ;
                rdfs:label "has memory scope" .


###  hasOperator
:hasOperator rdf:type owl:DatatypeProperty ;
             rdfs:domain :CompositeTermination ;
             rdfs:range xsd:string ;
             rdfs:label "has operator" .


###  hasPersistenceScope
:hasPersistenceScope rdf:type owl:DatatypeProperty ;
                     rdfs:domain agento:Memory ;
                     rdfs:range xsd:string ;
                     rdfs:label "has persistence scope" .


###  hasReasoningEnabled
:hasReasoningEnabled rdf:type owl:DatatypeProperty ;
                     rdfs:domain agento:LLMAgent ;
                     rdfs:range xsd:boolean ;
                     rdfs:label "has reasoning enabled" .


###  hasReasoningOrigin
:hasReasoningOrigin rdf:type owl:DatatypeProperty ;
                    rdfs:domain agento:LLMAgent ;
                    rdfs:range xsd:string ;
                    rdfs:label "has reasoning origin" .


###  hasReference
:hasReference rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "has reference" .


###  hasRoutingLogic
:hasRoutingLogic rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ConditionalStep ;
                 rdfs:range xsd:string ;
                 rdfs:label "has routing logic" .


###  hasSchemaDefinition
:hasSchemaDefinition rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Schema ;
                     rdfs:range xsd:string ;
                     rdfs:label "has schema definition" .


###  hasSourceAttribute
:hasSourceAttribute rdf:type owl:DatatypeProperty ;
                    rdfs:domain agento:Prompt ;
                    rdfs:range xsd:string ;
                    rdfs:label "has source attribute" .


###  hasSourceFramework
:hasSourceFramework rdf:type owl:DatatypeProperty ;
                    rdfs:domain :AgenticSystem ;
                    rdfs:range xsd:string ;
                    rdfs:label "has source framework" .


###  hasTitle
:hasTitle rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string ;
          rdfs:label "has title" .


###  hasTriggerExpression
:hasTriggerExpression rdf:type owl:DatatypeProperty ;
                      rdfs:domain :EventBasedTermination ;
                      rdfs:range xsd:string ;
                      rdfs:label "has trigger expression" .


###  hasValidationLogic
:hasValidationLogic rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Guardrail ;
                    rdfs:range xsd:string ;
                    rdfs:label "has validation logic" .


###  isMandatory
:isMandatory rdf:type owl:DatatypeProperty ;
             rdfs:domain :HumanCheckpoint ;
             rdfs:range xsd:boolean ;
             rdfs:label "is mandatory" .


#################################################################
#    Classes
#################################################################

###  AgenticSystem
:AgenticSystem rdf:type owl:Class ;
               rdfs:subClassOf beam:System ;
               rdfs:comment "A complete agentic AI system encompassing one or more agents, teams, and an orchestration." ;
               rdfs:label "Agentic System" .


###  ChainOfThought
:ChainOfThought rdf:type owl:Class ;
                rdfs:subClassOf :ReasoningPattern ;
                rdfs:label "Chain of Thought" .


###  CompositeTermination
:CompositeTermination rdf:type owl:Class ;
                      rdfs:subClassOf :TerminationCondition ;
                      rdfs:comment "A termination condition built by combining other conditions via a logical operator." ;
                      rdfs:label "Composite Termination" .


###  ConditionalStep
:ConditionalStep rdf:type owl:Class ;
                 rdfs:subClassOf agento:WorkflowStep ;
                 rdfs:comment "A workflow step that branches based on routing logic." ;
                 rdfs:label "Conditional Step" .


###  CoordinationPattern
:CoordinationPattern rdf:type owl:Class ;
                     rdfs:comment "A pattern of coordination among agents in a team (e.g. sequential, hierarchical, swarm)." ;
                     rdfs:label "Coordination Pattern" .


###  EventBasedTermination
:EventBasedTermination rdf:type owl:Class ;
                       rdfs:subClassOf :TerminationCondition ;
                       rdfs:label "Event Based Termination" .


###  Guardrail
:Guardrail rdf:type owl:Class ;
           rdfs:comment "A validation, safety, or policy check applied to a task." ;
           rdfs:label "Guardrail" .


###  HumanCheckpoint
:HumanCheckpoint rdf:type owl:Class ;
                 rdfs:comment "A human-in-the-loop checkpoint inserted into task execution." ;
                 rdfs:label "Human Checkpoint" .


###  MemoryBinding
:MemoryBinding rdf:type owl:Class ;
               rdfs:comment "A reified link between a memory and the agent, team, or system that uses it, with scope and configuration." ;
               rdfs:label "Memory Binding" .


###  Orchestration
:Orchestration rdf:type owl:Class ;
               rdfs:subClassOf agento:Team ;
               rdfs:comment "A controller that orchestrates one or more teams to execute a workflow." ;
               rdfs:label "Orchestration" .


###  ReAct
:ReAct rdf:type owl:Class ;
       rdfs:subClassOf :ReasoningPattern ;
       rdfs:label "ReAct" .


###  ReasoningPattern
:ReasoningPattern rdf:type owl:Class ;
                  rdfs:comment "A reasoning strategy adopted by an agent (e.g. chain-of-thought, ReAct, tree-of-thoughts)." ;
                  rdfs:label "Reasoning Pattern" .


###  ReflectionLoop
:ReflectionLoop rdf:type owl:Class ;
                rdfs:subClassOf :ReasoningPattern ;
                rdfs:label "Reflection Loop" .


###  RoutingTermination
:RoutingTermination rdf:type owl:Class ;
                    rdfs:subClassOf :TerminationCondition ;
                    rdfs:label "Routing Termination" .


###  Schema
:Schema rdf:type owl:Class ;
        rdfs:comment "A structured-output schema (e.g. JSON Schema, Pydantic model)." ;
        rdfs:label "Schema" .


###  TaskCompletionTermination
:TaskCompletionTermination rdf:type owl:Class ;
                           rdfs:subClassOf :TerminationCondition ;
                           rdfs:label "Task Completion Termination" .


###  TerminationCondition
:TerminationCondition rdf:type owl:Class ;
                      rdfs:comment "A condition under which a team's execution terminates." ;
                      rdfs:label "Termination Condition" .


###  TreeOfThoughts
:TreeOfThoughts rdf:type owl:Class ;
                rdfs:subClassOf :ReasoningPattern ;
                rdfs:label "Tree of Thoughts" .


###  TurnLimitTermination
:TurnLimitTermination rdf:type owl:Class ;
                      rdfs:subClassOf :TerminationCondition ;
                      rdfs:label "Turn Limit Termination" .


###  Unspecified
:Unspecified rdf:type owl:Class ;
             rdfs:subClassOf :ReasoningPattern ;
             rdfs:label "Unspecified" .


#################################################################
#    Named Individuals — Coordination Patterns
#################################################################

:Sequential   rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Sequential" .
:Hierarchical rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Hierarchical" .
:RoundRobin   rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Round Robin" .
:SelectorBased rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Selector Based" .
:Swarm        rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Swarm" .
:ReActLoop    rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "ReAct Loop" .
:Network      rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Network" .
:Custom       rdf:type owl:NamedIndividual , :CoordinationPattern ; rdfs:label "Custom" .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CompositeTermination
                :EventBasedTermination
                :RoutingTermination
                :TaskCompletionTermination
                :TurnLimitTermination
              )
] .
