@prefix : <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin#hasAgentMemoryBinding
:hasAgentMemoryBinding rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasMemoryBinding ;
                       rdfs:domain :Agent ;
                       rdfs:range :MemoryBinding .


###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/agentPrompt
:agentPrompt rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasPrompt .


###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/agentResourceUsage
:agentResourceUsage rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :resourceUsage ;
                    rdfs:domain :LLMAgent ;
                    rdfs:range :Resource .


###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/agentToolUsage
:agentToolUsage rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :toolUsage ;
                rdfs:domain :LLMAgent ;
                rdfs:range :Tool .


###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/bindsMemory
:bindsMemory rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :MemoryBinding ;
             rdfs:range :Memory .


