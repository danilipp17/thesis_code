###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/hasConfig
:hasConfig rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Agent ,
                       :AgenticSystem ,
                       :Capability ,
                       :Context ,
                       :CoordinationPattern ,
                       :Guardrail ,
                       :HumanCheckpoint ,
                       :MemoryBinding ,
                       :Orchestration ,
                       :Plan ,
                       :Prompt ,
                       :ReasoningPattern ,
                       :Resource ,
                       :Schema ,
                       :Step ,
                       :System ,
                       :Task ,
                       :TerminationCondition ,
                       :Tool ;
           rdfs:range :Config .


###  http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/hasEnvironmentConfig
:hasEnvironmentConfig rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasConfig .


