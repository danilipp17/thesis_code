@prefix : <http://www.w3id.org/agentic-ai/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3id.org/agentic-ai/onto#> .

<http://www.w3id.org/agentic-ai/onto> rdf:type owl:Ontology ;
                                       <http://purl.org/dc/elements/1.1/contributor> "Fajar J. Ekaputra" ;
                                       <http://purl.org/dc/elements/1.1/creator> "Kabul Kurniawan" ;
                                       <http://purl.org/dc/elements/1.1/description> "An ontology for describing agentic AI systems, their components, interraction and patterns."@en ;
                                       <http://purl.org/dc/elements/1.1/rights> "http://creativecommons.org/licenses/by/4.0/" ;
                                       <http://purl.org/dc/elements/1.1/title> "Agentic AI Ontology" ;
                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "agento" ;
                                       rdfs:comment "An ontology for describing agentic AI systems, their components, interraction and patterns." ;
                                       rdfs:label "Agentic AI Ontology" ;
                                       owl:versionInfo 0.2 .

#################################################################
#    Annotation properties
#################################################################

<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .
<http://purl.org/dc/elements/1.1/rights> rdf:type owl:AnnotationProperty .
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .

#################################################################
#    Object Properties
#################################################################

<http://w3id.org/beam/core#participatedIn> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/ns/prov#Agent> ;
                                           rdfs:range :Task .

:agentPrompt rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasPrompt ; rdfs:domain :LLMAgent ; rdfs:range :Prompt .
:agentResourceUsage rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :resourceUsage ; rdfs:domain :LLMAgent ; rdfs:range <http://w3id.org/beam/core#Resource> .
:agentToolUsage rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :toolUsage .
:containsResource rdf:type owl:ObjectProperty ; rdfs:domain :Environment ; rdfs:range <http://w3id.org/beam/core#Resource> .
:contributesToGoal rdf:type owl:ObjectProperty ; rdfs:domain :Objective ; rdfs:range :Goal .
:contributesToObjective rdf:type owl:ObjectProperty ; rdfs:domain :Task ; rdfs:range :Objective .
:hasAgentCapability rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasCapability ; rdfs:domain :LLMAgent ; rdfs:range :Capability .
:hasAgentConfig rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasConfig ; rdfs:domain :LLMAgent ; rdfs:range :Config .
:hasAgentGoal rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasGoal ; rdfs:domain :LLMAgent ; rdfs:range :Goal .
:hasAgentMember rdf:type owl:ObjectProperty ; rdfs:domain :Team ; rdfs:range :LLMAgent .
:hasAssociatedTask rdf:type owl:ObjectProperty ; rdfs:domain :WorkflowStep ; rdfs:range :Task .
:hasCapability rdf:type owl:ObjectProperty ; rdfs:domain :Tool ; rdfs:range :Capability .
:hasConfig rdf:type owl:ObjectProperty ; rdfs:range :Config .
:hasEnvironmentConfig rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasConfig ; rdfs:domain :Environment ; rdfs:range :Config .
:hasGoal rdf:type owl:ObjectProperty ; rdfs:range :Goal .
:hasKnowledge rdf:type owl:ObjectProperty ; rdfs:domain :LLMAgent ; rdfs:range :KnowledgeBase .
:hasObjective rdf:type owl:ObjectProperty ; rdfs:range :Objective .
:hasPrompt rdf:type owl:ObjectProperty ; rdfs:range :Prompt .
:hasRelatedPattern rdf:type owl:ObjectProperty ; rdfs:domain :WorkflowPattern ; rdfs:range :WorkflowPattern .
:hasSubPattern rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasRelatedPattern .
:hasSystemConfig rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasConfig ; rdfs:domain :Team ; rdfs:range :Config .
:hasTeamGoal rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasGoal ; rdfs:domain :Team ; rdfs:range :Goal .
:hasToolConfig rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasConfig ; rdfs:domain :Tool ; rdfs:range :Config .
:hasWorkflowPattern rdf:type owl:ObjectProperty ; rdfs:domain :Team ; rdfs:range :WorkflowPattern .
:hasWorkflowStep rdf:type owl:ObjectProperty ; rdfs:domain :WorkflowPattern ; rdfs:range :WorkflowStep .
:humanParticipatedIn rdf:type owl:ObjectProperty ; rdfs:subPropertyOf <http://w3id.org/beam/core#participatedIn> ; rdfs:domain :HumanAgent ; rdfs:range :Task .
:interactsWith rdf:type owl:ObjectProperty ; rdfs:domain :LLMAgent ; rdfs:range :LLMAgent .
:nextPattern rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasRelatedPattern .
:nextStep rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :relatedStep ; rdfs:domain :WorkflowStep ; rdfs:range :WorkflowStep .
:operatesIn rdf:type owl:ObjectProperty ; rdfs:domain :LLMAgent ; rdfs:range :Environment .
:performedBy rdf:type owl:ObjectProperty ; rdfs:domain :Task ; rdfs:range :Tool .
:performedByAgent rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :performedBy ; rdfs:domain :Task ; rdfs:range :LLMAgent .
:producedResource rdf:type owl:ObjectProperty ; rdfs:domain :Task ; rdfs:range <http://w3id.org/beam/core#Resource> .
:relatedStep rdf:type owl:ObjectProperty ; rdfs:domain :WorkflowStep ; rdfs:range :WorkflowStep .
:requiresCapability rdf:type owl:ObjectProperty ; rdfs:domain :Task ; rdfs:range :Capability .
:requiresResource rdf:type owl:ObjectProperty ; rdfs:domain :Task ; rdfs:range <http://w3id.org/beam/core#Resource> .
:resourceUsage rdf:type owl:ObjectProperty ; rdfs:domain :Tool ; rdfs:range <http://w3id.org/beam/core#Resource> .
:taskPrompt rdf:type owl:ObjectProperty ; rdfs:subPropertyOf :hasPrompt ; rdfs:domain :Task ; rdfs:range :Prompt .
:toolUsage rdf:type owl:ObjectProperty ; rdfs:domain :Tool ; rdfs:range :Tool .
:useLanguageModel rdf:type owl:ObjectProperty ; rdfs:domain :LLMAgent ; rdfs:range :LanguageModel .

#################################################################
#    Data properties
#################################################################

<http://purl.org/dc/terms/description> rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
<http://purl.org/dc/terms/reference> rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .

:agentID rdf:type owl:DatatypeProperty ; rdfs:domain :LLMAgent ; rdfs:range xsd:string .
:agentRole rdf:type owl:DatatypeProperty ; rdfs:domain :LLMAgent ; rdfs:range xsd:string .
:configKey rdf:type owl:DatatypeProperty ; rdfs:domain :Config ; rdfs:range xsd:string .
:configValue rdf:type owl:DatatypeProperty ; rdfs:domain :Config ; rdfs:range xsd:string .
:envType rdf:type owl:DatatypeProperty ; rdfs:domain :Environment ; rdfs:range xsd:string .
:promptContext rdf:type owl:DatatypeProperty ; rdfs:domain :Prompt ; rdfs:range xsd:string .
:promptInputData rdf:type owl:DatatypeProperty ; rdfs:domain :Prompt ; rdfs:range xsd:string .
:promptInstruction rdf:type owl:DatatypeProperty ; rdfs:domain :Prompt ; rdfs:range xsd:string .
:promptOutputIndicator rdf:type owl:DatatypeProperty ; rdfs:domain :Prompt ; rdfs:range xsd:string .
:stepOrder rdf:type owl:DatatypeProperty ; rdfs:domain :WorkflowStep ; rdfs:range xsd:integer .

#################################################################
#    Classes
#################################################################

<http://purl.org/net/p-plan#Plan> rdf:type owl:Class .
<http://purl.org/net/p-plan#Step> rdf:type owl:Class .
<http://purl.org/net/p-plan#Variable> rdf:type owl:Class .
<http://w3id.org/beam/core#Context> rdf:type owl:Class .
<http://w3id.org/beam/core#Instance> rdf:type owl:Class ; rdfs:subClassOf <http://w3id.org/beam/core#Resource> .
<http://w3id.org/beam/core#Model> rdf:type owl:Class ; rdfs:subClassOf <http://w3id.org/beam/core#Resource> .
<http://w3id.org/beam/core#Resource> rdf:type owl:Class ; rdfs:subClassOf <http://purl.org/net/p-plan#Variable> .
<http://w3id.org/beam/core#SemanticModel> rdf:type owl:Class ; rdfs:subClassOf <http://w3id.org/beam/core#Model> .
<http://w3id.org/beam/core#StatisticalModel> rdf:type owl:Class ; rdfs:subClassOf <http://w3id.org/beam/core#Model> .
<http://w3id.org/beam/core#System> rdf:type owl:Class .
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .

:Capability rdf:type owl:Class .
:Config rdf:type owl:Class .
:Constraint rdf:type owl:Class ; rdfs:subClassOf :KnowledgeBase .
:Context rdf:type owl:Class .
:EndStep rdf:type owl:Class ; rdfs:subClassOf :WorkflowStep .
:Environment rdf:type owl:Class ; rdfs:subClassOf :Context .
:Goal rdf:type owl:Class ; rdfs:subClassOf :Context .
:HumanAgent rdf:type owl:Class ; rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> .
:Instance rdf:type owl:Class .
:KnowledgeBase rdf:type owl:Class ; rdfs:subClassOf :Instance .
:LLMAgent rdf:type owl:Class ; rdfs:subClassOf <http://www.w3.org/ns/prov#Agent>, :Tool .
:LanguageModel rdf:type owl:Class ; rdfs:subClassOf <http://w3id.org/beam/core#StatisticalModel> .
:Memory rdf:type owl:Class ; rdfs:subClassOf :KnowledgeBase .
:Objective rdf:type owl:Class ; rdfs:subClassOf :Context .
:Prompt rdf:type owl:Class .
:StartStep rdf:type owl:Class ; rdfs:subClassOf :WorkflowStep .
:Task rdf:type owl:Class .
:Team rdf:type owl:Class ; rdfs:subClassOf <http://w3id.org/beam/core#System> .
:Tool rdf:type owl:Class .
:WorkflowPattern rdf:type owl:Class ; rdfs:subClassOf <http://purl.org/net/p-plan#Plan> .
:WorkflowStep rdf:type owl:Class ; rdfs:subClassOf <http://purl.org/net/p-plan#Step> .
