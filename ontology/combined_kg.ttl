p-plan:Plan a owl:Class .

p-plan:Step a owl:Class .

p-plan:Variable a owl:Class .

beam:StatisticalModel a owl:Class ;
    rdfs:subClassOf beam:Model .

beam:participatedIn a owl:ObjectProperty ;
    rdfs:label "participated in" ;
    rdfs:comment "Indicates that an agent participated in an activity." ;
    rdfs:domain prov:Agent ;
    rdfs:range agento:Task .

default1:Custom a default1:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Custom" .

default1:ReAct a owl:Class ;
    rdfs:label "ReAct" ;
    rdfs:subClassOf default1:ReasoningPattern .

default1:ReActLoop a default1:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "ReAct Loop" .

default1:SelectorBased a default1:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Selector Based" .

<http://www.w3id.org/agentic-ai/onto> a owl:Ontology ;
    rdfs:label "Agentic AI Ontology" ;
    dc:contributor "Fajar J. Ekaputra" ;
    dc:creator "Kabul Kurniawan" ;
    dc:description "An ontology for describing agentic AI systems, their components, interraction and patterns."@en ;
    dc:rights "http://creativecommons.org/licenses/by/4.0/" ;
    dc:title "Agentic AI Ontology" ;
    vann:preferredNamespacePrefix "agento" ;
    rdfs:comment "An ontology for describing agentic AI systems, their components, interraction and patterns." ;
    owl:versionInfo 0.2 .

agento:HumanAgent a owl:Class ;
    rdfs:label "Human Agent" ;
    rdfs:comment "A human individual who can participate in tasks and interact with agents." ;
    rdfs:subClassOf prov:Agent .

agento:Instance a owl:Class .

agento:hasCapability a owl:ObjectProperty ;
    rdfs:label "has capability" ;
    rdfs:comment "Capability that can berforme by agent" ;
    rdfs:domain agento:Tool ;
    rdfs:range agento:Capability .

agento:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:comment "Indicates the tool/agent that performs the task in a step." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Tool .

agento:relatedStep a owl:ObjectProperty ;
    rdfs:label "related step" ;
    rdfs:comment "Indicates a relationship between workflow steps." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range agento:WorkflowStep .

agento:resourceUsage a owl:ObjectProperty ;
    rdfs:label "resource usage" ;
    rdfs:comment "Tool accesses a resource on behalf of the agent." ;
    rdfs:domain agento:Tool ;
    rdfs:range beam:Resource .

demo:LM_gpt_4o a agento:LanguageModel ;
