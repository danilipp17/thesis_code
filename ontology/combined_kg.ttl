agento:hasGoal a owl:ObjectProperty ;
    rdfs:label "has goal" ;
    rdfs:comment "Relates an agent or team to its goals." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( agento:LLMAgent agento:Team ) ] ;
    rdfs:range agento:Goal .

agento:hasPrompt a owl:ObjectProperty ;
    rdfs:label "has prompt" ;
    rdfs:comment "Associates prompts with agents or tasks." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( agento:LLMAgent agento:Task ) ] ;
    rdfs:range agento:Prompt .

agento:hasRelatedPattern a owl:ObjectProperty ;
    rdfs:label "has related pattern" ;
    rdfs:comment "Indicates a relationship between workflow patterns." ;
    rdfs:domain agento:WorkflowPattern ;
    rdfs:range agento:WorkflowPattern .

agento:toolUsage a owl:ObjectProperty ;
    rdfs:label "tool usage" ;
    rdfs:comment "using another tool to perform tasks or access resources." ;
    rdfs:domain agento:Tool ;
    rdfs:range agento:Tool .

