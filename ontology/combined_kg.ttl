tp_ag:OrchestratorPrompt_language_agent a agento:Prompt ;
    default1:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    default1:hasSourceAttribute "description"^^xsd:string ;
    agento:promptInstruction "A helpful assistant that can provide language tips for a given destination."^^xsd:string .

tp_ag:OrchestratorPrompt_local_agent a agento:Prompt ;
    default1:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    default1:hasSourceAttribute "description"^^xsd:string ;
    agento:promptInstruction "A local assistant that can suggest local activities or places to visit."^^xsd:string .

tp_ag:OrchestratorPrompt_planner_agent a agento:Prompt ;
    default1:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    default1:hasSourceAttribute "description"^^xsd:string ;
    agento:promptInstruction "A helpful assistant that can plan trips."^^xsd:string .

tp_ag:OrchestratorPrompt_travel_summary_agent a agento:Prompt ;
