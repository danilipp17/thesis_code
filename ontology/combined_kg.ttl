react_lg:FlowStep_our_agent a default1:ConditionalStep,
        agento:StartStep,
        agento:WorkflowStep ;
    default1:hasAssociatedAgent react_lg:Agent_our_agent ;
    default1:hasEdgeMapping "{\"continue\": \"tools\", \"end\": \"END\"}"^^xsd:string ;
