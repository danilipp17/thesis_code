tp_ag:Team_SelectorGroupChat_0 a agento:Team ;
    default1:employsCoordinationPattern default1:SelectorBased ;
    default1:hasTerminationCondition tp_ag:EventTermination_SelectorGroupChat_0_0 ;
    default1:hasTitle "SelectorGroupChat"^^xsd:string ;
    agento:hasAgentMember tp_ag:Agent_language_agent,
