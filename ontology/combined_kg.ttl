# ============================================================
# combined_kg.ttl
# Self-contained knowledge graph for competency-question queries.
# Contents:
#   - TBox: agentO (parent ontology) + agentoscin (extension)
#   - ABox: six original-framework systems from the parallel corpus
#       joke              (LangGraph)  prefix joke_lg:
#       code-review       (AutoGen)    prefix cr_ag:
#       tech-blog         (CrewAI)     prefix tb_cr:
#       meeting-assistant (CrewAI)     prefix ma_cr:
#       travel-planning   (AutoGen)    prefix tp_ag:
#       react             (LangGraph)  prefix react_lg:
#   - ABox: one synthetic system exercising ontology features
#     that the corpus does not populate (reasoning patterns,
#     memory bindings, guardrails, human checkpoints, …)
#       feature_demo                   prefix demo:
# Generated by scripts/build_combined_kg.py
# ============================================================

@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix cr_ag: <http://example.org/parallel/code_review_autogen#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix default1: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix demo: <http://example.org/demo/feature_demo#> .
@prefix joke_lg: <http://example.org/parallel/joke_langgraph#> .
@prefix ma_cr: <http://example.org/parallel/meeting_assistant_flow_crewai#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix react_lg: <http://example.org/parallel/react_langgraph#> .
@prefix tb_cr: <http://example.org/parallel/tech_blog_crewai#> .
@prefix tp_ag: <http://example.org/parallel/travel_planning_autogen#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

demo:MemBinding_team a default1:MemoryBinding ;
    default1:bindsMemory demo:Memory_team_shared ;
    default1:hasMemoryScope "team"^^xsd:string .

demo:feature_demo a default1:AgenticSystem ;
    default1:containsAgent demo:Agent_executor,
        demo:Agent_human_approver,
        demo:Agent_planner ;
    default1:containsOrchestration demo:Orchestration_demo ;
    default1:containsTeam demo:Team_demo ;
    default1:hasMemoryBinding demo:MemBinding_system ;
    default1:hasSourceFramework "FeatureDemo"^^xsd:string ;
    default1:hasTitle "feature_demo"^^xsd:string .

<http://example.org/parallel/code_review_autogen> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

cr_ag:Task_autogen_task_0 a agento:Task ;
    default1:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt cr_ag:TaskPrompt_autogen_task_0 .

cr_ag:code_review a default1:AgenticSystem ;
    default1:containsAgent cr_ag:Agent_Code_Reviewer,
        cr_ag:Agent_Review_Summarizer,
        cr_ag:Agent_Security_Auditor ;
    default1:containsOrchestration cr_ag:Orchestration_AutoGenFlow ;
    default1:containsTeam cr_ag:Team_RoundRobinGroupChat_0 ;
    default1:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    default1:hasTitle "code_review"^^xsd:string .

<http://example.org/parallel/joke_langgraph> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

joke_lg:Task_task_generate_joke a agento:Task ;
    default1:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    default1:hasExpectedOutput "joke"^^xsd:string ;
    agento:performedByAgent joke_lg:Agent_generate_joke ;
    agento:taskPrompt joke_lg:TaskPrompt_task_generate_joke .

joke_lg:Task_task_improve_joke a agento:Task ;
    default1:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    default1:hasExpectedOutput "improved_joke"^^xsd:string ;
    agento:performedByAgent joke_lg:Agent_improve_joke ;
    agento:taskPrompt joke_lg:TaskPrompt_task_improve_joke .

joke_lg:Task_task_polish_joke a agento:Task ;
    default1:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    default1:hasExpectedOutput "final_joke"^^xsd:string ;
    agento:performedByAgent joke_lg:Agent_polish_joke ;
    agento:taskPrompt joke_lg:TaskPrompt_task_polish_joke .

joke_lg:joke a default1:AgenticSystem ;
    default1:containsAgent joke_lg:Agent_generate_joke,
        joke_lg:Agent_improve_joke,
        joke_lg:Agent_polish_joke ;
    default1:containsOrchestration joke_lg:Orchestration_StateGraph ;
    default1:containsTeam joke_lg:Team_langgraph_team_0 ;
    default1:hasSourceFramework "LangGraph"^^xsd:string ;
    default1:hasTitle "joke"^^xsd:string .

<http://example.org/parallel/meeting_assistant_flow_crewai> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ma_cr:meeting_assistant_flow a default1:AgenticSystem ;
    default1:containsAgent ma_cr:Agent_meeting_analyzer ;
    default1:containsOrchestration ma_cr:Orchestration_MeetingFlow ;
    default1:containsTeam ma_cr:Team_MeetingAssistantCrew ;
    default1:hasSourceFramework "CrewAI"^^xsd:string ;
    default1:hasTitle "meeting_assistant_flow"^^xsd:string .

<http://example.org/parallel/react_langgraph> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

react_lg:Task_task_our_agent a agento:Task ;
    default1:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    default1:hasExpectedOutput "messages"^^xsd:string ;
    agento:performedByAgent react_lg:Agent_our_agent ;
    agento:taskPrompt react_lg:TaskPrompt_task_our_agent .

react_lg:react a default1:AgenticSystem ;
    default1:containsAgent react_lg:Agent_our_agent ;
    default1:containsOrchestration react_lg:Orchestration_StateGraph ;
    default1:containsTeam react_lg:Team_langgraph_team_0 ;
    default1:hasSourceFramework "LangGraph"^^xsd:string ;
    default1:hasTitle "react"^^xsd:string .

<http://example.org/parallel/tech_blog_crewai> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

tb_cr:tech_blog a default1:AgenticSystem ;
    default1:containsAgent tb_cr:Agent_editor,
        tb_cr:Agent_researcher,
        tb_cr:Agent_writer ;
    default1:containsOrchestration tb_cr:Orchestration_TechBlogFlow ;
    default1:containsTeam tb_cr:Team_TechBlogCrew ;
    default1:hasSourceFramework "CrewAI"^^xsd:string ;
    default1:hasTitle "tech_blog"^^xsd:string .

<http://example.org/parallel/travel_planning_autogen> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

tp_ag:Task_autogen_task_0 a agento:Task ;
    default1:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt tp_ag:TaskPrompt_autogen_task_0 .

tp_ag:travel_planning a default1:AgenticSystem ;
    default1:containsAgent tp_ag:Agent_language_agent,
        tp_ag:Agent_local_agent,
        tp_ag:Agent_planner_agent,
        tp_ag:Agent_travel_summary_agent ;
    default1:containsOrchestration tp_ag:Orchestration_AutoGenFlow ;
    default1:containsTeam tp_ag:Team_SelectorGroupChat_0 ;
    default1:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    default1:hasTitle "travel_planning"^^xsd:string .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "An account of the resource." ;
    rdfs:range xsd:string .

dcterms:reference a owl:DatatypeProperty ;
    rdfs:label "reference" ;
    rdfs:comment "A reference of resource." ;
    rdfs:range xsd:string .

dcterms:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "A name given to the resource." ;
    rdfs:range xsd:string .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

beam:Instance a owl:Class ;
    rdfs:subClassOf beam:Resource .

beam:SemanticModel a owl:Class ;
    rdfs:subClassOf beam:Model .

default1:ChainOfThought a owl:Class ;
    rdfs:label "Chain of Thought" ;
    rdfs:subClassOf default1:ReasoningPattern .

default1:Hierarchical a default1:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Hierarchical" .

default1:Network a default1:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Network" .

default1:ReflectionLoop a owl:Class ;
    rdfs:label "Reflection Loop" ;
    rdfs:subClassOf default1:ReasoningPattern .

default1:Swarm a default1:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Swarm" .

default1:TreeOfThoughts a owl:Class ;
    rdfs:label "Tree of Thoughts" ;
    rdfs:subClassOf default1:ReasoningPattern .

default1:Unspecified a owl:Class ;
    rdfs:label "Unspecified" ;
    rdfs:subClassOf default1:ReasoningPattern .

default1:agentType a owl:DatatypeProperty ;
    rdfs:label "agent type" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:string .

default1:bindsMemory a owl:ObjectProperty ;
    rdfs:label "binds memory" ;
    rdfs:comment "Links a memory binding to the memory it binds." ;
    rdfs:domain default1:MemoryBinding ;
    rdfs:range agento:Memory .

default1:callsCrew a owl:DatatypeProperty ;
    rdfs:label "calls crew" ;
    rdfs:comment "Key of the team/crew invoked by this workflow step (e.g. CrewAI @listen method calling crew.kickoff()). Enables per-step crew binding through the ontology round-trip." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

default1:containsAgent a owl:ObjectProperty ;
    rdfs:label "contains agent" ;
    rdfs:comment "Relates an agentic system to an agent it contains." ;
    rdfs:domain default1:AgenticSystem ;
    rdfs:range agento:LLMAgent .

default1:containsOrchestration a owl:ObjectProperty ;
    rdfs:label "contains orchestration" ;
    rdfs:comment "Relates an agentic system to its orchestration." ;
    rdfs:domain default1:AgenticSystem ;
    rdfs:range default1:Orchestration .

default1:containsTeam a owl:ObjectProperty ;
    rdfs:label "contains team" ;
    rdfs:comment "Relates an agentic system to a team it contains." ;
    rdfs:domain default1:AgenticSystem ;
    rdfs:range agento:Team .

default1:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "Indicates that one task depends on another." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Task .

default1:employsCoordinationPattern a owl:ObjectProperty ;
    rdfs:label "employs coordination pattern" ;
    rdfs:comment "Relates a team to the coordination pattern it employs." ;
    rdfs:domain agento:Team ;
    rdfs:range default1:CoordinationPattern .

default1:employsReasoningPattern a owl:ObjectProperty ;
    rdfs:label "employs reasoning pattern" ;
    rdfs:comment "Relates an agent to the reasoning pattern it employs." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range default1:ReasoningPattern .

default1:hasAgentMemoryBinding a owl:ObjectProperty ;
    rdfs:label "has agent memory binding" ;
    rdfs:comment "Memory binding attached to an individual agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range default1:MemoryBinding ;
    rdfs:subPropertyOf default1:hasMemoryBinding .

default1:hasAggregationCombinator a owl:DatatypeProperty ;
    rdfs:label "has aggregation combinator" ;
    rdfs:comment "Combinator used to aggregate multiple predecessor steps in the source decorator (e.g. CrewAI @listen(or_(step_a, step_b)) stores \"or_\"). Values: \"or_\", \"and_\", or empty for single-predecessor steps." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

default1:hasAssociatedAgent a owl:ObjectProperty ;
    rdfs:label "has associated agent" ;
    rdfs:comment "Links a workflow step to the agent that executes it (e.g. a LangGraph node function implemented by a specific LLMAgent)." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range agento:LLMAgent .

default1:hasCheckpointPosition a owl:DatatypeProperty ;
    rdfs:label "has checkpoint position" ;
    rdfs:domain default1:HumanCheckpoint ;
    rdfs:range xsd:string .

default1:hasCheckpointType a owl:DatatypeProperty ;
    rdfs:label "has checkpoint type" ;
    rdfs:domain default1:HumanCheckpoint ;
    rdfs:range xsd:string .

default1:hasDecoratorArgument a owl:DatatypeProperty ;
    rdfs:label "has decorator argument" ;
    rdfs:comment "Original literal argument(s) of the framework decorator that defined this step (e.g. CrewAI @start(\"wait_next_run\") or @listen(\"label\")). Preserves source-level identifiers that are not method names and therefore cannot be reconstructed from the inverse of nextStep edges." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

default1:hasDelegationStrategy a owl:DatatypeProperty ;
    rdfs:label "has delegation strategy" ;
    rdfs:domain agento:Task ;
    rdfs:range xsd:string .

default1:hasDependencyType a owl:DatatypeProperty ;
    rdfs:label "has dependency type" ;
    rdfs:domain agento:Task ;
    rdfs:range xsd:string .

default1:hasDirectiveFunction a owl:DatatypeProperty ;
    rdfs:label "has directive function" ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

default1:hasEdgeMapping a owl:DatatypeProperty ;
    rdfs:label "has edge mapping" ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

default1:hasExpectedOutput a owl:DatatypeProperty ;
    rdfs:label "has expected output" ;
    rdfs:domain agento:Task ;
    rdfs:range xsd:string .

default1:hasGuardrail a owl:ObjectProperty ;
    rdfs:label "has guardrail" ;
    rdfs:comment "Associates a guardrail with a task." ;
    rdfs:domain agento:Task ;
    rdfs:range default1:Guardrail .

default1:hasGuardrailType a owl:DatatypeProperty ;
    rdfs:label "has guardrail type" ;
    rdfs:domain default1:Guardrail ;
    rdfs:range xsd:string .

default1:hasHumanCheckpoint a owl:ObjectProperty ;
    rdfs:label "has human checkpoint" ;
    rdfs:comment "Associates a human-in-the-loop checkpoint with a task." ;
    rdfs:domain agento:Task ;
    rdfs:range default1:HumanCheckpoint .

default1:hasImplementationReference a owl:DatatypeProperty ;
    rdfs:label "has implementation reference" ;
    rdfs:domain agento:Tool ;
    rdfs:range xsd:string .

default1:hasInputSchema a owl:DatatypeProperty ;
    rdfs:label "has input schema" ;
    rdfs:domain agento:Tool ;
    rdfs:range xsd:string .

default1:hasMaxReasoningAttempts a owl:DatatypeProperty ;
    rdfs:label "has max reasoning attempts" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:integer .

default1:hasMaxRetries a owl:DatatypeProperty ;
    rdfs:label "has max retries" ;
    rdfs:domain default1:Guardrail ;
    rdfs:range xsd:integer .

default1:hasMaxTurns a owl:DatatypeProperty ;
    rdfs:label "has max turns" ;
    rdfs:domain default1:TurnLimitTermination ;
    rdfs:range xsd:integer .

default1:hasMemoryScope a owl:DatatypeProperty ;
    rdfs:label "has memory scope" ;
    rdfs:domain default1:MemoryBinding ;
    rdfs:range xsd:string .

default1:hasOperator a owl:DatatypeProperty ;
    rdfs:label "has operator" ;
    rdfs:domain default1:CompositeTermination ;
    rdfs:range xsd:string .

default1:hasOutputSchema a owl:ObjectProperty ;
    rdfs:label "has output schema" ;
    rdfs:comment "Specifies the schema of the structured output produced by an orchestration or task." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( default1:Orchestration agento:Task ) ] ;
    rdfs:range default1:Schema .

default1:hasPersistenceScope a owl:DatatypeProperty ;
    rdfs:label "has persistence scope" ;
    rdfs:domain agento:Memory ;
    rdfs:range xsd:string .

default1:hasReasoningEnabled a owl:DatatypeProperty ;
    rdfs:label "has reasoning enabled" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:boolean .

default1:hasReasoningOrigin a owl:DatatypeProperty ;
    rdfs:label "has reasoning origin" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:string .

default1:hasRoutingLogic a owl:DatatypeProperty ;
    rdfs:label "has routing logic" ;
    rdfs:domain default1:ConditionalStep ;
    rdfs:range xsd:string .

default1:hasSchemaDefinition a owl:DatatypeProperty ;
    rdfs:label "has schema definition" ;
    rdfs:domain default1:Schema ;
    rdfs:range xsd:string .

default1:hasSourceAttribute a owl:DatatypeProperty ;
    rdfs:label "has source attribute" ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

default1:hasSourceFramework a owl:DatatypeProperty ;
    rdfs:label "has source framework" ;
    rdfs:domain default1:AgenticSystem ;
    rdfs:range xsd:string .

default1:hasSubCondition a owl:ObjectProperty ;
    rdfs:label "has sub condition" ;
    rdfs:comment "A sub-condition combined within a composite termination condition." ;
    rdfs:domain default1:CompositeTermination ;
    rdfs:range default1:TerminationCondition .

default1:hasTeamMemoryBinding a owl:ObjectProperty ;
    rdfs:label "has team memory binding" ;
    rdfs:comment "Memory binding attached to a team." ;
    rdfs:domain agento:Team ;
    rdfs:range default1:MemoryBinding ;
    rdfs:subPropertyOf default1:hasMemoryBinding .

default1:hasTerminationCondition a owl:ObjectProperty ;
    rdfs:label "has termination condition" ;
    rdfs:comment "Relates a team to a termination condition that ends its execution." ;
    rdfs:domain agento:Team ;
    rdfs:range default1:TerminationCondition .

default1:hasTriggerExpression a owl:DatatypeProperty ;
    rdfs:label "has trigger expression" ;
    rdfs:domain default1:EventBasedTermination ;
    rdfs:range xsd:string .

default1:hasValidationLogic a owl:DatatypeProperty ;
    rdfs:label "has validation logic" ;
    rdfs:domain default1:Guardrail ;
    rdfs:range xsd:string .

default1:isMandatory a owl:DatatypeProperty ;
    rdfs:label "is mandatory" ;
    rdfs:domain default1:HumanCheckpoint ;
    rdfs:range xsd:boolean .

default1:memoryBoundTo a owl:ObjectProperty ;
    rdfs:label "memory bound to" ;
    rdfs:comment "Links a memory binding to the agent, team, or system that owns it." ;
    rdfs:domain default1:MemoryBinding ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( default1:AgenticSystem agento:LLMAgent agento:Team ) ] .

default1:orchestratesTeam a owl:ObjectProperty ;
    rdfs:label "orchestrates team" ;
    rdfs:comment "Relates an orchestration to the team it orchestrates." ;
    rdfs:domain default1:Orchestration ;
    rdfs:range agento:Team .

default1:taskToolUsage a owl:ObjectProperty ;
    rdfs:label "task tool usage" ;
    rdfs:comment "A tool used in the execution of a task." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Tool ;
    rdfs:subPropertyOf agento:toolUsage .

agento:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A rule or condition derived from the knowledge base that restricts or guides agent behavior or decision-making." ;
    rdfs:subClassOf agento:KnowledgeBase .

agento:agentID a owl:DatatypeProperty ;
    rdfs:label "agent ID" ;
    rdfs:comment "A unique identifier for an agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:string .

agento:agentPrompt a owl:ObjectProperty ;
    rdfs:label "agent prompt" ;
    rdfs:comment "Prompt used by the agent to perform independently of its tasks." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:Prompt ;
    rdfs:subPropertyOf agento:hasPrompt .

agento:agentResourceUsage a owl:ObjectProperty ;
    rdfs:label "agent resource usage" ;
    rdfs:comment "Agent directly uses or consumes a resource." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range beam:Resource ;
    rdfs:subPropertyOf agento:resourceUsage .

agento:agentRole a owl:DatatypeProperty ;
    rdfs:label "agent role" ;
    rdfs:comment "The role of an agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:string .

agento:agentToolUsage a owl:ObjectProperty ;
    rdfs:label "agent tool usage" ;
    rdfs:comment "Agent directly uses a tool to perform tasks or access resources." ;
    rdfs:subPropertyOf agento:toolUsage .

agento:configKey a owl:DatatypeProperty ;
    rdfs:label "config key" ;
    rdfs:comment "A key or name for a configuration setting." ;
    rdfs:domain agento:Config ;
    rdfs:range xsd:string .

agento:configValue a owl:DatatypeProperty ;
    rdfs:label "config value" ;
    rdfs:comment "The value associated with a configuration key." ;
    rdfs:domain agento:Config ;
    rdfs:range xsd:string .

agento:containsResource a owl:ObjectProperty ;
    rdfs:label "contains resource" ;
    rdfs:comment "Relates an Environment into resources." ;
    rdfs:domain agento:Environment ;
    rdfs:range beam:Resource .

agento:contributesToGoal a owl:ObjectProperty ;
    rdfs:label "contributes to goal" ;
    rdfs:comment "Relates a objective to the goal it helps achieve." ;
    rdfs:domain agento:Objective ;
    rdfs:range agento:Goal .

agento:contributesToObjective a owl:ObjectProperty ;
    rdfs:label "contributes to objective" ;
    rdfs:comment "task contributes to objective" ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Objective .

agento:envType a owl:DatatypeProperty ;
    rdfs:label "environment type" ;
    rdfs:comment "A string that describes the type of environment (e.g., virtual, physical)." ;
    rdfs:domain agento:Environment ;
    rdfs:range xsd:string .

agento:hasAgentCapability a owl:ObjectProperty ;
    rdfs:label "has agent capability" ;
    rdfs:comment "Capability that can be performed by agent" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:Capability ;
    rdfs:subPropertyOf agento:hasCapability .

agento:hasAgentConfig a owl:ObjectProperty ;
    rdfs:label "has agent config" ;
    rdfs:comment "Configuration settings specific to an LLM agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:Config ;
    rdfs:subPropertyOf agento:hasConfig .

agento:hasAgentGoal a owl:ObjectProperty ;
    rdfs:label "has agent goal" ;
    rdfs:comment "Goal assigned to an LLM agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:Goal ;
    rdfs:subPropertyOf agento:hasGoal .

agento:hasAgentMember a owl:ObjectProperty ;
    rdfs:label "has agent member" ;
    rdfs:comment "Links a team to its participating agents." ;
    rdfs:domain agento:Team ;
    rdfs:range agento:LLMAgent .

agento:hasAssociatedTask a owl:ObjectProperty ;
    rdfs:label "has associated task" ;
    rdfs:comment "Links a workflow step to the task it corresponds to." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range agento:Task .

agento:hasEnvironmentConfig a owl:ObjectProperty ;
    rdfs:label "has environment config" ;
    rdfs:comment "Configuration settings specific to an Environment." ;
    rdfs:domain agento:Environment ;
    rdfs:range agento:Config ;
    rdfs:subPropertyOf agento:hasConfig .

agento:hasKnowledge a owl:ObjectProperty ;
    rdfs:label "has knowledge base" ;
    rdfs:comment "Relates an agent to its knowledge base." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:KnowledgeBase .

agento:hasObjective a owl:ObjectProperty ;
    rdfs:label "has objective" ;
    rdfs:comment "Objective of a Team or an Agent" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( agento:LLMAgent agento:Team ) ] ;
    rdfs:range agento:Objective .

agento:hasSubPattern a owl:ObjectProperty ;
    rdfs:label "has sub pattern" ;
    rdfs:comment "Indicates a sub-pattern that is part of a larger workflow pattern." ;
    rdfs:subPropertyOf agento:hasRelatedPattern .

agento:hasSystemConfig a owl:ObjectProperty ;
    rdfs:label "has system config" ;
    rdfs:comment "Configuration settings specific to a Team system." ;
    rdfs:domain agento:Team ;
    rdfs:range agento:Config ;
    rdfs:subPropertyOf agento:hasConfig .

agento:hasTeamGoal a owl:ObjectProperty ;
    rdfs:label "has team goal" ;
    rdfs:comment "Goal assigned to a Team." ;
    rdfs:domain agento:Team ;
    rdfs:range agento:Goal ;
    rdfs:subPropertyOf agento:hasGoal .

agento:hasToolConfig a owl:ObjectProperty ;
    rdfs:label "has tool config" ;
    rdfs:comment "Configuration settings specific to a Tool." ;
    rdfs:domain agento:Tool ;
    rdfs:range agento:Config ;
    rdfs:subPropertyOf agento:hasConfig .

agento:hasWorkflowPattern a owl:ObjectProperty ;
    rdfs:label "has workflow pattern" ;
    rdfs:comment "Relates a team to the workflow pattern it follows." ;
    rdfs:domain agento:Team ;
    rdfs:range agento:WorkflowPattern .

agento:hasWorkflowStep a owl:ObjectProperty ;
    rdfs:label "has workflow step" ;
    rdfs:comment "Specifies a step that is part of a workflow pattern." ;
    rdfs:domain agento:WorkflowPattern ;
    rdfs:range agento:WorkflowStep .

agento:humanParticipatedIn a owl:ObjectProperty ;
    rdfs:label "human participated in" ;
    rdfs:comment "Indicates that a human agent participated in a task." ;
    rdfs:domain agento:HumanAgent ;
    rdfs:range agento:Task ;
    rdfs:subPropertyOf beam:participatedIn .

agento:interactsWith a owl:ObjectProperty ;
    rdfs:label "interacts with" ;
    rdfs:comment "Relates an agent to other agents it interacts with." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:LLMAgent .

agento:nextPattern a owl:ObjectProperty ;
    rdfs:label "next pattern" ;
    rdfs:comment "Defines the next workflow pattern in a sequential arrangement." ;
    rdfs:subPropertyOf agento:hasRelatedPattern .

agento:nextStep a owl:ObjectProperty ;
    rdfs:label "next step" ;
    rdfs:comment "Defines the next step in the workflow sequence." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range agento:WorkflowStep ;
    rdfs:subPropertyOf agento:relatedStep .

agento:operatesIn a owl:ObjectProperty ;
    rdfs:label "operates in" ;
    rdfs:comment "Relates an agent to its operational environment. (shall we not describing this at this stage?)" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:Environment .

agento:performedByAgent a owl:ObjectProperty ;
    rdfs:label "performed by agent" ;
    rdfs:comment "Indicates the agent that performs the task in a step." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:LLMAgent ;
    rdfs:subPropertyOf agento:performedBy .

agento:producedResource a owl:ObjectProperty ;
    rdfs:label "produced resource" ;
    rdfs:comment "Relates a task to resources produced as output." ;
    rdfs:domain agento:Task ;
    rdfs:range beam:Resource .

agento:promptContext a owl:DatatypeProperty ;
    rdfs:label "prompt context" ;
    rdfs:comment "The context or background information for the prompt." ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

agento:promptInputData a owl:DatatypeProperty ;
    rdfs:label "prompt input data" ;
    rdfs:comment "The input data provided to the prompt." ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

agento:promptInstruction a owl:DatatypeProperty ;
    rdfs:label "prompt instruction" ;
    rdfs:comment "The instruction or main content of the prompt." ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

agento:promptOutputIndicator a owl:DatatypeProperty ;
    rdfs:label "prompt output indicator" ;
    rdfs:comment "The expected output or response from the prompt." ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

agento:requiresCapability a owl:ObjectProperty ;
    rdfs:label "requires capability (future work)" ;
    rdfs:comment "capability needed for a task ." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Capability .

agento:requiresResource a owl:ObjectProperty ;
    rdfs:label "requires resource" ;
    rdfs:comment "Relates a task to resources needed for its execution" ;
    rdfs:domain agento:Task ;
    rdfs:range beam:Resource .

agento:stepOrder a owl:DatatypeProperty ;
    rdfs:label "step order" ;
    rdfs:comment "Workflow step order" ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:integer .

agento:taskPrompt a owl:ObjectProperty ;
    rdfs:label "task prompt" ;
    rdfs:comment "Prompt used within a task." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Prompt ;
    rdfs:subPropertyOf agento:hasPrompt .

agento:useLanguageModel a owl:ObjectProperty ;
    rdfs:label "use language model" ;
    rdfs:comment "link Agent to an Language Model" ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agento:LanguageModel .

demo:Checkpoint_plan_approval a default1:HumanCheckpoint ;
    default1:hasCheckpointPosition "before_execute"^^xsd:string ;
    default1:hasCheckpointType "approval"^^xsd:string ;
    default1:isMandatory true .

demo:Guardrail_plan_validation a default1:Guardrail ;
    default1:hasGuardrailType "schema_validation"^^xsd:string ;
    default1:hasMaxRetries 3 ;
    default1:hasValidationLogic "Output must contain at least one numbered step."^^xsd:string .

demo:MemBinding_agent a default1:MemoryBinding ;
    default1:bindsMemory demo:Memory_agent_scratchpad ;
    default1:hasMemoryScope "private"^^xsd:string .

demo:MemBinding_system a default1:MemoryBinding ;
    default1:bindsMemory demo:Memory_system_global ;
    default1:hasMemoryScope "global"^^xsd:string .

demo:Memory_agent_scratchpad a agento:Memory ;
    default1:hasPersistenceScope "execution"^^xsd:string ;
    default1:hasTitle "PlannerScratchpad"^^xsd:string .

demo:Memory_system_global a agento:Memory ;
    default1:hasPersistenceScope "global"^^xsd:string ;
    default1:hasTitle "GlobalMemory"^^xsd:string .

demo:Memory_team_shared a agento:Memory ;
    default1:hasPersistenceScope "thread"^^xsd:string ;
    default1:hasTitle "TeamSharedMemory"^^xsd:string .

demo:Orchestration_demo a default1:Orchestration ;
    default1:employsCoordinationPattern default1:Sequential ;
    default1:hasTitle "DemoOrchestration"^^xsd:string ;
    default1:orchestratesTeam demo:Team_demo ;
    agento:hasWorkflowPattern demo:WorkflowPattern_demo .

demo:ReAct_planner a default1:ReAct .

demo:Step_plan a agento:StartStep,
        agento:WorkflowStep ;
    default1:hasAssociatedTask demo:Task_plan ;
    default1:hasTitle "plan"^^xsd:string ;
    agento:nextStep demo:Step_execute ;
    agento:stepOrder 1 .

demo:SubTeam_review a agento:Team ;
    default1:employsCoordinationPattern default1:RoundRobin ;
    default1:hasTitle "ReviewSubTeam"^^xsd:string ;
    agento:hasAgentMember demo:Agent_human_approver .

demo:TaskPrompt_execute a agento:Prompt ;
    agento:promptInstruction "Run each plan step in order."^^xsd:string .

demo:TaskPrompt_plan a agento:Prompt ;
    agento:promptInstruction "Produce a short execution plan."^^xsd:string ;
    agento:promptOutputIndicator "Plan:"^^xsd:string .

demo:Task_execute a agento:Task ;
    default1:dependsOn demo:Task_plan ;
    default1:hasDelegationStrategy "SelfAssign"^^xsd:string ;
    default1:hasDependencyType "sequential"^^xsd:string ;
    default1:hasDescription "Execute each step using available tools."^^xsd:string ;
    default1:hasExpectedOutput "execution log"^^xsd:string ;
    default1:taskToolUsage demo:Tool_calculator ;
    agento:performedByAgent demo:Agent_executor ;
    agento:taskPrompt demo:TaskPrompt_execute .

demo:Term_demo a default1:TaskCompletionTermination ;
    default1:hasTitle "TaskCompletion"^^xsd:string .

demo:Tool_calculator a agento:Tool ;
    default1:hasInputSchema "{\"properties\": {\"expression\": {\"type\": \"string\"}}}"^^xsd:string ;
    default1:hasTitle "calculator"^^xsd:string .

demo:Tool_search a agento:Tool ;
    default1:hasImplementationReference "tools.search"^^xsd:string ;
    default1:hasInputSchema "{\"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}"^^xsd:string ;
    default1:hasTitle "search"^^xsd:string .

demo:WorkflowPattern_demo a agento:WorkflowPattern ;
    agento:hasWorkflowStep demo:Step_execute,
        demo:Step_plan .

cr_ag:AgentPrompt_Code_Reviewer a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptContext "Review the code for correctness, readability, and best practices. Identify bugs, code smells, naming issues, and suggest improvements. Use the code analyzer tool to check for syntax and structural issues."^^xsd:string ;
    agento:promptInstruction "You are a senior software engineer with 15 years of experience in code review."^^xsd:string .

cr_ag:AgentPrompt_Review_Summarizer a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptContext "Compile all findings into a structured review report. Provide a verdict: APPROVED if no critical or major issues, otherwise REQUEST CHANGES. Include a summary, critical count, and action items. When done, reply with TERMINATE."^^xsd:string ;
    agento:promptInstruction "You are a technical lead who synthesizes feedback from code reviewers and security auditors."^^xsd:string .

cr_ag:AgentPrompt_Security_Auditor a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptContext "Audit the code for security vulnerabilities including injection attacks, hardcoded secrets, insecure data handling, missing input validation, and OWASP Top 10 issues. Provide CWE classifications for each finding."^^xsd:string ;
    agento:promptInstruction "You are a certified security professional specializing in application security."^^xsd:string .

cr_ag:FlowStep_run_team a agento:StartStep,
        agento:WorkflowStep ;
    default1:callsCrew "team"^^xsd:string ;
    default1:hasTitle "run_team"^^xsd:string ;
    agento:stepOrder 1 .

cr_ag:FlowWorkflowPattern_AutoGenFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep cr_ag:FlowStep_run_team .

cr_ag:Goal_Code_Reviewer a agento:Goal ;
    default1:hasDescription "You are a senior software engineer with 15 years of experience in code review."^^xsd:string .

cr_ag:Goal_Review_Summarizer a agento:Goal ;
    default1:hasDescription "You are a technical lead who synthesizes feedback from code reviewers and security auditors."^^xsd:string .

cr_ag:Goal_Security_Auditor a agento:Goal ;
    default1:hasDescription "You are a certified security professional specializing in application security."^^xsd:string .

cr_ag:Orchestration_AutoGenFlow a default1:Orchestration ;
    default1:employsCoordinationPattern default1:Sequential ;
    default1:hasTitle "AutoGenFlow"^^xsd:string ;
    agento:hasWorkflowPattern cr_ag:FlowWorkflowPattern_AutoGenFlow .

cr_ag:TaskPrompt_autogen_task_0 a agento:Prompt ;
    default1:hasSourceAttribute "task"^^xsd:string ;
    agento:promptInstruction "f'Review the following code for quality and security:\\n{code_to_review}'"^^xsd:string .

cr_ag:Team_RoundRobinGroupChat_0 a agento:Team ;
    default1:employsCoordinationPattern default1:RoundRobin ;
    default1:hasTerminationCondition cr_ag:TurnLimit_RoundRobinGroupChat_0 ;
    default1:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agento:hasAgentMember cr_ag:Agent_Code_Reviewer,
        cr_ag:Agent_Review_Summarizer,
        cr_ag:Agent_Security_Auditor .

cr_ag:TurnLimit_RoundRobinGroupChat_0 a default1:TurnLimitTermination ;
    default1:hasMaxTurns 3 .

joke_lg:AgentPrompt_generate_joke a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_prompt"^^xsd:string ;
    agento:promptInstruction "First LLM call to generate initial joke"^^xsd:string .

joke_lg:AgentPrompt_improve_joke a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_prompt"^^xsd:string ;
    agento:promptInstruction "Second LLM call to improve the joke"^^xsd:string .

joke_lg:AgentPrompt_polish_joke a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_prompt"^^xsd:string ;
    agento:promptInstruction "Third LLM call for final polish"^^xsd:string .

joke_lg:FlowStep_generate_joke a default1:ConditionalStep,
        agento:StartStep,
        agento:WorkflowStep ;
    default1:hasAssociatedAgent joke_lg:Agent_generate_joke ;
    default1:hasEdgeMapping "{\"Fail\": \"improve_joke\", \"Pass\": \"END\"}"^^xsd:string ;
    default1:hasRoutingLogic """if '?' in state['joke'] or '!' in state['joke']:
    return 'Pass'
return 'Fail'"""^^xsd:string ;
    default1:hasTitle "generate_joke"^^xsd:string ;
    agento:stepOrder 1 .

joke_lg:FlowStep_improve_joke a agento:WorkflowStep ;
    default1:hasAssociatedAgent joke_lg:Agent_improve_joke ;
    default1:hasTitle "improve_joke"^^xsd:string ;
    agento:nextStep joke_lg:FlowStep_polish_joke ;
    agento:stepOrder 2 .

joke_lg:FlowWorkflowPattern_StateGraph a agento:WorkflowPattern ;
    agento:hasWorkflowStep joke_lg:FlowStep_generate_joke,
        joke_lg:FlowStep_improve_joke,
        joke_lg:FlowStep_polish_joke .

joke_lg:Goal_generate_joke a agento:Goal ;
    default1:hasDescription "First LLM call to generate initial joke"^^xsd:string .

joke_lg:Goal_improve_joke a agento:Goal ;
    default1:hasDescription "Second LLM call to improve the joke"^^xsd:string .

joke_lg:Goal_polish_joke a agento:Goal ;
    default1:hasDescription "Third LLM call for final polish"^^xsd:string .

joke_lg:Orchestration_StateGraph a default1:Orchestration ;
    default1:employsCoordinationPattern default1:Sequential ;
    default1:hasOutputSchema joke_lg:StateSchema_StateGraph ;
    default1:hasTitle "StateGraph"^^xsd:string ;
    agento:hasWorkflowPattern joke_lg:FlowWorkflowPattern_StateGraph .

joke_lg:RoutingTermination_langgraph_team_0_0 a default1:RoutingTermination .

joke_lg:StateSchema_StateGraph a default1:Schema ;
    default1:hasSchemaDefinition "{\"final_joke\": \"str\", \"improved_joke\": \"str\", \"joke\": \"str\", \"topic\": \"str\"}"^^xsd:string ;
    default1:hasSourceAttribute "state_model"^^xsd:string ;
    default1:hasTitle "State"^^xsd:string .

joke_lg:TaskPrompt_task_generate_joke a agento:Prompt ;
    agento:promptInstruction "Perform generate_joke responsibilities"^^xsd:string ;
    agento:promptOutputIndicator "joke"^^xsd:string .

joke_lg:TaskPrompt_task_improve_joke a agento:Prompt ;
    agento:promptInstruction "Perform improve_joke responsibilities"^^xsd:string ;
    agento:promptOutputIndicator "improved_joke"^^xsd:string .

joke_lg:TaskPrompt_task_polish_joke a agento:Prompt ;
    agento:promptInstruction "Perform polish_joke responsibilities"^^xsd:string ;
    agento:promptOutputIndicator "final_joke"^^xsd:string .

joke_lg:Team_langgraph_team_0 a agento:Team ;
    default1:employsCoordinationPattern default1:Custom ;
    default1:hasTerminationCondition joke_lg:RoutingTermination_langgraph_team_0_0 ;
    default1:hasTitle "StateGraph"^^xsd:string ;
    agento:hasAgentMember joke_lg:Agent_generate_joke,
        joke_lg:Agent_improve_joke,
        joke_lg:Agent_polish_joke .

ma_cr:AgentPrompt_meeting_analyzer a agento:Prompt ;
    default1:hasDirectiveFunction "DualDirective"^^xsd:string ;
    default1:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptContext "You are an expert in analyzing meeting transcripts and summarizing the discussions into actionable tasks.  Your ability to identify important issues helps ensure teams can follow up and address key points effectively."^^xsd:string ;
    agento:promptInstruction """Meeting Transcript Analysis Agent: Analyze the provided meeting transcript and extract important, actionable tasks or issues.  The goal is to break down the meeting content into well-structured,  detailed issues that can be easily understood and uploaded to Trello.
Here is the meeting transcript for your reference:\\n\\n {transcript}"""^^xsd:string .

ma_cr:Config_verbose_Team_MeetingAssistantCrew a agento:Config ;
    agento:configKey "verbose"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

ma_cr:CrewStep_MeetingAssistantCrew_analyze_meeting a agento:EndStep,
        agento:StartStep ;
    default1:hasTitle "analyze_meeting"^^xsd:string ;
    agento:hasAssociatedTask ma_cr:Task_analyze_meeting ;
    agento:stepOrder 1 .

ma_cr:FlowStep_load_meeting_notes a agento:StartStep,
        agento:WorkflowStep ;
    default1:hasTitle "load_meeting_notes"^^xsd:string ;
    agento:nextStep ma_cr:FlowStep_generate_tasks_from_meeting_transcript ;
    agento:stepOrder 1 .

ma_cr:FlowWorkflowPattern_MeetingFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ma_cr:FlowStep_add_tasks_to_trello,
        ma_cr:FlowStep_generate_tasks_from_meeting_transcript,
        ma_cr:FlowStep_load_meeting_notes,
        ma_cr:FlowStep_save_new_tasks_to_csv,
        ma_cr:FlowStep_send_slack_notification .

ma_cr:Goal_meeting_analyzer a agento:Goal ;
    default1:hasDescription """Analyze the provided meeting transcript and extract important, actionable tasks or issues.  The goal is to break down the meeting content into well-structured,  detailed issues that can be easily understood and uploaded to Trello.
Here is the meeting transcript for your reference:\\n\\n {transcript}"""^^xsd:string .

ma_cr:LM_gpt_4 a agento:LanguageModel ;
    default1:hasTitle "gpt-4"^^xsd:string .

ma_cr:Orchestration_MeetingFlow a default1:Orchestration ;
    default1:employsCoordinationPattern default1:Sequential ;
    default1:hasOutputSchema ma_cr:StateSchema_MeetingFlow ;
    default1:hasTitle "MeetingFlow"^^xsd:string ;
    default1:orchestratesTeam ma_cr:Team_MeetingAssistantCrew ;
    agento:hasWorkflowPattern ma_cr:FlowWorkflowPattern_MeetingFlow .

ma_cr:Schema_MeetingTaskList a default1:Schema ;
    default1:hasSchemaDefinition "{\"properties\":{\"tasks\":{\"type\":\"string\"}},\"required\":[\"tasks\"],\"type\":\"object\"}"^^xsd:string ;
    default1:hasSourceAttribute "output_pydantic"^^xsd:string ;
    default1:hasTitle "MeetingTaskList"^^xsd:string .

ma_cr:StateSchema_MeetingFlow a default1:Schema ;
    default1:hasSchemaDefinition "{\"tasks\": \"List[MeetingTask]\", \"transcript\": \"str\"}"^^xsd:string ;
    default1:hasSourceAttribute "state_model"^^xsd:string ;
    default1:hasTitle "MeetingState"^^xsd:string .

ma_cr:TaskPrompt_analyze_meeting a agento:Prompt ;
    default1:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction """Analyze the provided meeting transcript and generate a set of detailed,  well-organized issues based on the discussion. Focus on breaking down the transcript into manageable tasks or issues,  making sure to document each issue thoroughly with steps to reproduce, acceptance criteria,  and any other relevant details.
Here is the meeting transcript for your reference:\\n\\n {transcript}"""^^xsd:string ;
    agento:promptOutputIndicator "A JSON list of issues with titles and bodies, containing clear instructions,  steps to reproduce, and acceptance criteria where applicable."^^xsd:string .

ma_cr:Task_analyze_meeting a agento:Task ;
    default1:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    default1:hasExpectedOutput "A JSON list of issues with titles and bodies, containing clear instructions,  steps to reproduce, and acceptance criteria where applicable."^^xsd:string ;
    default1:hasOutputSchema ma_cr:Schema_MeetingTaskList ;
    agento:performedByAgent ma_cr:Agent_meeting_analyzer ;
    agento:taskPrompt ma_cr:TaskPrompt_analyze_meeting .

ma_cr:WorkflowPattern_MeetingAssistantCrew a agento:WorkflowPattern ;
    agento:hasWorkflowStep ma_cr:CrewStep_MeetingAssistantCrew_analyze_meeting .

