    default1:hasImplementationReference "tools.code_analyzer"^^xsd:string ;
    default1:hasInputSchema "{\"properties\": {\"code\": {\"type\": \"string\"}, \"language\": {\"type\": \"string\"}}, \"required\": [\"code\", \"language\"], \"type\": \"object\"}"^^xsd:string .

