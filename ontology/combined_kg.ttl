tb_cr:FlowStep_write_blog a agento:StartStep,
        agento:WorkflowStep ;
    default1:callsCrew "TechBlogCrew"^^xsd:string ;
    default1:hasTitle "write_blog"^^xsd:string ;
    agento:nextStep tb_cr:FlowStep_publish ;
    agento:stepOrder 1 .

tb_cr:FlowWorkflowPattern_TechBlogFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep tb_cr:FlowStep_publish,
        tb_cr:FlowStep_write_blog .

tb_cr:Goal_editor a agento:Goal ;
    default1:hasDescription "Review and refine the blog post for clarity, grammar, and flow."^^xsd:string .

tb_cr:Goal_researcher a agento:Goal ;
    default1:hasDescription "Gather comprehensive, up-to-date information on '{topic}'."^^xsd:string .

tb_cr:Goal_writer a agento:Goal ;
    default1:hasDescription "Write an engaging, easy-to-read blog post based on research."^^xsd:string .

tb_cr:Orchestration_TechBlogFlow a default1:Orchestration ;
    default1:employsCoordinationPattern default1:Sequential ;
    default1:hasOutputSchema tb_cr:StateSchema_TechBlogFlow ;
    default1:hasTitle "TechBlogFlow"^^xsd:string ;
    default1:orchestratesTeam tb_cr:Team_TechBlogCrew ;
    agento:hasWorkflowPattern tb_cr:FlowWorkflowPattern_TechBlogFlow .

tb_cr:StateSchema_TechBlogFlow a default1:Schema ;
    default1:hasSchemaDefinition "{\"final_post\": \"str\", \"topic\": \"str\"}"^^xsd:string ;
    default1:hasSourceAttribute "state_model"^^xsd:string ;
    default1:hasTitle "TechBlogState"^^xsd:string .

tb_cr:TaskPrompt_edit_post a agento:Prompt ;
    default1:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Review the drafted blog post. Check for clarity, tone, spelling, and grammar. Ensure it is engaging."^^xsd:string ;
    agento:promptOutputIndicator "A polished, final version of the blog post, ready for publication."^^xsd:string .

tb_cr:TaskPrompt_research_topic a agento:Prompt ;
    default1:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Conduct thorough research on the topic: '{topic}'. Identify key trends, benefits, challenges, and future outlook."^^xsd:string ;
    agento:promptOutputIndicator "A detailed summary of research findings."^^xsd:string .

tb_cr:TaskPrompt_write_draft a agento:Prompt ;
    default1:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Using the research provided, write a comprehensive 500-word blog post about '{topic}'."^^xsd:string ;
    agento:promptOutputIndicator "A complete blog post draft."^^xsd:string .

tb_cr:Task_edit_post a agento:Task ;
    default1:dependsOn tb_cr:Task_write_draft ;
    default1:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    default1:hasDependencyType "Sequential"^^xsd:string ;
    default1:hasExpectedOutput "A polished, final version of the blog post, ready for publication."^^xsd:string ;
    agento:performedByAgent tb_cr:Agent_editor ;
    agento:taskPrompt tb_cr:TaskPrompt_edit_post .

tb_cr:WorkflowPattern_TechBlogCrew a agento:WorkflowPattern ;
    agento:hasWorkflowStep tb_cr:CrewStep_TechBlogCrew_edit_post,
        tb_cr:CrewStep_TechBlogCrew_research_topic,
        tb_cr:CrewStep_TechBlogCrew_write_draft .

tp_ag:AgentPrompt_language_agent a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message, description"^^xsd:string ;
    agento:promptContext "If the plan already includes language tips, you can mention that the plan is satisfactory, with rationale."^^xsd:string ;
    agento:promptInstruction "You are a helpful assistant that can review travel plans, providing feedback on important/critical tips about how best to address language or communication challenges for the given destination."^^xsd:string .

tp_ag:AgentPrompt_local_agent a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message, description"^^xsd:string ;
    agento:promptInstruction "You are a helpful assistant that can suggest authentic and interesting local activities or places to visit for a user and can utilize any context information provided."^^xsd:string .

tp_ag:AgentPrompt_planner_agent a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message, description"^^xsd:string ;
    agento:promptInstruction "You are a helpful assistant that can suggest a travel plan for a user based on their request."^^xsd:string .

tp_ag:AgentPrompt_travel_summary_agent a agento:Prompt ;
    default1:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    default1:hasSourceAttribute "system_message, description"^^xsd:string ;
    agento:promptContext "You must ensure that the final plan is integrated and complete. YOUR FINAL RESPONSE MUST BE THE COMPLETE PLAN. When the plan is complete and all perspectives are integrated, you can respond with TERMINATE."^^xsd:string ;
    agento:promptInstruction "You are a helpful assistant that can take in all of the suggestions and advice from the other agents and provide a detailed final travel plan."^^xsd:string .

tp_ag:EventTermination_SelectorGroupChat_0_0 a default1:EventBasedTermination ;
    default1:hasTriggerExpression "TERMINATE"^^xsd:string .

