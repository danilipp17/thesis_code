"""
Auto-generated AutoGen application: {{ system_name }}
"""

import asyncio
import dotenv
from typing import Any, Dict, List, Optional

dotenv.load_dotenv()

from autogen_agentchat.agents import AssistantAgent
from autogen_agentchat.conditions import MaxMessageTermination, TextMentionTermination
from autogen_agentchat.teams import RoundRobinGroupChat, SelectorGroupChat
from autogen_agentchat.ui import Console
from autogen_ext.models.openai import OpenAIChatCompletionClient

{% if tools %}
from autogen_core.tools import FunctionTool
from tools import {{ tools | join(', ') }}
{% endif %}
{% if memory_classes %}
from autogen_core.memory import {{ memory_classes | join(', ') }}
{% endif %}

model_client = OpenAIChatCompletionClient(model="{{ model }}")

{% if tools %}
# -- Tools --
{% for tool in tools_config %}
{{ tool.var_name }} = FunctionTool(
    {{ tool.func_name }},
    description="{{ tool.desc }}",
)
{% endfor %}
{% endif %}

# -- Agents --
{% for agent in agents %}
{{ agent.var_name }} = AssistantAgent(
    name="{{ agent.name }}",
    model_client=model_client,
    {% if agent.tool_vars %}
    tools=[{{ agent.tool_vars | join(', ') }}],
    {% endif %}
    {% if agent.memory_class %}
    memory=[{{ agent.memory_class }}()],
    {% endif %}
    {% if agent.description %}
    description="{{ agent.description }}",
    {% endif %}
    system_message=(
        "{{ agent.system_message }}"
    ),
)

{% endfor %}
{% for team in teams %}
# -- Team --
{# The termination variable must be introduced via a simple `Name = Call`
   assignment so AutoGenParser.term_vars picks it up; only then does the
   parser emit a hasTerminationCondition triple (and, for TurnLimit,
   hasMaxTurns). Avoid synthesising extra conditions the source did not
   have — they'd add spurious triples to TTL₂ and depress triple_f1. #}
{# Emit one termination variable per condition so AutoGenParser.term_vars
   picks each up as a simple `Name = Call`. If both MaxMessage and an
   EventBased trigger exist, combine them via `|` — the parser treats
   that BinOp as a composite of the two named vars, which populator
   then serialises back to the same two hasTerminationCondition triples
   (plus hasTriggerExpression for the EventBased one). #}
{# Fix #3: AutoGen's ``max_turns`` parameter on the group chat and
   ``MaxMessageTermination(N)`` have different semantics. Earlier
   versions of this template translated ``max_turns=N`` from the ABox
   into ``MaxMessageTermination(N)`` which terminates after N total
   messages (including the user's task message), so a single-agent
   team with ``max_turns=1`` terminated before the agent's first turn
   and never invoked the LLM. We now pass ``max_turns`` directly to
   the team constructor and only emit ``MaxMessageTermination`` as a
   safety bound when no ``max_turns`` is set. ``TextMentionTermination``
   is emitted unconditionally when a trigger expression is present. #}
{% if team.trigger_expression %}
text_termination = TextMentionTermination("{{ team.trigger_expression }}")
{% endif %}
{% if not team.max_turns %}
max_msg_termination = MaxMessageTermination(10)
{% endif %}
{% if team.trigger_expression and not team.max_turns %}
termination = max_msg_termination | text_termination
{% elif team.trigger_expression %}
termination = text_termination
{% elif not team.max_turns %}
termination = max_msg_termination
{% endif %}

{% if team.pattern == "SelectorBased" or team.process == "hierarchical" %}
team = SelectorGroupChat(
    participants=[{{ team.agents | join(', ') }}],
    model_client=model_client,
{% if team.max_turns %}    max_turns={{ team.max_turns }},
{% endif %}{% if team.trigger_expression or not team.max_turns %}    termination_condition=termination,
{% endif %})
{% else %}
team = RoundRobinGroupChat(
    participants=[{{ team.agents | join(', ') }}],
{% if team.max_turns %}    max_turns={{ team.max_turns }},
{% endif %}{% if team.trigger_expression or not team.max_turns %}    termination_condition=termination,
{% endif %})
{% endif %}

{% endfor %}

async def main():
    stream = team.run_stream(
        task="{{ task_string }}"
    )
    await Console(stream)
    await model_client.close()


if __name__ == "__main__":
    asyncio.run(main())
