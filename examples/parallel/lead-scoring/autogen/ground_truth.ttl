@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/lead_scoring#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# lead-scoring (AutoGen v0.4) — hand-authored ground-truth.
# AutoGen port of the CrewAI two-crew flow: a RoundRobinGroupChat
# (max_turns=3 -> TurnLimitTermination) of three agents:
#   - hr_evaluation_agent  (AssistantAgent, scores leads)
#   - human_reviewer       (UserProxyAgent -> HumanCheckpoint, the
#                           human-in-the-loop gate)
#   - email_followup_agent (AssistantAgent, writes emails)
# Each AssistantAgent carries a system_message (-> Goal + ModelDirective
# prompt) and a description (-> OrchestratorDirective prompt).
# ============================================================

ex:lead_scoring a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "lead_scoring"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_hr_evaluation_agent,
        ex:Agent_human_reviewer,
        ex:Agent_email_followup_agent ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- hr_evaluation_agent ----------
ex:Agent_hr_evaluation_agent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "hr_evaluation_agent"^^xsd:string ;
    agento:agentRole "hr_evaluation_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_hr_evaluation_agent,
        ex:OrchestratorPrompt_hr_evaluation_agent ;
    agento:hasAgentGoal ex:Goal_hr_evaluation_agent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_hr_evaluation_agent a agento:Goal ;
    agentoscin:hasDescription "You are a Senior HR Evaluation Expert."^^xsd:string .

ex:AgentPrompt_hr_evaluation_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message, description"^^xsd:string ;
    agento:promptInstruction "You are a Senior HR Evaluation Expert."^^xsd:string ;
    agento:promptContext "Analyze candidates' qualifications and compare them against the job description to provide a score (1-100) and detailed reasoning, considering skill match, experience, cultural fit, and growth potential."^^xsd:string .

ex:OrchestratorPrompt_hr_evaluation_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agento:promptInstruction "Scores candidates against the job description."^^xsd:string .

# ---------- human_reviewer (UserProxy -> HumanCheckpoint) ----------
ex:Agent_human_reviewer a agento:LLMAgent ;
    agentoscin:agentType "UserProxy"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:hasHumanCheckpoint ex:HumanCheckpoint_human_reviewer ;
    agento:agentID "human_reviewer"^^xsd:string ;
    agento:agentRole "human_reviewer"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_human_reviewer,
        ex:OrchestratorPrompt_human_reviewer .

ex:HumanCheckpoint_human_reviewer a agentoscin:HumanCheckpoint ;
    agentoscin:hasCheckpointType "InputRequest"^^xsd:string ;
    agentoscin:isMandatory true .

ex:AgentPrompt_human_reviewer a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message, description"^^xsd:string .

ex:OrchestratorPrompt_human_reviewer a agento:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agento:promptInstruction "A human who reviews the scored leads before emails are written."^^xsd:string .

# ---------- email_followup_agent ----------
ex:Agent_email_followup_agent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "email_followup_agent"^^xsd:string ;
    agento:agentRole "email_followup_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_email_followup_agent,
        ex:OrchestratorPrompt_email_followup_agent ;
    agento:hasAgentGoal ex:Goal_email_followup_agent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_email_followup_agent a agento:Goal ;
    agentoscin:hasDescription "You are an HR Coordinator named Sarah."^^xsd:string .

ex:AgentPrompt_email_followup_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message, description"^^xsd:string ;
    agento:promptInstruction "You are an HR Coordinator named Sarah."^^xsd:string ;
    agento:promptContext "Compose personalized follow-up emails to candidates based on their bio and whether they are being pursued. If proceeding, request availability for a Zoom call; otherwise send a polite rejection email. When finished, reply with TERMINATE."^^xsd:string .

ex:OrchestratorPrompt_email_followup_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agento:promptInstruction "Writes personalized follow-up emails to candidates."^^xsd:string .

# ---------- team + termination ----------
ex:TurnLimit_RoundRobinGroupChat_0 a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 3 .

ex:Team_RoundRobinGroupChat_0 a agento:Team ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasTerminationCondition ex:TurnLimit_RoundRobinGroupChat_0 ;
    agento:hasAgentMember ex:Agent_hr_evaluation_agent,
        ex:Agent_human_reviewer,
        ex:Agent_email_followup_agent .

# ---------- team.run_stream reified ----------
ex:Task_autogen_task_0 a agento:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt ex:TaskPrompt_autogen_task_0 .

ex:TaskPrompt_autogen_task_0 a agento:Prompt ;
    agentoscin:hasSourceAttribute "task"^^xsd:string ;
    agento:promptInstruction "Score the candidates in leads.csv against the Junior React Developer role, let the human review, then write follow-up emails."^^xsd:string .

ex:FlowStep_run_team a agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:callsCrew "team"^^xsd:string ;
    agento:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_run_team .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .
