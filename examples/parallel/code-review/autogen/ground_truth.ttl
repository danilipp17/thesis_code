@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/code_review#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# code-review (AutoGen) — hand-authored ground-truth ABox.
# Original of this family. Captures the source semantics:
#   - 3 AssistantAgents in RoundRobinGroupChat:
#       Code_Reviewer, Security_Auditor, Review_Summarizer.
#   - FunctionTool wrapping code_analyzer(code, language="python").
#     Reviewer + Auditor have the tool; Summarizer does not.
#   - RoundRobinGroupChat(..., max_turns=3) -> TurnLimit(3).
#   - team.run_stream(task=...) reified as Task_autogen_task_0 +
#     FlowStep_run_team wrapped in AutoGenFlow orchestration.
# ============================================================

<http://example.org/code_review> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

# ---------- system root ----------
ex:code_review a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "code_review"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_Code_Reviewer,
        ex:Agent_Security_Auditor,
        ex:Agent_Review_Summarizer ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- tool (FunctionTool wrapping tools.code_analyzer) ----------
ex:Tool_code_analyzer a agento:Tool ;
    agentoscin:hasDescription "Performs static analysis on source code. Checks for syntax errors, undefined variables, unused imports, and common anti-patterns."^^xsd:string ;
    agentoscin:hasImplementationReference "tools.code_analyzer"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"code\": {\"type\": \"string\"}, \"language\": {\"type\": \"string\"}}, \"required\": [\"code\", \"language\"], \"type\": \"object\"}"^^xsd:string .

# ---------- agents ----------
ex:Agent_Code_Reviewer a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "Code_Reviewer"^^xsd:string ;
    agento:agentRole "Code_Reviewer"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_Code_Reviewer ;
    agento:agentToolUsage ex:Tool_code_analyzer ;
    agento:hasAgentGoal ex:Goal_Code_Reviewer ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_Code_Reviewer a agento:Goal ;
    agentoscin:hasDescription "You are a senior software engineer with 15 years of experience in code review."^^xsd:string .

ex:AgentPrompt_Code_Reviewer a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are a senior software engineer with 15 years of experience in code review."^^xsd:string ;
    agento:promptContext "Review the code for correctness, readability, and best practices. Identify bugs, code smells, naming issues, and suggest improvements. Use the code analyzer tool to check for syntax and structural issues."^^xsd:string .

ex:Agent_Security_Auditor a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "Security_Auditor"^^xsd:string ;
    agento:agentRole "Security_Auditor"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_Security_Auditor ;
    agento:agentToolUsage ex:Tool_code_analyzer ;
    agento:hasAgentGoal ex:Goal_Security_Auditor ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_Security_Auditor a agento:Goal ;
    agentoscin:hasDescription "You are a certified security professional specializing in application security."^^xsd:string .

ex:AgentPrompt_Security_Auditor a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are a certified security professional specializing in application security."^^xsd:string ;
    agento:promptContext "Audit the code for security vulnerabilities including injection attacks, hardcoded secrets, insecure data handling, missing input validation, and OWASP Top 10 issues. Provide CWE classifications for each finding."^^xsd:string .

ex:Agent_Review_Summarizer a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "Review_Summarizer"^^xsd:string ;
    agento:agentRole "Review_Summarizer"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_Review_Summarizer ;
    agento:hasAgentGoal ex:Goal_Review_Summarizer ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_Review_Summarizer a agento:Goal ;
    agentoscin:hasDescription "You are a technical lead who synthesizes feedback from code reviewers and security auditors."^^xsd:string .

ex:AgentPrompt_Review_Summarizer a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are a technical lead who synthesizes feedback from code reviewers and security auditors."^^xsd:string ;
    agento:promptContext "Compile all findings into a structured review report. Provide a verdict: APPROVED if no critical or major issues, otherwise REQUEST CHANGES. Include a summary, critical count, and action items. When done, reply with TERMINATE."^^xsd:string .

# ---------- team + termination ----------
ex:TurnLimit_RoundRobinGroupChat_0 a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 3 .

ex:Team_RoundRobinGroupChat_0 a agento:Team ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasTerminationCondition ex:TurnLimit_RoundRobinGroupChat_0 ;
    agento:hasAgentMember ex:Agent_Code_Reviewer,
        ex:Agent_Security_Auditor,
        ex:Agent_Review_Summarizer .

# ---------- team.run_stream(task=...) reified ----------
ex:Task_autogen_task_0 a agento:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt ex:TaskPrompt_autogen_task_0 .

ex:TaskPrompt_autogen_task_0 a agento:Prompt ;
    agentoscin:hasSourceAttribute "task"^^xsd:string ;
    agento:promptInstruction "f'Review the following code for quality and security:\\n{code_to_review}'"^^xsd:string .

ex:FlowStep_run_team a agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:callsCrew "team"^^xsd:string ;
    agento:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_run_team .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .
