@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/maths#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# react (AutoGen) — hand-authored ground-truth.
# Captures the source semantics:
#   - Single AssistantAgent ``our_agent`` with 3 FunctionTool
#     wrappers (add, subtract, multiply); reflect_on_tool_use=True.
#   - Wrapped in a 1-member RoundRobinGroupChat(max_turns=1) ->
#     TurnLimitTermination(1). The ReAct loop is the agent's
#     internal tool-call behaviour and is not surfaced as a
#     coordination primitive.
#   - team.run_stream(task=...) reified as Task_autogen_task_0 +
#     FlowStep_run_team in AutoGenFlow orchestration.
# ============================================================

<http://example.org/maths> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

# ---------- system root ----------
ex:maths a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "maths"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_our_agent ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- tools (FunctionTool wrappers) ----------
ex:Tool_add a agento:Tool ;
    agentoscin:hasDescription "Add two integers."^^xsd:string ;
    agentoscin:hasImplementationReference "main.add"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}, \"required\": [\"a\", \"b\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "add"^^xsd:string .

ex:Tool_subtract a agento:Tool ;
    agentoscin:hasDescription "Subtract two integers."^^xsd:string ;
    agentoscin:hasImplementationReference "main.subtract"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}, \"required\": [\"a\", \"b\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "subtract"^^xsd:string .

ex:Tool_multiply a agento:Tool ;
    agentoscin:hasDescription "Multiply two integers."^^xsd:string ;
    agentoscin:hasImplementationReference "main.multiply"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}, \"required\": [\"a\", \"b\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "multiply"^^xsd:string .

# ---------- agent ----------
ex:Agent_our_agent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled true ;
    agento:agentID "our_agent"^^xsd:string ;
    agento:agentRole "our_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_our_agent ;
    agento:agentToolUsage ex:Tool_add,
        ex:Tool_subtract,
        ex:Tool_multiply ;
    agento:hasAgentGoal ex:Goal_our_agent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_our_agent a agento:Goal ;
    agentoscin:hasDescription "You are my AI assistant, please answer my query to the best of your ability."^^xsd:string .

ex:AgentPrompt_our_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are my AI assistant, please answer my query to the best of your ability."^^xsd:string .

# ---------- team + termination ----------
ex:TurnLimit_RoundRobinGroupChat_0 a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 1 .

ex:Team_RoundRobinGroupChat_0 a agento:Team ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasTerminationCondition ex:TurnLimit_RoundRobinGroupChat_0 ;
    agento:hasAgentMember ex:Agent_our_agent .

# ---------- team.run_stream reified ----------
ex:Task_autogen_task_0 a agento:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt ex:TaskPrompt_autogen_task_0 .

ex:TaskPrompt_autogen_task_0 a agento:Prompt ;
    agentoscin:hasSourceAttribute "task"^^xsd:string ;
    agento:promptInstruction "Add 40 + 12 and then multiply the result by 6. Also tell me a joke please."^^xsd:string .

ex:FlowStep_run_team a agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:callsCrew "team"^^xsd:string ;
    agento:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_run_team .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .
