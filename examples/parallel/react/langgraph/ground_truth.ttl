@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/react#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# react (LangGraph) — hand-authored ground-truth.
# Original of this family. Captures the source semantics:
#   - TypedDict AgentState {messages: Annotated[Sequence[BaseMessage],
#     add_messages]} -> additive message reducer.
#   - Single LLMAgent ``our_agent`` invoking ChatOpenAI gpt-4o
#     bound to three @tool primitives (add, subtract, multiply).
#   - StateGraph with two nodes: our_agent and tools (ToolNode).
#   - Entry point our_agent; conditional edge from our_agent via
#     should_continue (continue -> tools, end -> END); unconditional
#     edge tools -> our_agent. Models the ReAct loop.
#   - All three tools share a single agento:Tool individual that
#     groups the arithmetic primitive set.
# ============================================================

<http://example.org/react> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

# ---------- system root ----------
ex:react a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "LangGraph"^^xsd:string ;
    agentoscin:hasTitle "react"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_our_agent ;
    agentoscin:containsTeam ex:Team_langgraph_team_0 ;
    agentoscin:containsOrchestration ex:Orchestration_StateGraph .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- tools ----------
ex:Tool_add a agento:Tool ;
    agentoscin:hasDescription "This is an addition function that adds 2 numbers together."^^xsd:string ;
    agentoscin:hasImplementationReference "main.add"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}, \"required\": [\"a\", \"b\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "add"^^xsd:string .

ex:Tool_subtract a agento:Tool ;
    agentoscin:hasDescription "Subtraction function."^^xsd:string ;
    agentoscin:hasImplementationReference "main.subtract"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}, \"required\": [\"a\", \"b\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "subtract"^^xsd:string .

ex:Tool_multiply a agento:Tool ;
    agentoscin:hasDescription "Multiplication function."^^xsd:string ;
    agentoscin:hasImplementationReference "main.multiply"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}, \"required\": [\"a\", \"b\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "multiply"^^xsd:string .

# ---------- agent ----------
# Note: the LangGraph extractor for inline-SystemMessage ReAct agents
# does NOT synthesise hasAgentGoal / Goal individual (system prompt is
# created inside the node function rather than as a top-level binding),
# but it does still emit agentRole + hasReasoningEnabled from the node
# signature.
ex:Agent_our_agent a agento:LLMAgent ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "our_agent"^^xsd:string ;
    agento:agentRole "our_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_our_agent ;
    agento:agentToolUsage ex:Tool_add,
        ex:Tool_subtract,
        ex:Tool_multiply ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:AgentPrompt_our_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_prompt"^^xsd:string ;
    agento:promptContext "You are my AI assistant, please answer my query to the best of your ability."^^xsd:string .

# ---------- task ----------
ex:Task_task_our_agent a agento:Task ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:hasExpectedOutput "messages"^^xsd:string ;
    agento:performedByAgent ex:Agent_our_agent ;
    agento:taskPrompt ex:TaskPrompt_task_our_agent .

ex:TaskPrompt_task_our_agent a agento:Prompt ;
    agento:promptInstruction "Perform our_agent responsibilities"^^xsd:string ;
    agento:promptOutputIndicator "messages"^^xsd:string .

# ---------- node-level workflow ----------
# Note: the conditional edge our_agent --(should_continue)--> {tools, END}
# is captured on the our_agent step as ConditionalStep (the gate lives at
# the agent node, not at the ToolNode).
ex:FlowStep_our_agent a agentoscin:ConditionalStep,
        agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasAssociatedAgent ex:Agent_our_agent ;
    agentoscin:hasEdgeMapping "{\"continue\": \"tools\", \"end\": \"END\"}"^^xsd:string ;
    agentoscin:hasRoutingLogic "last_message = state['messages'][-1]"^^xsd:string ;
    agentoscin:hasTitle "our_agent"^^xsd:string ;
    agento:stepOrder 1 ;
    agento:nextStep ex:FlowStep_tools .

ex:FlowStep_tools a agento:WorkflowStep ;
    agentoscin:hasTitle "tools"^^xsd:string ;
    agento:stepOrder 2 ;
    agento:nextStep ex:FlowStep_our_agent .

ex:FlowWorkflowPattern_StateGraph a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_our_agent,
        ex:FlowStep_tools .

# ---------- task-level workflow ----------
# The extractor does not emit CrewStep_* / WorkflowPattern_langgraph_team_0
# for ReAct-style single-node graphs because the agent's own loop replaces
# the task-list workflow. Documented as a finding; the team retains its
# topology via FlowWorkflowPattern_StateGraph above.
ex:WorkflowPattern_langgraph_team_0 a agento:WorkflowPattern .

# ---------- state schema ----------
ex:StateSchema_StateGraph a agentoscin:Schema ;
    agentoscin:hasTitle "AgentState"^^xsd:string ;
    agentoscin:hasSourceAttribute "state_model"^^xsd:string ;
    agentoscin:hasSchemaDefinition "{\"messages\": \"Annotated[Sequence[BaseMessage], add_messages]\"}"^^xsd:string .

# ---------- team + orchestration ----------
ex:RoutingTermination_langgraph_team_0_0 a agentoscin:RoutingTermination .

ex:Team_langgraph_team_0 a agento:Team ;
    agentoscin:hasTitle "StateGraph"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:ReActLoop ;
    agentoscin:hasTerminationCondition ex:RoutingTermination_langgraph_team_0_0 ;
    agento:hasAgentMember ex:Agent_our_agent ;
    agento:hasWorkflowPattern ex:WorkflowPattern_langgraph_team_0 .

ex:Orchestration_StateGraph a agentoscin:Orchestration ;
    agentoscin:hasTitle "StateGraph"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasOutputSchema ex:StateSchema_StateGraph ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_StateGraph .
