@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/autogen#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# joke (AutoGen) — hand-authored ground-truth ABox.
# Captures the source semantics:
#   - 3 AssistantAgent in RoundRobinGroupChat
#     (Joke_Generator, Joke_Improver, Joke_Polisher) with
#     system_message split into Goal + AgentPrompt.
#   - MaxMessageTermination(4) -> TurnLimitTermination(4).
#   - The conditional gate of the LangGraph original is NOT
#     representable here -- the AutoGen variant always runs all
#     three agents (a thesis finding about framework expressivity).
#   - team.run(task=...) is reified as Task_autogen_task_0 +
#     FlowStep_run_team wrapped in AutoGenFlow orchestration.
# ============================================================

<http://example.org/autogen> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

# ---------- system root ----------
ex:joke a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "joke"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_Joke_Generator,
        ex:Agent_Joke_Improver,
        ex:Agent_Joke_Polisher ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- agents (AutoGen: system_message split into Goal + AgentPrompt) ----------
ex:Agent_Joke_Generator a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "Joke_Generator"^^xsd:string ;
    agento:agentRole "Joke_Generator"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_Joke_Generator ;
    agento:hasAgentGoal ex:Goal_Joke_Generator ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_Joke_Generator a agento:Goal ;
    agentoscin:hasDescription "You are a witty comedian."^^xsd:string .

ex:AgentPrompt_Joke_Generator a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are a witty comedian."^^xsd:string ;
    agento:promptContext "Write a short joke about the requested topic."^^xsd:string .

ex:Agent_Joke_Improver a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "Joke_Improver"^^xsd:string ;
    agento:agentRole "Joke_Improver"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_Joke_Improver ;
    agento:hasAgentGoal ex:Goal_Joke_Improver ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_Joke_Improver a agento:Goal ;
    agentoscin:hasDescription "You are a comedy writer."^^xsd:string .

ex:AgentPrompt_Joke_Improver a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are a comedy writer."^^xsd:string ;
    agento:promptContext "Take the previous joke and make it funnier by adding clever wordplay. Output 'IMPROVED' when done."^^xsd:string .

ex:Agent_Joke_Polisher a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "Joke_Polisher"^^xsd:string ;
    agento:agentRole "Joke_Polisher"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_Joke_Polisher ;
    agento:hasAgentGoal ex:Goal_Joke_Polisher ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_Joke_Polisher a agento:Goal ;
    agentoscin:hasDescription "You are a storyteller."^^xsd:string .

ex:AgentPrompt_Joke_Polisher a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are a storyteller."^^xsd:string ;
    agento:promptContext "Add a surprising twist to the previous joke for the final polished version. Conclude with 'TERMINATE'."^^xsd:string .

# ---------- termination ----------
ex:TurnLimit_RoundRobinGroupChat_0_0 a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 4 .

# ---------- team (RoundRobinGroupChat) ----------
ex:Team_RoundRobinGroupChat_0 a agento:Team ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasTerminationCondition ex:TurnLimit_RoundRobinGroupChat_0_0 ;
    agento:hasAgentMember ex:Agent_Joke_Generator,
        ex:Agent_Joke_Improver,
        ex:Agent_Joke_Polisher .

# ---------- team.run(task=...) reified ----------
ex:Task_autogen_task_0 a agento:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt ex:TaskPrompt_autogen_task_0 .

ex:TaskPrompt_autogen_task_0 a agento:Prompt ;
    agentoscin:hasSourceAttribute "task"^^xsd:string ;
    agento:promptInstruction "Write a joke about cats, then improve and polish it."^^xsd:string .

ex:FlowStep_run_team a agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:callsCrew "team"^^xsd:string ;
    agento:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_run_team .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .
