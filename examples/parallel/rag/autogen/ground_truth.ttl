@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/rag#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# rag (AutoGen v0.4) — hand-authored ground-truth.
# AutoGen port of the LangGraph RAG original: a single AssistantAgent
# with one retriever FunctionTool, wrapped in a 1-member
# RoundRobinGroupChat(max_turns=1) -> TurnLimitTermination(1). The
# ReAct tool-call loop is the agent's internal behaviour.
# The system_message is split into Goal (first sentence) + AgentPrompt.
# ============================================================

ex:rag a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "rag"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_rag_agent ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- tools (FunctionTool wrapper) ----------
ex:Tool_retriever_tool a agento:Tool ;
    agentoscin:hasDescription "Searches and returns information from the Stock Market Performance 2024 document."^^xsd:string ;
    agentoscin:hasImplementationReference "main.retriever_tool"^^xsd:string ;
    agentoscin:hasInputSchema "{\"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"], \"type\": \"object\"}"^^xsd:string ;
    agentoscin:hasTitle "retriever_tool"^^xsd:string .

# ---------- agent ----------
ex:Agent_rag_agent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "rag_agent"^^xsd:string ;
    agento:agentRole "rag_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_rag_agent ;
    agento:agentToolUsage ex:Tool_retriever_tool ;
    agento:hasAgentGoal ex:Goal_rag_agent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_rag_agent a agento:Goal ;
    agentoscin:hasDescription "You are an intelligent AI assistant who answers questions about Stock Market Performance in 2024 based on the PDF document loaded into your knowledge base."^^xsd:string .

ex:AgentPrompt_rag_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agento:promptInstruction "You are an intelligent AI assistant who answers questions about Stock Market Performance in 2024 based on the PDF document loaded into your knowledge base."^^xsd:string ;
    agento:promptContext "Use the retriever tool to answer questions, making multiple calls if needed, and always cite the specific parts of the documents you use."^^xsd:string .

# ---------- team + termination ----------
ex:TurnLimit_RoundRobinGroupChat_0 a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 1 .

ex:Team_RoundRobinGroupChat_0 a agento:Team ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasTerminationCondition ex:TurnLimit_RoundRobinGroupChat_0 ;
    agento:hasAgentMember ex:Agent_rag_agent .

# ---------- team.run_stream reified ----------
ex:Task_autogen_task_0 a agento:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agento:taskPrompt ex:TaskPrompt_autogen_task_0 .

ex:TaskPrompt_autogen_task_0 a agento:Prompt ;
    agentoscin:hasSourceAttribute "task"^^xsd:string ;
    agento:promptInstruction "How did the stock market perform in 2024?"^^xsd:string .

ex:FlowStep_run_team a agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:callsCrew "team"^^xsd:string ;
    agento:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_run_team .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .
