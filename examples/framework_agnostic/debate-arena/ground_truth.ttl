@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/debate_arena#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# debate-arena — FRAMEWORK-AGNOSTIC ground-truth.
# A structured debate: a proponent and an opponent argue a motion in a
# round-robin, then a judge delivers a verdict. Tool-free (pure
# dialogue). Exercises: round-robin coordination, three agents with
# distinct goals, a turn-limit termination, an event-based termination
# composed in, a guardrail on the verdict, a verdict output schema, and
# a sequential workflow with a final EndStep.
# ============================================================

ex:DebateArenaSystem a agentoscin:AgenticSystem ;
    agentoscin:hasSourceFramework "Agnostic"^^xsd:string ;
    agentoscin:hasTitle "debate_arena"^^xsd:string ;
    agentoscin:containsAgent ex:Agent_proponent,
        ex:Agent_opponent,
        ex:Agent_judge ;
    agentoscin:containsTeam ex:Team_DebatePanel ;
    agentoscin:containsOrchestration ex:Orchestration_DebateFlow .

# ---------- language model ----------
ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

# ---------- proponent ----------
ex:Agent_proponent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "proponent"^^xsd:string ;
    agento:agentRole "Proponent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_proponent ;
    agento:hasAgentGoal ex:Goal_proponent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_proponent a agento:Goal ;
    agentoscin:hasDescription "Argue persuasively in favour of the motion, rebutting the opponent's points each round."^^xsd:string .

ex:AgentPrompt_proponent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptInstruction "Proponent: Argue persuasively in favour of the motion, rebutting the opponent each round."^^xsd:string ;
    agento:promptContext "A sharp debater who builds a tight case for the motion and never concedes a point without a counter."^^xsd:string .

# ---------- opponent ----------
ex:Agent_opponent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "opponent"^^xsd:string ;
    agento:agentRole "Opponent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_opponent ;
    agento:hasAgentGoal ex:Goal_opponent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Goal_opponent a agento:Goal ;
    agentoscin:hasDescription "Argue persuasively against the motion, exposing weaknesses in the proponent's case each round."^^xsd:string .

ex:AgentPrompt_opponent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptInstruction "Opponent: Argue persuasively against the motion, exposing weaknesses in the proponent's case."^^xsd:string ;
    agento:promptContext "A relentless sceptic who probes every assumption and turns the proponent's strongest claims against them."^^xsd:string .

# ---------- judge ----------
ex:Agent_judge a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled true ;
    agentoscin:employsReasoningPattern ex:Reasoning_judge ;
    agento:agentID "judge"^^xsd:string ;
    agento:agentRole "Judge"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_judge ;
    agento:hasAgentGoal ex:Goal_judge ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Reasoning_judge a agentoscin:ChainOfThought .

ex:Goal_judge a agento:Goal ;
    agentoscin:hasDescription "Weigh both sides impartially and declare a winner with a concise justification."^^xsd:string .

ex:AgentPrompt_judge a agento:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptInstruction "Judge: Weigh both sides impartially and declare a winner with a concise justification, ending with TERMINATE."^^xsd:string ;
    agento:promptContext "A fair, experienced adjudicator who scores arguments on evidence and logic rather than rhetoric, and explains the decision briefly."^^xsd:string .

# ---------- verdict output schema ----------
ex:Schema_Verdict a agentoscin:Schema ;
    agentoscin:hasTitle "Verdict"^^xsd:string ;
    agentoscin:hasSourceAttribute "output_pydantic"^^xsd:string ;
    agentoscin:hasSchemaDefinition "{\"properties\": {\"winner\": {\"type\": \"string\", \"enum\": [\"proponent\", \"opponent\"]}, \"justification\": {\"type\": \"string\"}}, \"required\": [\"winner\", \"justification\"], \"type\": \"object\"}" .

# ---------- guardrail on the verdict ----------
ex:Guardrail_decisive_verdict a agentoscin:Guardrail ;
    agentoscin:hasGuardrailType "LLMBased"^^xsd:string ;
    agentoscin:hasValidationLogic "The verdict must name exactly one winner and give a one-paragraph justification."^^xsd:string ;
    agentoscin:hasMaxRetries 1 .

# ---------- tasks ----------
ex:Task_open_debate a agento:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "An opening argument in favour of the motion."^^xsd:string ;
    agento:performedByAgent ex:Agent_proponent ;
    agento:taskPrompt ex:TaskPrompt_open_debate .

ex:TaskPrompt_open_debate a agento:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Open the debate on the motion: {motion}. Present your strongest opening argument in favour."^^xsd:string ;
    agento:promptOutputIndicator "An opening argument in favour of the motion."^^xsd:string .

ex:Task_rebut_debate a agento:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A rebuttal arguing against the motion."^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:dependsOn ex:Task_open_debate ;
    agento:performedByAgent ex:Agent_opponent ;
    agento:taskPrompt ex:TaskPrompt_rebut_debate .

ex:TaskPrompt_rebut_debate a agento:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Rebut the proponent's argument on the motion: {motion}. Expose its weaknesses."^^xsd:string ;
    agento:promptOutputIndicator "A rebuttal arguing against the motion."^^xsd:string .

ex:Task_judge_debate a agento:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A Verdict naming the winner with a justification."^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:dependsOn ex:Task_rebut_debate ;
    agentoscin:hasOutputSchema ex:Schema_Verdict ;
    agentoscin:hasGuardrail ex:Guardrail_decisive_verdict ;
    agento:performedByAgent ex:Agent_judge ;
    agento:taskPrompt ex:TaskPrompt_judge_debate .

ex:TaskPrompt_judge_debate a agento:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Weigh the proponent's and opponent's arguments on the motion: {motion}. Declare a winner and justify it."^^xsd:string ;
    agento:promptOutputIndicator "A Verdict naming the winner with a justification."^^xsd:string .

# ---------- workflow (rounds then verdict) ----------
ex:Step_open_debate a agento:StartStep ;
    agentoscin:hasTitle "open_debate"^^xsd:string ;
    agento:hasAssociatedTask ex:Task_open_debate ;
    agento:stepOrder 1 ;
    agento:nextStep ex:Step_rebut_debate .

ex:Step_rebut_debate a agento:WorkflowStep ;
    agentoscin:hasTitle "rebut_debate"^^xsd:string ;
    agento:hasAssociatedTask ex:Task_rebut_debate ;
    agento:stepOrder 2 ;
    agento:nextStep ex:Step_judge_debate .

ex:Step_judge_debate a agento:EndStep ;
    agentoscin:hasTitle "judge_debate"^^xsd:string ;
    agento:hasAssociatedTask ex:Task_judge_debate ;
    agento:stepOrder 3 .

ex:WorkflowPattern_DebatePanel a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:Step_open_debate,
        ex:Step_rebut_debate,
        ex:Step_judge_debate .

# ---------- composite termination (turn limit OR judge says TERMINATE) ----------
ex:TurnLimit_DebatePanel a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 7 .

ex:EventTermination_DebatePanel a agentoscin:EventBasedTermination ;
    agentoscin:hasTriggerExpression "TERMINATE"^^xsd:string .

ex:Termination_DebatePanel a agentoscin:CompositeTermination ;
    agentoscin:hasOperator "OR"^^xsd:string ;
    agentoscin:hasSubCondition ex:TurnLimit_DebatePanel,
        ex:EventTermination_DebatePanel .

# ---------- verbose config ----------
ex:Config_verbose_Team_DebatePanel a agento:Config ;
    agento:configKey "verbose"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

# ---------- team (round-robin) ----------
ex:Team_DebatePanel a agento:Team ;
    agentoscin:hasTitle "DebatePanel"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasTerminationCondition ex:Termination_DebatePanel ;
    agento:hasAgentMember ex:Agent_proponent,
        ex:Agent_opponent,
        ex:Agent_judge ;
    agento:hasSystemConfig ex:Config_verbose_Team_DebatePanel ;
    agento:hasWorkflowPattern ex:WorkflowPattern_DebatePanel .

# ---------- orchestration state schema (flat field -> type) ----------
ex:StateSchema_DebateFlow a agentoscin:Schema ;
    agentoscin:hasTitle "DebateState"^^xsd:string ;
    agentoscin:hasSourceAttribute "state_model"^^xsd:string ;
    agentoscin:hasSchemaDefinition "{\"motion\": \"str\", \"argument_for\": \"str\", \"argument_against\": \"str\", \"verdict\": \"str\"}" .

# ---------- orchestration ----------
ex:Orchestration_DebateFlow a agentoscin:Orchestration ;
    agentoscin:hasTitle "DebateFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasOutputSchema ex:StateSchema_DebateFlow ;
    agentoscin:orchestratesTeam ex:Team_DebatePanel ;
    agento:hasWorkflowPattern ex:WorkflowPattern_DebatePanel .
