@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/instance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/instance> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:ComprehensiveAutoGenTest a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_Admin,
        ex:Agent_Analyst,
        ex:Agent_Researcher ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow ;
    agentoscin:containsTeam ex:Team_GroupChat_0 ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "ComprehensiveAutoGenTest"^^xsd:string .

ex:Tool_calculate_tax a agentoscin:Tool ;
    agentoscin:hasDescription "Calculates standard tax rate."^^xsd:string ;
    agentoscin:hasImplementationReference "main.calculate_tax"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\": \"object\", \"properties\": {\"amount\": {\"type\": \"number\"}}, \"required\": [\"amount\"]}"^^xsd:string ;
    agentoscin:hasTitle "calculate_tax"^^xsd:string .

ex:Tool_db_lookup a agentoscin:Tool ;
    agentoscin:hasDescription "Looks up database records."^^xsd:string ;
    agentoscin:hasImplementationReference "main.db_lookup"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}"^^xsd:string ;
    agentoscin:hasTitle "db_lookup"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:ReAct a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Unspecified a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:agentID a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

