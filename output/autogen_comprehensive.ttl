ex:AgentPrompt_Admin a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptInstruction "Admin: A human admin overseeing the group."^^xsd:string .

ex:AgentPrompt_Analyst a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "Tax calculations are your specialty."^^xsd:string ;
    agentoscin:promptInstruction "Analyst: You analyze data."^^xsd:string .

ex:AgentPrompt_Researcher a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "Find relevant information."^^xsd:string ;
    agentoscin:promptInstruction "Researcher: You are a data researcher."^^xsd:string .

ex:FlowStep_initiate_chat_user_proxy_to_manager a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "initiate_chat_user_proxy_to_manager"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_initiate_chat_user_proxy_to_manager .

ex:Goal_Admin a agentoscin:Goal ;
    agentoscin:hasDescription "A human admin overseeing the group."^^xsd:string .

ex:Goal_Analyst a agentoscin:Goal ;
    agentoscin:hasDescription "You analyze data."^^xsd:string .

ex:Goal_Researcher a agentoscin:Goal ;
    agentoscin:hasDescription "You are a data researcher."^^xsd:string .

ex:HumanCheckpoint_Admin a agentoscin:HumanCheckpoint ;
    agentoscin:hasCheckpointType "Interaction"^^xsd:string ;
    agentoscin:isMandatory true .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .

ex:Team_GroupChat_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasAgentMember ex:Agent_Admin,
        ex:Agent_Analyst,
        ex:Agent_Researcher ;
    agentoscin:hasTerminationCondition ex:Termination_GroupChat_0,
        ex:TurnLimit_GroupChat_0 ;
    agentoscin:hasTitle "GroupChat"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_GroupChat_0 .

ex:Termination_GroupChat_0 a agentoscin:TaskCompletionTermination .

ex:TurnLimit_GroupChat_0 a agentoscin:TurnLimitTermination ;
    agentoscin:hasMaxTurns 15 .

ex:WorkflowPattern_GroupChat_0 a agentoscin:WorkflowPattern .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern .

agentoscin:EndStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Sequential a agentoscin:CoordinationPattern .

agentoscin:StartStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:Agent_Admin a agentoscin:LLMAgent ;
    agentoscin:agentID "Admin"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Admin ;
    agentoscin:agentRole "Admin"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Admin ;
    agentoscin:hasHumanCheckpoint ex:HumanCheckpoint_Admin ;
    agentoscin:hasReasoningEnabled false .

ex:Agent_Analyst a agentoscin:LLMAgent ;
    agentoscin:agentID "Analyst"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Analyst ;
    agentoscin:agentRole "Analyst"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Analyst ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4 .

ex:Agent_Researcher a agentoscin:LLMAgent ;
    agentoscin:agentID "Researcher"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Researcher ;
    agentoscin:agentRole "Researcher"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Researcher ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4 .

ex:LM_gpt_4 a agentoscin:LanguageModel ;
    agentoscin:hasTitle "gpt-4"^^xsd:string .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:EventBasedTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Instance a owl:Class ;
    rdfs:subClassOf agentoscin:Resource .

agentoscin:LanguageModel a owl:Class ;
    rdfs:subClassOf agentoscin:StatisticalModel .

agentoscin:Memory a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Plan a owl:Class .

agentoscin:Step a owl:Class .

agentoscin:System a owl:Class .

agentoscin:TaskCompletionTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPrompt a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Task ;
    rdfs:range agentoscin:Prompt ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasRelatedPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:toolUsage a owl:ObjectProperty ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Agent a owl:Class .

agentoscin:Capability a owl:Class .

agentoscin:CompositeTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Environment a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:KnowledgeBase a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:Objective a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Schema a owl:Class .

agentoscin:TurnLimitTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Config a owl:Class .

agentoscin:Context a owl:Class .

agentoscin:CoordinationPattern a owl:Class .

agentoscin:hasConfig a owl:ObjectProperty ;
    rdfs:domain agentoscin:Agent,
        agentoscin:AgenticSystem,
        agentoscin:Capability,
        agentoscin:Config,
        agentoscin:Context,
        agentoscin:CoordinationPattern,
        agentoscin:Guardrail,
        agentoscin:HumanCheckpoint,
        agentoscin:MemoryBinding,
        agentoscin:Orchestration,
        agentoscin:Plan,
        agentoscin:Prompt,
        agentoscin:ReasoningPattern,
        agentoscin:Resource,
        agentoscin:Schema,
        agentoscin:Step,
        agentoscin:System,
        agentoscin:Task,
        agentoscin:TerminationCondition,
        agentoscin:Tool ;
    rdfs:range agentoscin:Config ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Goal a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Guardrail a owl:Class .

agentoscin:Orchestration a owl:Class ;
    rdfs:subClassOf agentoscin:Team .

agentoscin:HumanCheckpoint a owl:Class .

agentoscin:MemoryBinding a owl:Class .

agentoscin:WorkflowPattern a owl:Class ;
    rdfs:subClassOf agentoscin:Plan .

agentoscin:AgenticSystem a owl:Class .

agentoscin:ReasoningPattern a owl:Class .

agentoscin:Resource a owl:Class .

agentoscin:TerminationCondition a owl:Class .

agentoscin:WorkflowStep a owl:Class ;
    rdfs:subClassOf agentoscin:Step .

agentoscin:Tool a owl:Class .

agentoscin:Prompt a owl:Class .

agentoscin:Team a owl:Class ;
    rdfs:subClassOf agentoscin:System .

agentoscin:Task a owl:Class .

agentoscin:LLMAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

[] a owl:AllDisjointClasses ;
    owl:members ( agentoscin:CompositeTermination agentoscin:EventBasedTermination agentoscin:RoutingTermination agentoscin:TaskCompletionTermination agentoscin:TurnLimitTermination ) .

