@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/literature_review#> .
@prefix ns1: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/dcterms:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:LiteratureReviewSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_Arxiv_Search_Agent,
        ex:Agent_Google_Search_Agent,
        ex:Agent_Report_Agent ;
    ns1:title "LiteratureReviewSystem"^^xsd:string ;
    agentoscin:hasSourceFramework "AutoGen"^^xsd:string .

ex:AgentPrompt_Arxiv_Search_Agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a helpful AI assistant. Solve tasks using your tools. Specifically, you can take into consideration the user's request and craft a search query that is most likely to return relevant academi papers."^^xsd:string ;
    agentoscin:promptInstruction "Arxiv_Search_Agent"^^xsd:string .

ex:AgentPrompt_Google_Search_Agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a helpful AI assistant. Solve tasks using your tools."^^xsd:string ;
    agentoscin:promptInstruction "Google_Search_Agent"^^xsd:string .

ex:AgentPrompt_Report_Agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a helpful assistant. Your task is to synthesize data extracted into a high quality literature review including CORRECT references. You MUST write a final report that is formatted as a literature review with CORRECT references.  Your response should end with the word 'TERMINATE'"^^xsd:string ;
    agentoscin:promptInstruction "Report_Agent"^^xsd:string .

ex:Agent_Arxiv_Search_Agent a agentoscin:LLMAgent ;
    agentoscin:agentID "Arxiv_Search_Agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Arxiv_Search_Agent ;
    agentoscin:agentRole "Arxiv_Search_Agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false .

ex:Agent_Google_Search_Agent a agentoscin:LLMAgent ;
    agentoscin:agentID "Google_Search_Agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Google_Search_Agent ;
    agentoscin:agentRole "Google_Search_Agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false .

ex:Agent_Report_Agent a agentoscin:LLMAgent ;
    agentoscin:agentID "Report_Agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Report_Agent ;
    agentoscin:agentRole "Report_Agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false .

