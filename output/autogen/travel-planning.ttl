ex:AgentPrompt_language_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "If the plan already includes language tips, you can mention that the plan is satisfactory, with rationale."^^xsd:string ;
    agentoscin:promptInstruction "You are a helpful assistant that can review travel plans, providing feedback on important/critical tips about how best to address language or communication challenges for the given destination."^^xsd:string .

ex:AgentPrompt_local_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptInstruction "You are a helpful assistant that can suggest authentic and interesting local activities or places to visit for a user and can utilize any context information provided."^^xsd:string .

ex:AgentPrompt_planner_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptInstruction "You are a helpful assistant that can suggest a travel plan for a user based on their request."^^xsd:string .

ex:AgentPrompt_travel_summary_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "You must ensure that the final plan is integrated and complete. YOUR FINAL RESPONSE MUST BE THE COMPLETE PLAN. When the plan is complete and all perspectives are integrated, you can respond with TERMINATE."^^xsd:string ;
    agentoscin:promptInstruction "You are a helpful assistant that can take in all of the suggestions and advice from the other agents and provide a detailed final travel plan."^^xsd:string .

ex:EventTermination_SelectorGroupChat_0_0 a agentoscin:EventBasedTermination ;
    agentoscin:hasTriggerExpression "TERMINATE"^^xsd:string .

ex:FlowStep_run_group_chat a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_group_chat"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_run_group_chat .

ex:Goal_language_agent a agentoscin:Goal ;
    agentoscin:hasDescription "You are a helpful assistant that can review travel plans, providing feedback on important/critical tips about how best to address language or communication challenges for the given destination."^^xsd:string .

ex:Goal_local_agent a agentoscin:Goal ;
    agentoscin:hasDescription "You are a helpful assistant that can suggest authentic and interesting local activities or places to visit for a user and can utilize any context information provided."^^xsd:string .

ex:Goal_planner_agent a agentoscin:Goal ;
    agentoscin:hasDescription "You are a helpful assistant that can suggest a travel plan for a user based on their request."^^xsd:string .

ex:Goal_travel_summary_agent a agentoscin:Goal ;
    agentoscin:hasDescription "You are a helpful assistant that can take in all of the suggestions and advice from the other agents and provide a detailed final travel plan."^^xsd:string .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .

ex:OrchestratorPrompt_language_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agentoscin:promptInstruction "A helpful assistant that can provide language tips for a given destination."^^xsd:string .

ex:OrchestratorPrompt_local_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agentoscin:promptInstruction "A local assistant that can suggest local activities or places to visit."^^xsd:string .

ex:OrchestratorPrompt_planner_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agentoscin:promptInstruction "A helpful assistant that can plan trips."^^xsd:string .

ex:OrchestratorPrompt_travel_summary_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "OrchestratorDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "description"^^xsd:string ;
    agentoscin:promptInstruction "A not very helpful assistant that can summarize the travel plan."^^xsd:string .

ex:TaskPrompt_autogen_task_0 a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Plan a 10 day trip to Luxemburg."^^xsd:string .

ex:Team_SelectorGroupChat_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:SelectorBased ;
    agentoscin:hasAgentMember ex:Agent_language_agent,
        ex:Agent_local_agent,
        ex:Agent_planner_agent,
        ex:Agent_travel_summary_agent ;
    agentoscin:hasTerminationCondition ex:EventTermination_SelectorGroupChat_0_0 ;
    agentoscin:hasTitle "SelectorGroupChat"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_SelectorGroupChat_0 .

ex:WorkflowPattern_SelectorGroupChat_0 a agentoscin:WorkflowPattern .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:EndStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:SelectorBased a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:StartStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:TaskCompletionTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:Agent_language_agent a agentoscin:LLMAgent ;
    agentoscin:agentID "language_agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_language_agent,
        ex:OrchestratorPrompt_language_agent ;
    agentoscin:agentRole "language_agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_language_agent ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_local_agent a agentoscin:LLMAgent ;
    agentoscin:agentID "local_agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_local_agent,
        ex:OrchestratorPrompt_local_agent ;
    agentoscin:agentRole "local_agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_local_agent ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_planner_agent a agentoscin:LLMAgent ;
    agentoscin:agentID "planner_agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_planner_agent,
        ex:OrchestratorPrompt_planner_agent ;
    agentoscin:agentRole "planner_agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_planner_agent ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_travel_summary_agent a agentoscin:LLMAgent ;
    agentoscin:agentID "travel_summary_agent"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_travel_summary_agent,
        ex:OrchestratorPrompt_travel_summary_agent ;
    agentoscin:agentRole "travel_summary_agent"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_travel_summary_agent ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

agentoscin:Instance a owl:Class ;
    rdfs:subClassOf agentoscin:Resource .

agentoscin:LanguageModel a owl:Class ;
    rdfs:subClassOf agentoscin:StatisticalModel .

agentoscin:Memory a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Plan a owl:Class .

agentoscin:Step a owl:Class .

agentoscin:System a owl:Class .

agentoscin:TurnLimitTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPrompt a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Task ;
    rdfs:range agentoscin:Prompt ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasRelatedPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:toolUsage a owl:ObjectProperty ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Capability a owl:Class .

agentoscin:CompositeTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Environment a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:EventBasedTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:KnowledgeBase a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:Objective a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Schema a owl:Class .

ex:LM_gpt_4o a agentoscin:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

agentoscin:Agent a owl:Class .

agentoscin:Config a owl:Class .

agentoscin:Context a owl:Class .

agentoscin:hasConfig a owl:ObjectProperty ;
    rdfs:domain agentoscin:Agent,
        agentoscin:AgenticSystem,
        agentoscin:Capability,
        agentoscin:Config,
        agentoscin:Context,
        agentoscin:CoordinationPattern,
        agentoscin:Guardrail,
        agentoscin:HumanCheckpoint,
        agentoscin:MemoryBinding,
        agentoscin:Orchestration,
        agentoscin:Plan,
        agentoscin:Prompt,
        agentoscin:ReasoningPattern,
        agentoscin:Resource,
        agentoscin:Schema,
        agentoscin:Step,
        agentoscin:System,
        agentoscin:Task,
        agentoscin:TerminationCondition,
        agentoscin:Tool ;
    rdfs:range agentoscin:Config ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Guardrail a owl:Class .

agentoscin:HumanCheckpoint a owl:Class .

agentoscin:Orchestration a owl:Class ;
    rdfs:subClassOf agentoscin:Team .

agentoscin:Goal a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:WorkflowPattern a owl:Class ;
    rdfs:subClassOf agentoscin:Plan .

agentoscin:AgenticSystem a owl:Class .

agentoscin:MemoryBinding a owl:Class .

agentoscin:ReasoningPattern a owl:Class .

agentoscin:Resource a owl:Class .

agentoscin:TerminationCondition a owl:Class .

agentoscin:Tool a owl:Class .

agentoscin:CoordinationPattern a owl:Class .

agentoscin:WorkflowStep a owl:Class ;
    rdfs:subClassOf agentoscin:Step .

agentoscin:Team a owl:Class ;
    rdfs:subClassOf agentoscin:System .

agentoscin:Prompt a owl:Class .

agentoscin:Task a owl:Class .

agentoscin:LLMAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

[] a owl:AllDisjointClasses ;
    owl:members ( agentoscin:CompositeTermination agentoscin:EventBasedTermination agentoscin:RoutingTermination agentoscin:TaskCompletionTermination agentoscin:TurnLimitTermination ) .

