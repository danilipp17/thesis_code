    rdfs:domain agentoscin:HumanAgent ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:interactsWith a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:isMandatory a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:boolean ;
