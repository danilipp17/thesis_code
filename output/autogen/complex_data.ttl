@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/complex_data#> .
@prefix ns1: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/dcterms:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ComplexDataSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_Data_Analyst,
        ex:Agent_Data_Engineer,
        ex:Agent_Human_Admin ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenConversation ;
    agentoscin:containsTeam ex:Team_GroupChat_0 ;
    ns1:title "ComplexDataSystem"^^xsd:string ;
    agentoscin:hasSourceFramework "AutoGen"^^xsd:string .

ex:Tool_create_bar_chart a agentoscin:Tool ;
    ns1:description "Generate a data visualization chart."^^xsd:string ;
    ns1:title "create_bar_chart"^^xsd:string ;
    agentoscin:hasImplementationReference "main.create_bar_chart"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string .

ex:Tool_execute_sql_query a agentoscin:Tool ;
    ns1:description "Execute a read-only SQL query on the company database."^^xsd:string ;
    ns1:title "execute_sql_query"^^xsd:string ;
    agentoscin:hasImplementationReference "main.execute_sql_query"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string .

ex:AgentPrompt_Data_Analyst a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You analyze extracted data and generate visual charts."^^xsd:string ;
    agentoscin:promptInstruction "Data_Analyst"^^xsd:string .

ex:AgentPrompt_Data_Engineer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a senior data engineer. You write SQL queries to extract data."^^xsd:string ;
    agentoscin:promptInstruction "Data_Engineer"^^xsd:string .

ex:AgentPrompt_Human_Admin a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are the database admin. You review findings and approve final reports."^^xsd:string ;
    agentoscin:promptInstruction "Human_Admin: Execute code and provide human feedback"^^xsd:string .

ex:Agent_Data_Analyst a agentoscin:LLMAgent ;
    agentoscin:agentID "Data_Analyst"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Data_Analyst ;
    agentoscin:agentRole "Data_Analyst"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false .

ex:Agent_Data_Engineer a agentoscin:LLMAgent ;
    agentoscin:agentID "Data_Engineer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Data_Engineer ;
    agentoscin:agentRole "Data_Engineer"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false .

ex:Agent_Human_Admin a agentoscin:LLMAgent ;
    agentoscin:agentID "Human_Admin"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Human_Admin ;
    agentoscin:agentRole "Human_Admin"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Human_Admin ;
    agentoscin:hasReasoningEnabled false .

ex:FlowStep_initiate_chat_human_admin a agentoscin:StartStep ;
    ns1:title "initiate_chat_human_admin"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenConversation a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_initiate_chat_human_admin .

ex:Goal_Human_Admin a agentoscin:Goal ;
    ns1:description "Execute code and provide human feedback"^^xsd:string .

ex:Orchestration_AutoGenConversation a agentoscin:Orchestration ;
    ns1:title "AutoGenConversation"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenConversation .

ex:Team_GroupChat_0 a agentoscin:Team ;
    ns1:title "GroupChat"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Sequentiel ;
    agentoscin:hasTerminationCondition ex:Termination_GroupChat_0 ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_GroupChat_0 .

ex:Termination_GroupChat_0 a agentoscin:TaskCompletionTermination .

ex:WorkflowPattern_GroupChat_0 a agentoscin:WorkflowPattern .

agentoscin:Custom a agentoscin:CoordinationPattern .

agentoscin:Sequentiel a agentoscin:CoordinationPattern .

