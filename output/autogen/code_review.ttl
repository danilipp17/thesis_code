@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/code_review#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/code_review> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:CodeReviewSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_Code_Reviewer,
        ex:Agent_Review_Summarizer,
        ex:Agent_Security_Auditor ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenV04Flow ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "CodeReviewSystem"^^xsd:string .

ex:Tool_code_analyzer a agentoscin:Tool ;
    agentoscin:hasDescription """Performs static analysis on source code.
Checks for syntax errors, undefined variables, unused imports,
and common anti-patterns."""^^xsd:string ;
    agentoscin:hasImplementationReference "tools.code_analyzer"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "code_analyzer"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
