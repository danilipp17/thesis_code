ex:Agent_Code_Reviewer a agentoscin:LLMAgent ;
    agentoscin:agentID "Code_Reviewer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Code_Reviewer ;
    agentoscin:agentRole "Code_Reviewer"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_code_analyzer_tool ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_Review_Summarizer a agentoscin:LLMAgent ;
    agentoscin:agentID "Review_Summarizer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Review_Summarizer ;
    agentoscin:agentRole "Review_Summarizer"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_Security_Auditor a agentoscin:LLMAgent ;
    agentoscin:agentID "Security_Auditor"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Security_Auditor ;
    agentoscin:agentRole "Security_Auditor"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_code_analyzer_tool ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Tool_code_analyzer_tool a agentoscin:Tool ;
    agentoscin:hasReference "external:code_analyzer_tool"^^xsd:string ;
    agentoscin:hasTitle "code_analyzer_tool"^^xsd:string .

