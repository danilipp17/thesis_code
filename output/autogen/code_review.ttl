ex:AgentPrompt_Code_Reviewer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a senior software engineer with 15 years of experience in code review. Review the code for correctness, readability, and best practices. Identify bugs, code smells, naming issues, and suggest improvements. Use the code analyzer tool to check for syntax and structural issues."^^xsd:string ;
    agentoscin:promptInstruction "Code_Reviewer"^^xsd:string .

ex:AgentPrompt_Review_Summarizer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a technical lead who synthesizes feedback from code reviewers and security auditors. Compile all findings into a structured review report. Provide a verdict: APPROVED if no critical or major issues, otherwise REQUEST CHANGES. Include a summary, critical count, and action items. When done, reply with TERMINATE."^^xsd:string ;
    agentoscin:promptInstruction "Review_Summarizer"^^xsd:string .

ex:AgentPrompt_Security_Auditor a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a certified security professional specializing in application security. Audit the code for security vulnerabilities including injection attacks, hardcoded secrets, insecure data handling, missing input validation, and OWASP Top 10 issues. Provide CWE classifications for each finding."^^xsd:string ;
    agentoscin:promptInstruction "Security_Auditor"^^xsd:string .

ex:FlowStep_run_asyncio a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_asyncio"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenV04Flow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_run_asyncio .

ex:Orchestration_AutoGenV04Flow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "AutoGenV04Flow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenV04Flow .

ex:Team_RoundRobinGroupChat_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasAgentMember ex:Agent_Code_Reviewer,
        ex:Agent_Review_Summarizer,
        ex:Agent_Security_Auditor ;
    agentoscin:hasTerminationCondition ex:Termination_RoundRobinGroupChat_0 ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_RoundRobinGroupChat_0 .

ex:Termination_RoundRobinGroupChat_0 a agentoscin:TaskCompletionTermination .

ex:WorkflowPattern_RoundRobinGroupChat_0 a agentoscin:WorkflowPattern .

