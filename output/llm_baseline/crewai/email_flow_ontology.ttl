# Issues / Assumptions:
# - The current ontology does not accommodate specifying complex behaviors for agents or tasks.
# - YAML configurations and semantic meanings of tasks and agents cannot be fully captured.
# - Specific prompt configurations are not directly modeled as entities in the ontology.
# - No mechanism to handle the 'backstory' aspect of agents in the current ontology.
# - The toolbox, including the details of tools used, may not have a specific class.

@prefix : <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Individuals
#################################################################

### Agents
:EmailFilterAgent rdf:type :LLMAgent ;
    :agentID "email_filter_agent" ;
    :agentRole "Senior Email Analyst" ;
    :agentType "Filter" ;
    :hasAgentGoal [
        rdf:type :Goal ;
        :hasDescription "Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."
    ] ;
    :hasPrompt [
        rdf:type :Prompt ;
        :promptInstruction "With years of experience in email management and communication triage, you are adept at quickly identifying important emails that require immediate action from those that can be archived or ignored."
    ] ;
    :employsReasoningPattern :ChainOfThought .

:EmailActionAgent rdf:type :LLMAgent ;
    :agentID "email_action_agent" ;
    :agentRole "Email Action Specialist" ;
    :agentType "Action" ;
    :hasAgentGoal [
        rdf:type :Goal ;
        :hasDescription "For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."
    ] ;
    :hasPrompt [
        rdf:type :Prompt ;
        :promptInstruction "As a seasoned executive assistant, you excel at understanding the context of business communications and determining the appropriate response and actions required for each email."
    ] ;
    :employsReasoningPattern :ReAct .

:EmailResponseWriter rdf:type :LLMAgent ;
    :agentID "email_response_writer" ;
    :agentRole "Email Response Writer" ;
    :agentType "Response" ;
    :hasAgentGoal [
        rdf:type :Goal ;
        :hasDescription "Draft professional and appropriate responses to action-required emails based on the determined actions and context."
    ] ;
    :hasPrompt [
        rdf:type :Prompt ;
        :promptInstruction "You are a skilled communicator with a talent for crafting clear, professional, and context-appropriate email responses. You understand the nuances of business communication and can adapt your tone and style to match the situation."
    ] ;
    :employsReasoningPattern :TreeOfThoughts .

### Tasks
:FilterEmailsTask rdf:type :Task ;
    :hasDescription "Analyze the list of emails provided and categorize each email as either 'action_required' or 'no_action_needed'. Use your expertise to filter out newsletters, promotional content, and spam. Here are the emails: {emails}" ;
    :hasExpectedOutput "A categorized list of emails with their classification as either 'action_required' or 'no_action_needed', along with a brief reason for each classification." ;
    :performedBy :EmailFilterAgent .

:ActionRequiredEmailsTask rdf:type :Task ;
    :hasDescription "For each email classified as 'action_required', analyze the content and determine the specific actions that need to be taken. Consider the urgency, context, and any deadlines mentioned in the emails." ;
    :hasExpectedOutput "A detailed action plan for each action-required email, including the specific steps to take, priority level, and any relevant deadlines." ;
    :performedBy :EmailActionAgent .

:DraftResponsesTask rdf:type :Task ;
    :hasDescription "Based on the action plans provided, draft professional email responses for each action-required email. Ensure the responses are clear, concise, and appropriate for the context." ;
    :hasExpectedOutput "A set of draft email responses ready to be reviewed and sent, each properly formatted with subject line, greeting, body, and closing." ;
    :performedBy :EmailResponseWriter .

### Workflows and System
:EmailFilterCrew rdf:type :AgenticSystem ;
    :containsAgent :EmailFilterAgent , :EmailActionAgent , :EmailResponseWriter ;
    :containsOrchestration [
        rdf:type :Orchestration ;
        :hasWorkflowPattern [
            rdf:type :WorkflowPattern ;
            :hasWorkflowStep :FilterEmailsTask , :ActionRequiredEmailsTask , :DraftResponsesTask ;
            :hasSubPattern [
                rdf:type :WorkflowPattern ;
                :nextPattern :FilterEmailsTask ;
                :nextPattern :ActionRequiredEmailsTask ;
                :nextPattern :DraftResponsesTask
            ]
        ] ;
        :orchestratesTeam :EmailResponseWriter
    ] .

### Tools
:SerperDevTool rdf:type :Tool ;
    :hasCapability :SearchEmails ;
    :hasDescription "Search tool for filtering emails."

:GmailGetThreadTool rdf:type :Tool ;
    :hasCapability :RetrieveEmails ;
    :hasDescription "Tool for retrieving Gmail threads."

:TavilySearchResultsTool rdf:type :Tool ;
    :hasCapability :Search ;
    :hasDescription "Search tool for Tavily results."

:CreateDraftTool rdf:type :Tool ;
    :hasCapability :CreateDraft ;
    :hasDescription "Tool for creating email drafts using Gmail API." .

### Connections between tasks and agents
:FilterEmailsTask :performedByAgent :EmailFilterAgent ;
    :taskPrompt :SerperDevTool .

:ActionRequiredEmailsTask :performedByAgent :EmailActionAgent ;
    :taskPrompt :GmailGetThreadTool .

:DraftResponsesTask :performedByAgent :EmailResponseWriter ;
    :taskPrompt :CreateDraftTool .

### Connections between agents and their tools
:EmailFilterAgent :agentToolUsage :SerperDevTool .

:EmailActionAgent :agentToolUsage :GmailGetThreadTool , :TavilySearchResultsTool .

:EmailResponseWriter :agentToolUsage :GmailGetThreadTool , :TavilySearchResultsTool , :CreateDraftTool .