ex:AgentPrompt_Code_Reviewer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "Review the code for correctness, readability, and best practices. Identify bugs, code smells, naming issues, and suggest improvements. Use the code analyzer tool to check for syntax and structural issues."^^xsd:string ;
    agentoscin:promptInstruction "You are a senior software engineer with 15 years of experience in code review."^^xsd:string .

ex:AgentPrompt_Review_Summarizer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "Compile all findings into a structured review report. Provide a verdict: APPROVED if no critical or major issues, otherwise REQUEST CHANGES. Include a summary, critical count, and action items. When done, reply with TERMINATE."^^xsd:string ;
    agentoscin:promptInstruction "You are a technical lead who synthesizes feedback from code reviewers and security auditors."^^xsd:string .

ex:AgentPrompt_Security_Auditor a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "Audit the code for security vulnerabilities including injection attacks, hardcoded secrets, insecure data handling, missing input validation, and OWASP Top 10 issues. Provide CWE classifications for each finding."^^xsd:string ;
    agentoscin:promptInstruction "You are a certified security professional specializing in application security."^^xsd:string .

ex:FlowStep_run_asyncio a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_asyncio"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_run_team a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_run_asyncio,
        ex:FlowStep_run_team .

ex:Goal_Code_Reviewer a agentoscin:Goal ;
    agentoscin:hasDescription "You are a senior software engineer with 15 years of experience in code review."^^xsd:string .

ex:Goal_Review_Summarizer a agentoscin:Goal ;
    agentoscin:hasDescription "You are a technical lead who synthesizes feedback from code reviewers and security auditors."^^xsd:string .

ex:Goal_Security_Auditor a agentoscin:Goal ;
    agentoscin:hasDescription "You are a certified security professional specializing in application security."^^xsd:string .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .

ex:TaskPrompt_autogen_task_0 a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "f'Review the following code for quality and security:\\n{code_to_review}'"^^xsd:string .

ex:Team_RoundRobinGroupChat_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasAgentMember ex:Agent_Code_Reviewer,
        ex:Agent_Review_Summarizer,
        ex:Agent_Security_Auditor ;
    agentoscin:hasTerminationCondition ex:Termination_RoundRobinGroupChat_0 ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_RoundRobinGroupChat_0 .

ex:Termination_RoundRobinGroupChat_0 a agentoscin:TaskCompletionTermination .

ex:WorkflowPattern_RoundRobinGroupChat_0 a agentoscin:WorkflowPattern .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoundRobin a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:Agent_Code_Reviewer a agentoscin:LLMAgent ;
    agentoscin:agentID "Code_Reviewer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Code_Reviewer ;
    agentoscin:agentRole "Code_Reviewer"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_code_analyzer ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Code_Reviewer ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_Review_Summarizer a agentoscin:LLMAgent ;
    agentoscin:agentID "Review_Summarizer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Review_Summarizer ;
    agentoscin:agentRole "Review_Summarizer"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Review_Summarizer ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_Security_Auditor a agentoscin:LLMAgent ;
    agentoscin:agentID "Security_Auditor"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Security_Auditor ;
    agentoscin:agentRole "Security_Auditor"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_code_analyzer ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Security_Auditor ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Tool_code_analyzer a agentoscin:Tool ;
    agentoscin:hasDescription "Performs static analysis on source code. Checks for syntax errors, undefined variables, unused imports, and common anti-patterns."^^xsd:string ;
    agentoscin:hasImplementationReference "tools.code_analyzer"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\"}, \"language\": {\"type\": \"string\"}}, \"required\": [\"code\", \"language\"]}"^^xsd:string ;
    agentoscin:hasTitle "code_analyzer"^^xsd:string .

agentoscin:EndStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:EventBasedTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Instance a owl:Class ;
    rdfs:subClassOf agentoscin:Resource .

agentoscin:LanguageModel a owl:Class ;
    rdfs:subClassOf agentoscin:StatisticalModel .

agentoscin:Memory a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Plan a owl:Class .

agentoscin:StartStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Step a owl:Class .

agentoscin:System a owl:Class .

agentoscin:TaskCompletionTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:TurnLimitTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPrompt a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Task ;
    rdfs:range agentoscin:Prompt ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasRelatedPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:toolUsage a owl:ObjectProperty ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:LM_gpt_4o a agentoscin:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

agentoscin:Capability a owl:Class .

agentoscin:CompositeTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Environment a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:KnowledgeBase a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:Objective a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Schema a owl:Class .

agentoscin:Agent a owl:Class .

agentoscin:Config a owl:Class .

agentoscin:Context a owl:Class .

agentoscin:hasConfig a owl:ObjectProperty ;
    rdfs:domain agentoscin:Agent,
        agentoscin:AgenticSystem,
        agentoscin:Capability,
        agentoscin:Config,
        agentoscin:Context,
        agentoscin:CoordinationPattern,
        agentoscin:Guardrail,
        agentoscin:HumanCheckpoint,
        agentoscin:MemoryBinding,
        agentoscin:Orchestration,
        agentoscin:Plan,
        agentoscin:Prompt,
        agentoscin:ReasoningPattern,
        agentoscin:Resource,
        agentoscin:Schema,
        agentoscin:Step,
        agentoscin:System,
        agentoscin:Task,
        agentoscin:TerminationCondition,
        agentoscin:Tool ;
    rdfs:range agentoscin:Config ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Goal a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Guardrail a owl:Class .

agentoscin:HumanCheckpoint a owl:Class .

agentoscin:Orchestration a owl:Class ;
    rdfs:subClassOf agentoscin:Team .

agentoscin:WorkflowPattern a owl:Class ;
    rdfs:subClassOf agentoscin:Plan .

agentoscin:AgenticSystem a owl:Class .

agentoscin:MemoryBinding a owl:Class .

agentoscin:ReasoningPattern a owl:Class .

agentoscin:Resource a owl:Class .

agentoscin:TerminationCondition a owl:Class .

agentoscin:Tool a owl:Class .

agentoscin:CoordinationPattern a owl:Class .

agentoscin:Team a owl:Class ;
    rdfs:subClassOf agentoscin:System .

agentoscin:Prompt a owl:Class .

agentoscin:WorkflowStep a owl:Class ;
    rdfs:subClassOf agentoscin:Step .

agentoscin:Task a owl:Class .

agentoscin:LLMAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

[] a owl:AllDisjointClasses ;
    owl:members ( agentoscin:CompositeTermination agentoscin:EventBasedTermination agentoscin:RoutingTermination agentoscin:TaskCompletionTermination agentoscin:TurnLimitTermination ) .

