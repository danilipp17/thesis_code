    agentoscin:agentToolUsage ex:Tool_add,
        ex:Tool_multiply,
        ex:Tool_subtract ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false .

