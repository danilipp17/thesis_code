@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/self_eval_loop_flow#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/self_eval_loop_flow> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:self_eval_loop_flow_roundtrip a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_shakespearean_bard,
        ex:Agent_x_post_verifier ;
    agentoscin:containsOrchestration ex:Orchestration_ShakespeareXPostFlow ;
    agentoscin:containsTeam ex:Team_ShakespeareanXPostCrew,
        ex:Team_XPostReviewCrew ;
    agentoscin:hasSourceFramework "CrewAI"^^xsd:string ;
    agentoscin:hasTitle "self_eval_loop_flow_roundtrip"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Hierarchical a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Network a agentoscin:CoordinationPattern,
