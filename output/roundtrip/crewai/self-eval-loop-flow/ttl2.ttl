ex:AgentPrompt_shakespearean_bard a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "Thou art a witty bard, renowned for turning the mundane into the magnificent with thy playful jests and biting sarcasm. Armed with wit and wisdom, thou dost revel in the creation of humorous quips most pleasing to the ear."^^xsd:string ;
    agentoscin:promptInstruction "Shakespearean Bard: Craft sarcastic and playful hot takes in the style of Shakespeare. Ensure that all responses fit within 280 characters and contain no emojis."^^xsd:string .

ex:AgentPrompt_x_post_verifier a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a careful reviewer, skilled at understanding the core message of a post.  Your job is to maintain the clarity and brevity of the post by ensuring it contains no emojis,  unnecessary commentary, or excessive verbosity."^^xsd:string ;
    agentoscin:promptInstruction "X Post Verifier: Ensure that any X post meets the strict guidelines: it must be under 280 characters, contain no emojis, and be free of additional commentary."^^xsd:string .

ex:Config_verbose_Team_ShakespeareanXPostCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Team_XPostReviewCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:CrewStep_ShakespeareanXPostCrew_write_x_post a agentoscin:EndStep,
        agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_write_x_post ;
    agentoscin:hasTitle "write_x_post"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:CrewStep_XPostReviewCrew_verify_x_post a agentoscin:EndStep,
        agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_verify_x_post ;
    agentoscin:hasTitle "verify_x_post"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowStep_evaluate_x_post a agentoscin:ConditionalStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasRoutingLogic """        if self.state.retry_count > 3:
            return "max_retry_exceeded"
        
        result = XPostReviewCrew().crew().kickoff(inputs={"x_post": self.state.x_post})
        self.state.valid = result["valid"]
        self.state.feedback = result["feedback"]
        
        print("valid", self.state.valid)
        print("feedback", self.state.feedback)
        self.state.retry_count += 1
        
        if self.state.valid:
            return "complete"
        
        return "retry\""""^^xsd:string ;
    agentoscin:hasTitle "evaluate_x_post"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_generate_shakespeare_x_post,
        ex:FlowStep_max_retry_exceeded_exit,
        ex:FlowStep_save_result ;
    agentoscin:stepOrder 2 .

ex:FlowWorkflowPattern_ShakespeareXPostFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_evaluate_x_post,
        ex:FlowStep_generate_shakespeare_x_post,
        ex:FlowStep_max_retry_exceeded_exit,
        ex:FlowStep_save_result .

ex:Goal_shakespearean_bard a agentoscin:Goal ;
    agentoscin:hasDescription "Craft sarcastic and playful hot takes in the style of Shakespeare. Ensure that all responses fit within 280 characters and contain no emojis."^^xsd:string .

ex:Goal_x_post_verifier a agentoscin:Goal ;
    agentoscin:hasDescription "Ensure that any X post meets the strict guidelines: it must be under 280 characters, contain no emojis, and be free of additional commentary."^^xsd:string .

ex:Orchestration_ShakespeareXPostFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasOutputSchema ex:StateSchema_ShakespeareXPostFlow ;
    agentoscin:hasTitle "ShakespeareXPostFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_ShakespeareXPostFlow ;
    agentoscin:orchestratesTeam ex:Team_XPostReviewCrew .

ex:Schema_XPostVerification a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"valid\":{\"type\":\"boolean\"},\"feedback\":{\"type\":\"string\"}},\"required\":[\"valid\",\"feedback\"]}"^^xsd:string .

ex:StateSchema_ShakespeareXPostFlow a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"id\": \"str\", \"x_post\": \"str\", \"feedback\": \"Optional[str]\", \"valid\": \"bool\", \"retry_count\": \"int\"}"^^xsd:string ;
    agentoscin:hasTitle "ShakespeareXPostFlowState"^^xsd:string .

ex:TaskPrompt_verify_x_post a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction """Verify that the given X post meets the following criteria: - It is between 200 and 280 characters inclusive. - It contains no emojis. - It contains only the post itself, without additional commentary.
The post should follow the 1-3-1 rule: - 1 bold statement to hook the reader - 3 lines of supporting information - 1 sentence to summarize the post
Additionally, if you believe there are any issues with the post  or ways it could be improved, such as the structure of the post, rhythm, word choice, please provide feedback.
If any of the criteria are not met, the post is considered invalid. Provide actionable changes about what is wrong and what actions need to be taken to fix the post.
Your final response must include: - Valid: True/False - Feedback: Provide commentary if the post fails any of the criteria.
X Post to Verify:  {x_post}"""^^xsd:string ;
    agentoscin:promptOutputIndicator "Pass: True/False Feedback: Commentary here if failed."^^xsd:string .

ex:TaskPrompt_write_x_post a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction """Given the topic '{topic}', compose a humorous hot take in the style of Shakespeare.  The tone should be sarcastic and playful. The final short form social media post  must be over 200 characters and not exceed 280 characters, and emojis are strictly forbidden.
Please incorporate the following feedback if present:  {feedback}"""^^xsd:string ;
    agentoscin:promptOutputIndicator "A witty, Shakespearean hot take between 200 and 280 characters [Inclusive]."^^xsd:string .

ex:Task_verify_x_post a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "Pass: True/False Feedback: Commentary here if failed."^^xsd:string ;
    agentoscin:hasOutputSchema ex:Schema_XPostVerification ;
    agentoscin:performedByAgent ex:Agent_x_post_verifier ;
    agentoscin:taskPrompt ex:TaskPrompt_verify_x_post .

ex:Task_write_x_post a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A witty, Shakespearean hot take between 200 and 280 characters [Inclusive]."^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_shakespearean_bard ;
    agentoscin:taskPrompt ex:TaskPrompt_write_x_post .

ex:Team_ShakespeareanXPostCrew a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasAgentMember ex:Agent_shakespearean_bard ;
    agentoscin:hasSystemConfig ex:Config_verbose_Team_ShakespeareanXPostCrew ;
    agentoscin:hasTerminationCondition ex:Termination_ShakespeareanXPostCrew ;
    agentoscin:hasTitle "ShakespeareanXPostCrew"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_ShakespeareanXPostCrew .

ex:Termination_ShakespeareanXPostCrew a agentoscin:TaskCompletionTermination .

ex:Termination_XPostReviewCrew a agentoscin:TaskCompletionTermination .

ex:WorkflowPattern_ShakespeareanXPostCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_ShakespeareanXPostCrew_write_x_post .

ex:WorkflowPattern_XPostReviewCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_XPostReviewCrew_verify_x_post .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:LanguageModel a owl:Class ;
    rdfs:subClassOf agentoscin:StatisticalModel .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:FlowStep_generate_shakespeare_x_post a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasDecoratorArgument "retry"^^xsd:string ;
    agentoscin:hasTitle "generate_shakespeare_x_post"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowStep_max_retry_exceeded_exit a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasDecoratorArgument "max_retry_exceeded"^^xsd:string ;
    agentoscin:hasTitle "max_retry_exceeded_exit"^^xsd:string ;
    agentoscin:stepOrder 4 .

ex:FlowStep_save_result a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasDecoratorArgument "complete"^^xsd:string ;
    agentoscin:hasTitle "save_result"^^xsd:string ;
    agentoscin:stepOrder 3 .

ex:Team_XPostReviewCrew a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasAgentMember ex:Agent_x_post_verifier ;
    agentoscin:hasSystemConfig ex:Config_verbose_Team_XPostReviewCrew ;
    agentoscin:hasTerminationCondition ex:Termination_XPostReviewCrew ;
    agentoscin:hasTitle "XPostReviewCrew"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_XPostReviewCrew .

ex:Tool_CharacterCounterTool a agentoscin:Tool ;
    agentoscin:hasDescription "Counts the number of characters in a given string."^^xsd:string ;
    agentoscin:hasImplementationReference "tools.CharacterCounterTool.CharacterCounterTool._run"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The string to count characters in.\"}},\"required\":[\"text\"]}"^^xsd:string ;
    agentoscin:hasTitle "Character Counter Tool"^^xsd:string .

