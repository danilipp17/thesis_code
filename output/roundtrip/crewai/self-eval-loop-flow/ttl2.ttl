ex:Agent_shakespearean_bard a agentoscin:LLMAgent ;
    agentoscin:agentID "Shakespearean Bard"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_shakespearean_bard ;
    agentoscin:agentRole "Shakespearean Bard"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_CharacterCounterTool ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_shakespearean_bard ;
    agentoscin:hasReasoningEnabled false .

