ex:AgentPrompt_Email_Action_Specialist a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "As a seasoned executive assistant, you excel at understanding the context of business communications and determining the appropriate response and actions required for each email."^^xsd:string ;
    agentoscin:promptInstruction "For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."^^xsd:string .

ex:AgentPrompt_Email_Response_Writer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "You are a skilled communicator with a talent for crafting clear, professional, and context-appropriate email responses. You understand the nuances of business communication and can adapt your tone and style to match the situation."^^xsd:string ;
    agentoscin:promptInstruction "Draft professional and appropriate responses to action-required emails based on the determined actions and context."^^xsd:string .

ex:AgentPrompt_Senior_Email_Analyst a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "ModelDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "system_message"^^xsd:string ;
    agentoscin:promptContext "With years of experience in email management and communication triage, you are adept at quickly identifying important emails that require immediate action from those that can be archived or ignored."^^xsd:string ;
    agentoscin:promptInstruction "Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."^^xsd:string .

ex:FlowStep_run_asyncio a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_asyncio"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_run_team a agentoscin:EndStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_team"^^xsd:string ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_AutoGenFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_run_asyncio,
        ex:FlowStep_run_team .

ex:Goal_Email_Action_Specialist a agentoscin:Goal ;
    agentoscin:hasDescription "For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."^^xsd:string .

ex:Goal_Email_Response_Writer a agentoscin:Goal ;
    agentoscin:hasDescription "Draft professional and appropriate responses to action-required emails based on the determined actions and context."^^xsd:string .

ex:Goal_Senior_Email_Analyst a agentoscin:Goal ;
    agentoscin:hasDescription "Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."^^xsd:string .

ex:Orchestration_AutoGenFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "AutoGenFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AutoGenFlow .

ex:TaskPrompt_autogen_task_0 a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Based on the action plans provided, draft professional email responses for each action-required email. Ensure the responses are clear, concise, and appropriate for the context."^^xsd:string .

ex:Team_RoundRobinGroupChat_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:RoundRobin ;
    agentoscin:hasAgentMember ex:Agent_Email_Action_Specialist,
        ex:Agent_Email_Response_Writer,
        ex:Agent_Senior_Email_Analyst ;
    agentoscin:hasTerminationCondition ex:Termination_RoundRobinGroupChat_0 ;
    agentoscin:hasTitle "RoundRobinGroupChat"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_RoundRobinGroupChat_0 .

ex:Termination_RoundRobinGroupChat_0 a agentoscin:TaskCompletionTermination .

ex:Tool_create_draft a agentoscin:Tool ;
    agentoscin:hasDescription "Useful to create an email draft. The input to this tool should be a pipe (|) separated text of length 3 (three), representing who to send the email to, the subject of the email and the actual message. For example, `lorem@ipsum.com|Nice To Meet You|Hey it was great to meet you.`."^^xsd:string ;
    agentoscin:hasImplementationReference "tools.create_draft"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "create_draft"^^xsd:string .

ex:Tool_serper_dev_tool a agentoscin:Tool ;
    agentoscin:hasDescription "SerperDevTool"^^xsd:string ;
    agentoscin:hasImplementationReference "tools.serper_dev_tool"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "serper_dev_tool"^^xsd:string .

ex:WorkflowPattern_RoundRobinGroupChat_0 a agentoscin:WorkflowPattern .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoundRobin a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:Agent_Email_Action_Specialist a agentoscin:LLMAgent ;
    agentoscin:agentID "Email_Action_Specialist"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Email_Action_Specialist ;
    agentoscin:agentRole "Email_Action_Specialist"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_gmail_get_thread,
        ex:Tool_tavily_search_results ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Email_Action_Specialist ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_Email_Response_Writer a agentoscin:LLMAgent ;
    agentoscin:agentID "Email_Response_Writer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Email_Response_Writer ;
    agentoscin:agentRole "Email_Response_Writer"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_create_draft,
        ex:Tool_gmail_get_thread,
        ex:Tool_tavily_search_results ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Email_Response_Writer ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_Senior_Email_Analyst a agentoscin:LLMAgent ;
    agentoscin:agentID "Senior_Email_Analyst"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_Senior_Email_Analyst ;
    agentoscin:agentRole "Senior_Email_Analyst"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_serper_dev_tool ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_Senior_Email_Analyst ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Tool_gmail_get_thread a agentoscin:Tool ;
    agentoscin:hasDescription "GmailGetThread"^^xsd:string ;
    agentoscin:hasImplementationReference "tools.gmail_get_thread"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "gmail_get_thread"^^xsd:string .

ex:Tool_tavily_search_results a agentoscin:Tool ;
    agentoscin:hasDescription "TavilySearchResults"^^xsd:string ;
    agentoscin:hasImplementationReference "tools.tavily_search_results"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "tavily_search_results"^^xsd:string .

agentoscin:EndStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:EventBasedTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Instance a owl:Class ;
    rdfs:subClassOf agentoscin:Resource .

agentoscin:LanguageModel a owl:Class ;
    rdfs:subClassOf agentoscin:StatisticalModel .

agentoscin:Memory a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Plan a owl:Class .

agentoscin:StartStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Step a owl:Class .

agentoscin:System a owl:Class .

agentoscin:TaskCompletionTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:TurnLimitTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPrompt a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Task ;
    rdfs:range agentoscin:Prompt ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasRelatedPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:toolUsage a owl:ObjectProperty ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:LM_gpt_4o a agentoscin:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

agentoscin:Capability a owl:Class .

agentoscin:CompositeTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Environment a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:KnowledgeBase a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:Objective a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Schema a owl:Class .

agentoscin:Agent a owl:Class .

agentoscin:Config a owl:Class .

agentoscin:Context a owl:Class .

agentoscin:hasConfig a owl:ObjectProperty ;
    rdfs:domain agentoscin:Agent,
        agentoscin:AgenticSystem,
        agentoscin:Capability,
        agentoscin:Config,
        agentoscin:Context,
        agentoscin:CoordinationPattern,
        agentoscin:Guardrail,
        agentoscin:HumanCheckpoint,
        agentoscin:MemoryBinding,
        agentoscin:Orchestration,
        agentoscin:Plan,
        agentoscin:Prompt,
        agentoscin:ReasoningPattern,
        agentoscin:Resource,
        agentoscin:Schema,
        agentoscin:Step,
        agentoscin:System,
        agentoscin:Task,
        agentoscin:TerminationCondition,
        agentoscin:Tool ;
    rdfs:range agentoscin:Config ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Goal a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Guardrail a owl:Class .

agentoscin:HumanCheckpoint a owl:Class .

agentoscin:Orchestration a owl:Class ;
    rdfs:subClassOf agentoscin:Team .

