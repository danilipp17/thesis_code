@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/email-flow#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/email-flow> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:Task_autogen_task_0 a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agentoscin:taskPrompt ex:TaskPrompt_autogen_task_0 .

ex:email_flow_reextract a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_Email_Action_Specialist,
        ex:Agent_Email_Response_Writer,
        ex:Agent_Senior_Email_Analyst ;
    agentoscin:containsOrchestration ex:Orchestration_AutoGenFlow ;
    agentoscin:containsTeam ex:Team_RoundRobinGroupChat_0 ;
    agentoscin:hasSourceFramework "AutoGen_v0.4"^^xsd:string ;
    agentoscin:hasTitle "email-flow_reextract"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Hierarchical a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Network a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:ReAct a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReActLoop a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:SelectorBased a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Sequential a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Swarm a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Unspecified a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

