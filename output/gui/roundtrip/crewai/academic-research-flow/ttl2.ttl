    agentoscin:stepOrder 4 .

ex:Task_task_conduct_research a agentoscin:Task ;
    agentoscin:dependsOn ex:Task_task_initialize_research ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:hasExpectedOutput "messages"^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_conduct_research ;
    agentoscin:taskPrompt ex:TaskPrompt_task_conduct_research .

ex:Task_task_initialize_research a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:hasExpectedOutput "messages"^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_initialize_research ;
    agentoscin:taskPrompt ex:TaskPrompt_task_initialize_research .

ex:Task_task_publish_paper a agentoscin:Task ;
    agentoscin:dependsOn ex:Task_task_review_outcome ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:hasExpectedOutput "messages"^^xsd:string ;
