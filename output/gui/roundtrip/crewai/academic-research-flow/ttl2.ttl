ex:AgentPrompt_abort_research a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptInstruction "abort_research: Node: abort_research"^^xsd:string .

ex:AgentPrompt_conduct_research a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptInstruction "conduct_research: Node: conduct_research"^^xsd:string .

ex:AgentPrompt_initialize_research a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptInstruction "initialize_research: Node: initialize_research"^^xsd:string .

ex:AgentPrompt_publish_paper a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptInstruction "publish_paper: Node: publish_paper"^^xsd:string .

ex:AgentPrompt_review_outcome a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptInstruction "review_outcome: Node: review_outcome"^^xsd:string .

ex:CrewStep_langgraph_team_0_task_initialize_research a agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_task_initialize_research ;
    agentoscin:hasTitle "task_initialize_research"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_langgraph_team_0_task_conduct_research ;
    agentoscin:stepOrder 1 .

ex:FlowStep_initialize_research a agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "initialize_research"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_conduct_research ;
    agentoscin:stepOrder 1 .

ex:FlowStep_review_outcome a agentoscin:ConditionalStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasEdgeMapping "{\"abort_research\": \"abort_research\", \"publish_paper\": \"publish_paper\"}"^^xsd:string ;
    agentoscin:hasRoutingLogic """if self.state.status == 'SUCCESS':
    return 'publish_paper'
elif self.state.status == 'FAILED':
    return 'abort_research'"""^^xsd:string ;
    agentoscin:hasTitle "review_outcome"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_abort_research,
        ex:FlowStep_publish_paper ;
    agentoscin:stepOrder 3 .

ex:FlowWorkflowPattern_StateGraph a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_abort_research,
        ex:FlowStep_conduct_research,
        ex:FlowStep_initialize_research,
        ex:FlowStep_publish_paper,
        ex:FlowStep_review_outcome .

ex:Goal_abort_research a agentoscin:Goal ;
    agentoscin:hasDescription "Node: abort_research"^^xsd:string .

ex:Goal_conduct_research a agentoscin:Goal ;
    agentoscin:hasDescription "Node: conduct_research"^^xsd:string .

ex:Goal_initialize_research a agentoscin:Goal ;
    agentoscin:hasDescription "Node: initialize_research"^^xsd:string .

ex:Goal_publish_paper a agentoscin:Goal ;
    agentoscin:hasDescription "Node: publish_paper"^^xsd:string .

ex:Goal_review_outcome a agentoscin:Goal ;
    agentoscin:hasDescription "Node: review_outcome"^^xsd:string .

ex:Orchestration_StateGraph a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasOutputSchema ex:StateSchema_StateGraph ;
    agentoscin:hasTitle "StateGraph"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_StateGraph .

ex:RoutingTermination_langgraph_team_0_0 a agentoscin:RoutingTermination .

ex:StateSchema_StateGraph a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"messages\": \"Annotated[list, add_messages]\", \"id\": \"str\", \"topic\": \"str\", \"paper\": \"str\", \"status\": \"str\"}"^^xsd:string ;
    agentoscin:hasTitle "State"^^xsd:string .

ex:TaskPrompt_task_abort_research a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform abort_research responsibilities"^^xsd:string ;
    agentoscin:promptOutputIndicator "messages"^^xsd:string .

ex:TaskPrompt_task_conduct_research a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform conduct_research responsibilities"^^xsd:string ;
    agentoscin:promptOutputIndicator "messages"^^xsd:string .

ex:TaskPrompt_task_initialize_research a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform initialize_research responsibilities"^^xsd:string ;
    agentoscin:promptOutputIndicator "messages"^^xsd:string .

ex:TaskPrompt_task_publish_paper a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform publish_paper responsibilities"^^xsd:string ;
    agentoscin:promptOutputIndicator "messages"^^xsd:string .

ex:TaskPrompt_task_review_outcome a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform review_outcome responsibilities"^^xsd:string ;
    agentoscin:promptOutputIndicator "messages"^^xsd:string .

ex:Task_task_abort_research a agentoscin:Task ;
    agentoscin:dependsOn ex:Task_task_publish_paper ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:hasExpectedOutput "messages"^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_abort_research ;
    agentoscin:taskPrompt ex:TaskPrompt_task_abort_research .

ex:Team_langgraph_team_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Hierarchical ;
    agentoscin:hasAgentMember ex:Agent_abort_research,
        ex:Agent_conduct_research,
        ex:Agent_initialize_research,
        ex:Agent_publish_paper,
        ex:Agent_review_outcome ;
    agentoscin:hasTerminationCondition ex:RoutingTermination_langgraph_team_0_0 ;
    agentoscin:hasTitle "StateGraph"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_langgraph_team_0 .

ex:WorkflowPattern_langgraph_team_0 a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_langgraph_team_0_task_abort_research,
        ex:CrewStep_langgraph_team_0_task_conduct_research,
        ex:CrewStep_langgraph_team_0_task_initialize_research,
        ex:CrewStep_langgraph_team_0_task_publish_paper,
        ex:CrewStep_langgraph_team_0_task_review_outcome .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Hierarchical a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

