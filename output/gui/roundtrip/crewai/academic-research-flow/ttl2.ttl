    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:CrewStep_langgraph_team_0_task_abort_research a agentoscin:EndStep ;
    agentoscin:hasAssociatedTask ex:Task_task_abort_research ;
    agentoscin:hasTitle "task_abort_research"^^xsd:string ;
    agentoscin:stepOrder 5 .

ex:CrewStep_langgraph_team_0_task_conduct_research a agentoscin:WorkflowStep ;
    agentoscin:hasAssociatedTask ex:Task_task_conduct_research ;
    agentoscin:hasTitle "task_conduct_research"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_langgraph_team_0_task_review_outcome ;
    agentoscin:stepOrder 2 .

ex:CrewStep_langgraph_team_0_task_publish_paper a agentoscin:WorkflowStep ;
    agentoscin:hasAssociatedTask ex:Task_task_publish_paper ;
    agentoscin:hasTitle "task_publish_paper"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_langgraph_team_0_task_abort_research ;
    agentoscin:stepOrder 4 .

ex:CrewStep_langgraph_team_0_task_review_outcome a agentoscin:WorkflowStep ;
    agentoscin:hasAssociatedTask ex:Task_task_review_outcome ;
    agentoscin:hasTitle "task_review_outcome"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_langgraph_team_0_task_publish_paper ;
    agentoscin:stepOrder 3 .

ex:FlowStep_abort_research a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "abort_research"^^xsd:string ;
    agentoscin:stepOrder 5 .

ex:FlowStep_conduct_research a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "conduct_research"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_publish_paper a agentoscin:EndStep,
