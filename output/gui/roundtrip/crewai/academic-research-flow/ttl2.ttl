@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/academic_research_flow#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/academic_research_flow> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:Tool_academic_search_tool a agentoscin:Tool ;
    agentoscin:hasDescription """Academic Search Tool
Search academic papers and journals to find relevant literature."""^^xsd:string ;
    agentoscin:hasImplementationReference "tools.academic_search_tool"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}"^^xsd:string ;
    agentoscin:hasTitle "academic_search_tool"^^xsd:string .

ex:academic_research_flow_roundtrip a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_abort_research,
        ex:Agent_conduct_research,
        ex:Agent_initialize_research,
        ex:Agent_publish_paper,
        ex:Agent_review_outcome ;
    agentoscin:containsOrchestration ex:Orchestration_StateGraph ;
    agentoscin:containsTeam ex:Team_langgraph_team_0 ;
    agentoscin:hasSourceFramework "LangGraph"^^xsd:string ;
    agentoscin:hasTitle "academic_research_flow_roundtrip"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Network a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:ReAct a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReActLoop a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:RoundRobin a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:SelectorBased a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Sequential a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Swarm a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Unspecified a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

