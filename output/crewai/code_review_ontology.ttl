@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/code_review#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/code_review> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:CodeReviewSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_code_reviewer,
        ex:Agent_review_summarizer,
        ex:Agent_security_auditor ;
    agentoscin:containsOrchestration ex:Orchestration_CodeReviewFlow ;
    agentoscin:containsTeam ex:Team_CodeReviewCrew ;
    agentoscin:hasSourceFramework "CrewAI"^^xsd:string ;
    agentoscin:hasTitle "CodeReviewSystem"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:ReAct a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Unspecified a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:agentID a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:agentResourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf agentoscin:resourceUsage .

agentoscin:agentRole a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:agentType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:bindsMemory a owl:ObjectProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agentoscin:Memory ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:configKey a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Config ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:configValue a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Config ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:containsAgent a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsOrchestration a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Orchestration ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Environment ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsTeam a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:contributesToGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:Objective ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:contributesToObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:dependsOn a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:employsCoordinationPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:CoordinationPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:employsReasoningPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:ReasoningPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:envType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Environment ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasAgentCapability a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasCapability .

agentoscin:hasAgentConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasAgentGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasGoal .

agentoscin:hasAgentMember a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasAssociatedTask a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasCheckpointPosition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasCheckpointType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDelegationStrategy a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDependencyType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDirectiveFunction a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasEnvironmentConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasExpectedOutput a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasGuardrail a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Guardrail ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasGuardrailType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasHumanCheckpoint a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:HumanCheckpoint ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasImplementationReference a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasInputSchema a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasKnowledge a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:KnowledgeBase ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMaxReasoningAttempts a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMaxRetries a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:language ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMaxTurns a owl:DatatypeProperty ;
    rdfs:domain agentoscin:TurnLimitTermination ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasOperator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasOutputSchema a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Schema ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPersistenceScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Memory ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningEnabled a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningOrigin a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReference a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasRoutingLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:ConditionalStep ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSchemaDefinition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Schema ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSourceAttribute a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSourceFramework a owl:DatatypeProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSubCondition a owl:ObjectProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range agentoscin:TerminationCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasSubPattern a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasRelatedPattern .

agentoscin:hasSystemConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasTeamGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasGoal .

agentoscin:hasTeamMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasTerminationCondition a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:TerminationCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasTitle a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasToolConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasTriggerExpression a owl:DatatypeProperty ;
    rdfs:domain agentoscin:EventBasedTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasValidationLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasWorkflowPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasWorkflowStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:humanParticipatedIn a owl:ObjectProperty ;
    rdfs:domain agentoscin:HumanAgent ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:interactsWith a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:isMandatory a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:memoryBoundTo a owl:ObjectProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agentoscin:AgenticSystem,
        agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:nextPattern a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasRelatedPattern .

agentoscin:nextStep a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:relatedStep .

agentoscin:operatesIn a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Environment ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:orchestratesTeam a owl:ObjectProperty ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedByAgent a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf agentoscin:performedBy .

agentoscin:producedResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:promptContext a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptInputData a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptInstruction a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptOutputIndicator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:requiresCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:requiresResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:stepOrder a owl:DatatypeProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:taskPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:taskToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:useLanguageModel a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LanguageModel ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:AgentPrompt_code_reviewer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a senior software engineer with 15 years of experience in code review. You have reviewed thousands of pull requests across multiple languages and frameworks, giving you a sharp eye for common pitfalls and anti-patterns."^^xsd:string ;
    agentoscin:promptInstruction "Senior Code Reviewer: Perform a thorough code review, checking for correctness, readability, and adherence to best practices. Identify bugs, code smells, and potential improvements."^^xsd:string .

ex:AgentPrompt_review_summarizer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a technical lead who synthesizes feedback from multiple reviewers into clear, actionable review summaries. You balance thoroughness with pragmatism, distinguishing blockers from nits."^^xsd:string ;
    agentoscin:promptInstruction "Review Summarizer: Compile code review and security audit findings into a structured review report with an overall verdict (approve or request changes)."^^xsd:string .

ex:AgentPrompt_security_auditor a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a certified security professional specializing in application security. You have experience in penetration testing and secure code review, and you stay current with the latest CVEs and vulnerability disclosures."^^xsd:string ;
    agentoscin:promptInstruction "Security Auditor: Audit code for security vulnerabilities including injection attacks, authentication flaws, data exposure, and insecure dependencies. Flag any OWASP Top 10 violations."^^xsd:string .

ex:Config_verbose_Agent_code_reviewer a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_review_summarizer a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_security_auditor a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Team_CodeReviewCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:CrewStep_CodeReviewCrew_review_code a agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_review_code ;
    agentoscin:hasTitle "review_code"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_CodeReviewCrew_audit_security ;
    agentoscin:stepOrder 1 .

ex:FlowStep_run_review a agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_review"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_check_quality_gate ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_CodeReviewFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_check_quality_gate,
        ex:FlowStep_handle_approved,
        ex:FlowStep_handle_max_retries,
        ex:FlowStep_handle_revision_needed,
        ex:FlowStep_run_review .

ex:Goal_code_reviewer a agentoscin:Goal ;
    agentoscin:hasDescription "Perform a thorough code review, checking for correctness, readability, and adherence to best practices. Identify bugs, code smells, and potential improvements."^^xsd:string .

ex:Goal_review_summarizer a agentoscin:Goal ;
    agentoscin:hasDescription "Compile code review and security audit findings into a structured review report with an overall verdict (approve or request changes)."^^xsd:string .

ex:Goal_security_auditor a agentoscin:Goal ;
    agentoscin:hasDescription "Audit code for security vulnerabilities including injection attacks, authentication flaws, data exposure, and insecure dependencies. Flag any OWASP Top 10 violations."^^xsd:string .

ex:Orchestration_CodeReviewFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "CodeReviewFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_CodeReviewFlow ;
    agentoscin:orchestratesTeam ex:Team_CodeReviewCrew .

ex:Schema_ReviewResult a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"approved\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"critical_count\":{\"type\":\"integer\"},\"action_items\":{\"type\":\"string\"}},\"required\":[\"approved\",\"summary\",\"critical_count\",\"action_items\"]}"^^xsd:string .

ex:TaskPrompt_audit_security a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction """Audit the following code for security vulnerabilities. Check for injection attacks, hardcoded secrets, insecure data handling, missing input validation, and OWASP Top 10 issues.
Code to audit: {code}"""^^xsd:string ;
    agentoscin:promptOutputIndicator "A security report listing each vulnerability found with its CWE classification, severity, affected lines, and remediation steps."^^xsd:string .

ex:TaskPrompt_compile_review a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Compile the code review findings and security audit results into a final review report. Determine the overall verdict: approve if no critical or major issues remain, otherwise request changes."^^xsd:string ;
    agentoscin:promptOutputIndicator "A JSON object with fields: approved (boolean), summary (string), critical_count (integer), and action_items (list of strings)."^^xsd:string .

ex:TaskPrompt_review_code a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction """Review the following code for correctness, readability, and best practices. Identify bugs, code smells, naming issues, and suggest improvements.
Code to review: {code}"""^^xsd:string ;
    agentoscin:promptOutputIndicator "A structured list of findings categorized as bug, code smell, style, or improvement, each with severity (critical, major, minor) and a suggested fix."^^xsd:string .

ex:Task_audit_security a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A security report listing each vulnerability found with its CWE classification, severity, affected lines, and remediation steps."^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_security_auditor ;
    agentoscin:taskPrompt ex:TaskPrompt_audit_security .

ex:Task_compile_review a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A JSON object with fields: approved (boolean), summary (string), critical_count (integer), and action_items (list of strings)."^^xsd:string ;
    agentoscin:hasOutputSchema ex:Schema_ReviewResult ;
    agentoscin:performedByAgent ex:Agent_review_summarizer ;
    agentoscin:taskPrompt ex:TaskPrompt_compile_review .

ex:Task_review_code a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A structured list of findings categorized as bug, code smell, style, or improvement, each with severity (critical, major, minor) and a suggested fix."^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_code_reviewer ;
    agentoscin:taskPrompt ex:TaskPrompt_review_code .

ex:Termination_CodeReviewCrew a agentoscin:TaskCompletionTermination .

ex:WorkflowPattern_CodeReviewCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_CodeReviewCrew_audit_security,
        ex:CrewStep_CodeReviewCrew_compile_review,
        ex:CrewStep_CodeReviewCrew_review_code .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Sequential a agentoscin:CoordinationPattern .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:CrewStep_CodeReviewCrew_audit_security a agentoscin:WorkflowStep ;
    agentoscin:hasAssociatedTask ex:Task_audit_security ;
    agentoscin:hasTitle "audit_security"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_CodeReviewCrew_compile_review ;
    agentoscin:stepOrder 2 .

ex:CrewStep_CodeReviewCrew_compile_review a agentoscin:EndStep ;
    agentoscin:hasAssociatedTask ex:Task_compile_review ;
    agentoscin:hasTitle "compile_review"^^xsd:string ;
    agentoscin:stepOrder 3 .

ex:FlowStep_check_quality_gate a agentoscin:ConditionalStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasRoutingLogic """        if self.state.retry_count > 2:
            return "max_retries"

        self.state.retry_count += 1

        if self.state.approved:
            return "approved"

        return "needs_revision\""""^^xsd:string ;
    agentoscin:hasTitle "check_quality_gate"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_handle_approved,
        ex:FlowStep_handle_max_retries,
        ex:FlowStep_handle_revision_needed ;
    agentoscin:stepOrder 2 .

ex:FlowStep_handle_approved a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "handle_approved"^^xsd:string ;
    agentoscin:stepOrder 3 .

ex:FlowStep_handle_max_retries a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "handle_max_retries"^^xsd:string ;
    agentoscin:stepOrder 5 .

ex:FlowStep_handle_revision_needed a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "handle_revision_needed"^^xsd:string ;
    agentoscin:stepOrder 4 .

ex:Team_CodeReviewCrew a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasAgentMember ex:Agent_code_reviewer,
        ex:Agent_review_summarizer,
        ex:Agent_security_auditor ;
    agentoscin:hasSystemConfig ex:Config_verbose_Team_CodeReviewCrew ;
    agentoscin:hasTerminationCondition ex:Termination_CodeReviewCrew ;
    agentoscin:hasTitle "CodeReviewCrew"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_CodeReviewCrew .

ex:Tool_CodeAnalyzerTool a agentoscin:Tool ;
    agentoscin:hasDescription "Performs static analysis on source code. Checks for syntax errors, undefined variables, unused imports, and common anti-patterns."^^xsd:string ;
    agentoscin:hasImplementationReference "tools.code_analyzer.CodeAnalyzerTool._run"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"description\":\"The source code to analyze.\"},\"language\":{\"type\":\"string\",\"description\":\"The programming language.\"}},\"required\":[\"code\",\"language\"]}"^^xsd:string ;
    agentoscin:hasTitle "Code Analyzer"^^xsd:string .

