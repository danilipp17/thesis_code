@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/academic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/academic> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:AcademicResearchSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_prof_writer,
        ex:Agent_senior_researcher ;
    agentoscin:containsOrchestration ex:Orchestration_AcademicResearchFlow ;
    agentoscin:containsTeam ex:Team_AcademicResearchCrew ;
    agentoscin:hasSourceFramework "CrewAI"^^xsd:string ;
    agentoscin:hasTitle "AcademicResearchSystem"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:ReAct a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:agentID a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:agentResourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf agentoscin:resourceUsage .

agentoscin:agentRole a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:agentType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:bindsMemory a owl:ObjectProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agentoscin:Memory ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:configKey a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Config ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:configValue a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Config ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:containsAgent a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsOrchestration a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Orchestration ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Environment ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsTeam a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:contributesToGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:Objective ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:contributesToObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:dependsOn a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:employsCoordinationPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:CoordinationPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:employsReasoningPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:ReasoningPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:envType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Environment ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasAgentCapability a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasCapability .

agentoscin:hasAgentConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasAgentGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasGoal .

agentoscin:hasAgentMember a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasAssociatedTask a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasCheckpointPosition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasCheckpointType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDelegationStrategy a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDependencyType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDirectiveFunction a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasEnvironmentConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasExpectedOutput a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasGuardrail a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Guardrail ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasGuardrailType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasHumanCheckpoint a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:HumanCheckpoint ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasImplementationReference a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasInputSchema a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasKnowledge a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:KnowledgeBase ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMaxReasoningAttempts a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMaxRetries a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:language ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMaxTurns a owl:DatatypeProperty ;
    rdfs:domain agentoscin:TurnLimitTermination ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasOperator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasOutputSchema a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Schema ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPersistenceScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Memory ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningEnabled a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningOrigin a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReference a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasRoutingLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:ConditionalStep ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSchemaDefinition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Schema ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSourceAttribute a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSourceFramework a owl:DatatypeProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSubCondition a owl:ObjectProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range agentoscin:TerminationCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasSubPattern a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasRelatedPattern .

agentoscin:hasSystemConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasTeamGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasGoal .

agentoscin:hasTeamMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasTerminationCondition a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:TerminationCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasTitle a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasToolConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasTriggerExpression a owl:DatatypeProperty ;
    rdfs:domain agentoscin:EventBasedTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasValidationLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasWorkflowPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasWorkflowStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:humanParticipatedIn a owl:ObjectProperty ;
    rdfs:domain agentoscin:HumanAgent ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:interactsWith a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:isMandatory a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:memoryBoundTo a owl:ObjectProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agentoscin:AgenticSystem,
        agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:nextPattern a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasRelatedPattern .

agentoscin:nextStep a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:relatedStep .

agentoscin:operatesIn a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Environment ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:orchestratesTeam a owl:ObjectProperty ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedByAgent a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf agentoscin:performedBy .

agentoscin:producedResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:promptContext a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptInputData a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptInstruction a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptOutputIndicator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:requiresCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:requiresResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:stepOrder a owl:DatatypeProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:taskPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:taskToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:useLanguageModel a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LanguageModel ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:AgentPrompt_prof_writer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You have published in top-tier journals and know exactly how to structure an academic paper for maximum impact and clarity."^^xsd:string ;
    agentoscin:promptInstruction "Academic Writer and Editor: Take rough notes and outlines to produce a formal, peer-review-ready academic paper."^^xsd:string .

ex:AgentPrompt_senior_researcher a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a tenured professor with years of experience navigating complex academic databases and synthesizing information."^^xsd:string ;
    agentoscin:promptInstruction "Senior Academic Researcher: Conduct extensive literature reviews and gather empirical data on the chosen topic."^^xsd:string .

ex:Config_allow_delegation_Agent_prof_writer a agentoscin:Config ;
    agentoscin:configKey "allow_delegation"^^xsd:string ;
    agentoscin:configValue "false"^^xsd:string .

ex:Config_allow_delegation_Agent_senior_researcher a agentoscin:Config ;
    agentoscin:configKey "allow_delegation"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_prof_writer a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "false"^^xsd:string .

ex:Config_verbose_Agent_senior_researcher a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Team_AcademicResearchCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:CrewStep_AcademicResearchCrew_gather_literature_task a agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_gather_literature_task ;
    agentoscin:hasTitle "gather_literature_task"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_AcademicResearchCrew_write_paper_task ;
    agentoscin:stepOrder 1 .

ex:FlowStep_initialize_research a agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "initialize_research"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_conduct_research ;
    agentoscin:stepOrder 1 .

ex:FlowStep_review_outcome a agentoscin:ConditionalStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasRoutingLogic """        if self.state.status == "SUCCESS":
            return "publish_paper"
        elif self.state.status == "FAILED":
            return "abort_research\""""^^xsd:string ;
    agentoscin:hasTitle "review_outcome"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_abort_research,
        ex:FlowStep_publish_paper ;
    agentoscin:stepOrder 3 .

ex:FlowWorkflowPattern_AcademicResearchFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_abort_research,
        ex:FlowStep_conduct_research,
        ex:FlowStep_initialize_research,
        ex:FlowStep_publish_paper,
        ex:FlowStep_review_outcome .

ex:Goal_prof_writer a agentoscin:Goal ;
    agentoscin:hasDescription "Take rough notes and outlines to produce a formal, peer-review-ready academic paper."^^xsd:string .

ex:Goal_senior_researcher a agentoscin:Goal ;
    agentoscin:hasDescription "Conduct extensive literature reviews and gather empirical data on the chosen topic."^^xsd:string .

ex:HumanCheckpoint_gather_literature_task a agentoscin:HumanCheckpoint ;
    agentoscin:hasCheckpointPosition "AfterExecution"^^xsd:string ;
    agentoscin:hasCheckpointType "Review"^^xsd:string ;
    agentoscin:isMandatory true .

ex:MemoryBinding_AgentPrivate_senior_researcher a agentoscin:MemoryBinding ;
    agentoscin:bindsMemory ex:Memory_AgentPrivate_senior_researcher ;
    agentoscin:hasMemoryScope "AgentPrivate"^^xsd:string .

ex:MemoryBinding_GroupShared_AcademicResearchCrew a agentoscin:MemoryBinding ;
    agentoscin:bindsMemory ex:Memory_GroupShared_AcademicResearchCrew ;
    agentoscin:hasMemoryScope "GroupShared"^^xsd:string .

ex:Memory_AgentPrivate_senior_researcher a agentoscin:Memory ;
    agentoscin:hasPersistenceScope "Persistent"^^xsd:string .

ex:Memory_GroupShared_AcademicResearchCrew a agentoscin:Memory ;
    agentoscin:hasPersistenceScope "Persistent"^^xsd:string .

ex:Orchestration_AcademicResearchFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "AcademicResearchFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AcademicResearchFlow ;
    agentoscin:orchestratesTeam ex:Team_AcademicResearchCrew .

ex:ReasoningPattern_Unspecified a agentoscin:Unspecified .

ex:Schema_FinalPaper a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"abstract\":{\"type\":\"string\",\"description\":\"A summary of the paper.\"},\"body_paragraphs\":{\"type\":\"string\",\"description\":\"The main text.\"},\"conclusion\":{\"type\":\"string\",\"description\":\"The final conclusion.\"}},\"required\":[\"abstract\",\"body_paragraphs\",\"conclusion\"]}"^^xsd:string .

ex:Schema_ResearchOutline a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\",\"description\":\"The title of the research topic.\"},\"key_claims\":{\"type\":\"string\",\"description\":\"The core arguments or hypotheses.\"},\"sources\":{\"type\":\"string\",\"description\":\"The academic sources found.\"}},\"required\":[\"title\",\"key_claims\",\"sources\"]}"^^xsd:string .

ex:TaskPrompt_gather_literature_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Use the search tools to gather literature on the topic. Extract key claims and references."^^xsd:string ;
    agentoscin:promptOutputIndicator "A well-structured outline containing the title, key claims, and academic sources."^^xsd:string .

ex:TaskPrompt_write_paper_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Take the outline and draft the final academic paper."^^xsd:string ;
    agentoscin:promptOutputIndicator "A complete paper with an abstract, body paragraphs, and conclusion."^^xsd:string .

ex:Task_gather_literature_task a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agentoscin:hasExpectedOutput "A well-structured outline containing the title, key claims, and academic sources."^^xsd:string ;
    agentoscin:hasHumanCheckpoint ex:HumanCheckpoint_gather_literature_task ;
    agentoscin:hasOutputSchema ex:Schema_ResearchOutline ;
    agentoscin:taskPrompt ex:TaskPrompt_gather_literature_task .

ex:Task_write_paper_task a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agentoscin:hasExpectedOutput "A complete paper with an abstract, body paragraphs, and conclusion."^^xsd:string ;
    agentoscin:hasOutputSchema ex:Schema_FinalPaper ;
    agentoscin:taskPrompt ex:TaskPrompt_write_paper_task .

ex:Termination_AcademicResearchCrew a agentoscin:TaskCompletionTermination .

ex:Tool_AcademicSearchTool a agentoscin:Tool ;
    agentoscin:hasDescription "Search academic papers and journals to find relevant literature."^^xsd:string ;
    agentoscin:hasImplementationReference "tools.custom_tools.AcademicSearchTool._run"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"The query to search the academic database for.\"}},\"required\":[\"query\"]}"^^xsd:string ;
    agentoscin:hasTitle "Academic Search Tool"^^xsd:string .

ex:WorkflowPattern_AcademicResearchCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_AcademicResearchCrew_gather_literature_task,
        ex:CrewStep_AcademicResearchCrew_write_paper_task .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern .

agentoscin:HierarchicalPattern a agentoscin:CoordinationPattern .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:Unspecified a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:Agent_prof_writer a agentoscin:LLMAgent ;
    agentoscin:agentID "Academic Writer and Editor"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_prof_writer ;
    agentoscin:agentRole "Academic Writer and Editor"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentConfig ex:Config_allow_delegation_Agent_prof_writer,
        ex:Config_verbose_Agent_prof_writer ;
    agentoscin:hasAgentGoal ex:Goal_prof_writer ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_senior_researcher a agentoscin:LLMAgent ;
    agentoscin:agentID "Senior Academic Researcher"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_senior_researcher ;
    agentoscin:agentRole "Senior Academic Researcher"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_AcademicSearchTool ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:employsReasoningPattern ex:ReasoningPattern_Unspecified ;
    agentoscin:hasAgentConfig ex:Config_allow_delegation_Agent_senior_researcher,
        ex:Config_verbose_Agent_senior_researcher ;
    agentoscin:hasAgentGoal ex:Goal_senior_researcher ;
    agentoscin:hasMaxReasoningAttempts 3 ;
    agentoscin:hasMemoryBinding ex:MemoryBinding_AgentPrivate_senior_researcher ;
    agentoscin:hasReasoningEnabled true ;
    agentoscin:hasReasoningOrigin "FrameworkManaged"^^xsd:string ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:CrewStep_AcademicResearchCrew_write_paper_task a agentoscin:EndStep ;
    agentoscin:hasAssociatedTask ex:Task_write_paper_task ;
    agentoscin:hasTitle "write_paper_task"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_abort_research a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "abort_research"^^xsd:string ;
    agentoscin:stepOrder 5 .

ex:FlowStep_conduct_research a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "conduct_research"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_publish_paper a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "publish_paper"^^xsd:string ;
    agentoscin:stepOrder 4 .

ex:LM_gpt_4o a agentoscin:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

ex:Team_AcademicResearchCrew a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:HierarchicalPattern ;
    agentoscin:hasAgentMember ex:Agent_prof_writer,
        ex:Agent_senior_researcher ;
    agentoscin:hasSystemConfig ex:Config_verbose_Team_AcademicResearchCrew ;
    agentoscin:hasTeamMemoryBinding ex:MemoryBinding_GroupShared_AcademicResearchCrew ;
    agentoscin:hasTerminationCondition ex:Termination_AcademicResearchCrew ;
    agentoscin:hasTitle "AcademicResearchCrew"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_AcademicResearchCrew .

agentoscin:ConditionalStep a owl:Class ;
