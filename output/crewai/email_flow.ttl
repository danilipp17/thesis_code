ex:AgentPrompt_email_action_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "As a seasoned executive assistant, you excel at understanding the context of business communications and determining the appropriate response and actions required for each email."^^xsd:string ;
    agentoscin:promptInstruction "Email Action Specialist: For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."^^xsd:string .

ex:AgentPrompt_email_filter_agent a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "With years of experience in email management and communication triage, you are adept at quickly identifying important emails that require immediate action from those that can be archived or ignored."^^xsd:string ;
    agentoscin:promptInstruction "Senior Email Analyst: Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."^^xsd:string .

ex:AgentPrompt_email_response_writer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a skilled communicator with a talent for crafting clear, professional, and context-appropriate email responses. You understand the nuances of business communication and can adapt your tone and style to match the situation."^^xsd:string ;
    agentoscin:promptInstruction "Email Response Writer: Draft professional and appropriate responses to action-required emails based on the determined actions and context."^^xsd:string .

ex:Config_allow_delegation_Agent_email_filter_agent a agentoscin:Config ;
    agentoscin:configKey "allow_delegation"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_email_action_agent a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_email_filter_agent a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_email_response_writer a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Team_EmailFilterCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:CrewStep_EmailFilterCrew_filter_emails_task a agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_filter_emails_task ;
    agentoscin:hasTitle "filter_emails_task"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_EmailFilterCrew_action_required_emails_task ;
    agentoscin:stepOrder 1 .

ex:FlowStep_fetch_new_emails a agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "fetch_new_emails"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_generate_draft_responses ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_EmailAutoResponderFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_fetch_new_emails,
        ex:FlowStep_generate_draft_responses .

ex:Goal_email_action_agent a agentoscin:Goal ;
    agentoscin:hasDescription "For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."^^xsd:string .

ex:Goal_email_filter_agent a agentoscin:Goal ;
    agentoscin:hasDescription "Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."^^xsd:string .

ex:Goal_email_response_writer a agentoscin:Goal ;
    agentoscin:hasDescription "Draft professional and appropriate responses to action-required emails based on the determined actions and context."^^xsd:string .

ex:Orchestration_EmailAutoResponderFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "EmailAutoResponderFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_EmailAutoResponderFlow ;
    agentoscin:orchestratesTeam ex:Team_EmailFilterCrew .

ex:TaskPrompt_action_required_emails_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "For each email classified as 'action_required', analyze the content and determine the specific actions that need to be taken. Consider the urgency, context, and any deadlines mentioned in the emails."^^xsd:string ;
    agentoscin:promptOutputIndicator "A detailed action plan for each action-required email, including the specific steps to take, priority level, and any relevant deadlines."^^xsd:string .

ex:TaskPrompt_draft_responses_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Based on the action plans provided, draft professional email responses for each action-required email. Ensure the responses are clear, concise, and appropriate for the context."^^xsd:string ;
    agentoscin:promptOutputIndicator "A set of draft email responses ready to be reviewed and sent, each properly formatted with subject line, greeting, body, and closing."^^xsd:string .

ex:TaskPrompt_filter_emails_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction """Analyze the list of emails provided and categorize each email as either 'action_required' or 'no_action_needed'. Use your expertise to filter out newsletters, promotional content, and spam.
Here are the emails: {emails}"""^^xsd:string ;
    agentoscin:promptOutputIndicator "A categorized list of emails with their classification as either 'action_required' or 'no_action_needed', along with a brief reason for each classification."^^xsd:string .

ex:Task_draft_responses_task a agentoscin:Task ;
    agentoscin:dependsOn ex:Task_action_required_emails_task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:hasExpectedOutput "A set of draft email responses ready to be reviewed and sent, each properly formatted with subject line, greeting, body, and closing."^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_email_response_writer ;
    agentoscin:taskPrompt ex:TaskPrompt_draft_responses_task .

ex:Termination_EmailFilterCrew a agentoscin:TaskCompletionTermination .

ex:Tool_SerperDevTool a agentoscin:Tool ;
    agentoscin:hasReference "external:SerperDevTool"^^xsd:string ;
    agentoscin:hasTitle "SerperDevTool"^^xsd:string .

ex:Tool_create_draft a agentoscin:Tool ;
    agentoscin:hasDescription """Useful to create an email draft.
The input to this tool should be a pipe (|) separated text
of length 3 (three), representing who to send the email to,
the subject of the email and the actual message.
For example, `lorem@ipsum.com|Nice To Meet You|Hey it was great to meet you.`."""^^xsd:string ;
    agentoscin:hasImplementationReference "tools.create_draft.create_draft"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "Create Draft"^^xsd:string .

ex:WorkflowPattern_EmailFilterCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_EmailFilterCrew_action_required_emails_task,
        ex:CrewStep_EmailFilterCrew_draft_responses_task,
        ex:CrewStep_EmailFilterCrew_filter_emails_task .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Sequential a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
