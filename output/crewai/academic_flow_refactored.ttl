@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/academic_flow#> .
@prefix ns1: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/dcterms:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/academic_flow> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:AcademicResearchFlow a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_prof_writer,
        ex:Agent_senior_researcher ;
    agentoscin:containsOrchestration ex:Orchestration_AcademicResearchFlow ;
    agentoscin:containsTeam ex:Team_AcademicResearchCrew ;
    ns1:title "AcademicResearchFlow"^^xsd:string ;
    agentoscin:hasSourceFramework "CrewAI"^^xsd:string .

ex:AgentPrompt_prof_writer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You have published in top-tier journals and know exactly how to structure an academic paper for maximum impact and clarity."^^xsd:string ;
    agentoscin:promptInstruction "Academic Writer and Editor: Take rough notes and outlines to produce a formal, peer-review-ready academic paper."^^xsd:string .

ex:AgentPrompt_senior_researcher a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a tenured professor with years of experience navigating complex academic databases and synthesizing information."^^xsd:string ;
    agentoscin:promptInstruction "Senior Academic Researcher: Conduct extensive literature reviews and gather empirical data on the chosen topic."^^xsd:string .

ex:Config_allow_delegation_Agent_prof_writer a agentoscin:Config ;
    agentoscin:configKey "allow_delegation"^^xsd:string ;
    agentoscin:configValue "false"^^xsd:string .

ex:Config_allow_delegation_Agent_senior_researcher a agentoscin:Config ;
    agentoscin:configKey "allow_delegation"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_prof_writer a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "false"^^xsd:string .

ex:Config_verbose_Agent_senior_researcher a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Team_AcademicResearchCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:CrewStep_AcademicResearchCrew_gather_literature_task a agentoscin:StartStep ;
    ns1:title "gather_literature_task"^^xsd:string ;
    agentoscin:hasAssociatedTask ex:Task_gather_literature_task ;
    agentoscin:nextStep ex:CrewStep_AcademicResearchCrew_write_paper_task ;
    agentoscin:stepOrder 1 .

ex:FlowStep_initialize_research a agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    ns1:title "initialize_research"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_conduct_research ;
    agentoscin:stepOrder 1 .

ex:FlowStep_review_outcome a agentoscin:ConditionalStep,
        agentoscin:WorkflowStep ;
    ns1:title "review_outcome"^^xsd:string ;
    agentoscin:hasRoutingLogic """        if self.state.status == "SUCCESS":
            return "publish_paper"
        elif self.state.status == "FAILED":
            return "abort_research\""""^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_abort_research,
        ex:FlowStep_publish_paper ;
    agentoscin:stepOrder 3 .

ex:FlowWorkflowPattern_AcademicResearchFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_abort_research,
        ex:FlowStep_conduct_research,
        ex:FlowStep_initialize_research,
        ex:FlowStep_publish_paper,
        ex:FlowStep_review_outcome .

ex:Goal_prof_writer a agentoscin:Goal ;
    ns1:description "Take rough notes and outlines to produce a formal, peer-review-ready academic paper."^^xsd:string .

ex:Goal_senior_researcher a agentoscin:Goal ;
    ns1:description "Conduct extensive literature reviews and gather empirical data on the chosen topic."^^xsd:string .

ex:HumanCheckpoint_gather_literature_task a agentoscin:HumanCheckpoint ;
    agentoscin:hasCheckpointPosition "AfterExecution"^^xsd:string ;
    agentoscin:hasCheckpointType "Review"^^xsd:string ;
    agentoscin:isMandatory true .

ex:MemoryBinding_AgentPrivate_senior_researcher a agentoscin:MemoryBinding ;
    agentoscin:bindsMemory ex:Memory_AgentPrivate_senior_researcher ;
    agentoscin:hasMemoryScope "AgentPrivate"^^xsd:string .

ex:MemoryBinding_GroupShared_AcademicResearchCrew a agentoscin:MemoryBinding ;
    agentoscin:bindsMemory ex:Memory_GroupShared_AcademicResearchCrew ;
    agentoscin:hasMemoryScope "GroupShared"^^xsd:string .

ex:Memory_AgentPrivate_senior_researcher a agentoscin:Memory ;
    agentoscin:hasPersistenceScope "Persistent"^^xsd:string .

ex:Memory_GroupShared_AcademicResearchCrew a agentoscin:Memory ;
    agentoscin:hasPersistenceScope "Persistent"^^xsd:string .

ex:Orchestration_AcademicResearchFlow a agentoscin:Orchestration ;
    ns1:title "AcademicResearchFlow"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_AcademicResearchFlow ;
    agentoscin:orchestratesTeam ex:Team_AcademicResearchCrew .

ex:ReasoningPattern_Unspecified a agentoscin:Unspecified .

ex:Schema_FinalPaper a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"abstract\":{\"type\":\"string\",\"description\":\"A summary of the paper.\"},\"body_paragraphs\":{\"type\":\"string\",\"description\":\"The main text.\"},\"conclusion\":{\"type\":\"string\",\"description\":\"The final conclusion.\"}},\"required\":[\"abstract\",\"body_paragraphs\",\"conclusion\"]}"^^xsd:string .

ex:Schema_ResearchOutline a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\",\"description\":\"The title of the research topic.\"},\"key_claims\":{\"type\":\"string\",\"description\":\"The core arguments or hypotheses.\"},\"sources\":{\"type\":\"string\",\"description\":\"The academic sources found.\"}},\"required\":[\"title\",\"key_claims\",\"sources\"]}"^^xsd:string .

ex:TaskPrompt_gather_literature_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Use the search tools to gather literature on the topic. Extract key claims and references."^^xsd:string ;
    agentoscin:promptOutputIndicator "A well-structured outline containing the title, key claims, and academic sources."^^xsd:string .

ex:TaskPrompt_write_paper_task a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Take the outline and draft the final academic paper."^^xsd:string ;
    agentoscin:promptOutputIndicator "A complete paper with an abstract, body paragraphs, and conclusion."^^xsd:string .

ex:Task_gather_literature_task a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agentoscin:hasExpectedOutput "A well-structured outline containing the title, key claims, and academic sources."^^xsd:string ;
    agentoscin:hasHumanCheckpoint ex:HumanCheckpoint_gather_literature_task ;
    agentoscin:hasOutputSchema ex:Schema_ResearchOutline ;
    agentoscin:taskPrompt ex:TaskPrompt_gather_literature_task .

ex:Task_write_paper_task a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "OrchestratorDelegated"^^xsd:string ;
    agentoscin:hasExpectedOutput "A complete paper with an abstract, body paragraphs, and conclusion."^^xsd:string ;
    agentoscin:hasOutputSchema ex:Schema_FinalPaper ;
    agentoscin:taskPrompt ex:TaskPrompt_write_paper_task .

ex:Termination_AcademicResearchCrew a agentoscin:TaskCompletionTermination .

ex:Tool_AcademicSearchTool a agentoscin:Tool ;
    ns1:description "Search academic papers and journals to find relevant literature."^^xsd:string ;
    ns1:title "Academic Search Tool"^^xsd:string ;
    agentoscin:hasImplementationReference "tools.custom_tools.AcademicSearchTool._run"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"The query to search the academic database for.\"}},\"required\":[\"query\"]}"^^xsd:string .

ex:WorkflowPattern_AcademicResearchCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_AcademicResearchCrew_gather_literature_task,
        ex:CrewStep_AcademicResearchCrew_write_paper_task .

agentoscin:Custom a agentoscin:CoordinationPattern .

agentoscin:HierachicalPattern a agentoscin:CoordinationPattern .

ex:Agent_prof_writer a agentoscin:LLMAgent ;
    agentoscin:agentID "Academic Writer and Editor"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_prof_writer ;
    agentoscin:agentRole "Academic Writer and Editor"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentConfig ex:Config_allow_delegation_Agent_prof_writer,
        ex:Config_verbose_Agent_prof_writer ;
    agentoscin:hasAgentGoal ex:Goal_prof_writer ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_senior_researcher a agentoscin:LLMAgent ;
    agentoscin:agentID "Senior Academic Researcher"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_senior_researcher ;
    agentoscin:agentRole "Senior Academic Researcher"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_AcademicSearchTool ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:employsReasoningPattern ex:ReasoningPattern_Unspecified ;
    agentoscin:hasAgentConfig ex:Config_allow_delegation_Agent_senior_researcher,
        ex:Config_verbose_Agent_senior_researcher ;
    agentoscin:hasAgentGoal ex:Goal_senior_researcher ;
    agentoscin:hasMaxReasoningAttempts 3 ;
    agentoscin:hasMemoryBinding ex:MemoryBinding_AgentPrivate_senior_researcher ;
    agentoscin:hasReasoningEnabled true ;
    agentoscin:hasReasoningOrigin "FrameworkManaged"^^xsd:string ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:CrewStep_AcademicResearchCrew_write_paper_task a agentoscin:EndStep ;
    ns1:title "write_paper_task"^^xsd:string ;
    agentoscin:hasAssociatedTask ex:Task_write_paper_task ;
    agentoscin:stepOrder 2 .

ex:FlowStep_abort_research a agentoscin:EndStep ;
    ns1:title "abort_research"^^xsd:string ;
    agentoscin:stepOrder 5 .

ex:FlowStep_conduct_research a agentoscin:EndStep ;
    ns1:title "conduct_research"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_publish_paper a agentoscin:EndStep ;
    ns1:title "publish_paper"^^xsd:string ;
    agentoscin:stepOrder 4 .

ex:LM_gpt_4o a agentoscin:LanguageModel ;
    ns1:title "gpt-4o"^^xsd:string .

ex:Team_AcademicResearchCrew a agentoscin:Team ;
    ns1:title "AcademicResearchCrew"^^xsd:string ;
    agentoscin:employsCoordinationPattern agentoscin:HierachicalPattern ;
    agentoscin:hasAgentMember ex:Agent_prof_writer,
        ex:Agent_senior_researcher ;
    agentoscin:hasSystemConfig ex:Config_verbose_Team_AcademicResearchCrew ;
    agentoscin:hasTeamMemoryBinding ex:MemoryBinding_GroupShared_AcademicResearchCrew ;
    agentoscin:hasTerminationCondition ex:Termination_AcademicResearchCrew ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_AcademicResearchCrew .

