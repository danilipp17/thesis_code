@prefix agentoscin: <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin/> .
@prefix ex: <http://example.org/comp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/comp> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:ComprehensiveSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_primary_researcher,
        ex:Agent_senior_analyst ;
    agentoscin:containsOrchestration ex:Orchestration_MasterOrchestratorFlow ;
    agentoscin:containsTeam ex:Team_ComprehensiveCrew ;
    agentoscin:hasSourceFramework "CrewAI"^^xsd:string ;
    agentoscin:hasTitle "ComprehensiveSystem"^^xsd:string .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Constraint a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:ReAct a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Unspecified a owl:Class ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:agentID a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:agentResourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf agentoscin:resourceUsage .

agentoscin:agentRole a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:agentToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:agentType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:bindsMemory a owl:ObjectProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agentoscin:Memory ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:configKey a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Config ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:configValue a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Config ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:containsAgent a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsOrchestration a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Orchestration ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Environment ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:containsTeam a owl:ObjectProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:contributesToGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:Objective ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:contributesToObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:dependsOn a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:employsCoordinationPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:CoordinationPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:employsReasoningPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:ReasoningPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:envType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Environment ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasAgentCapability a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasCapability .

agentoscin:hasAgentConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasAgentGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasGoal .

agentoscin:hasAgentMember a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasAssociatedTask a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasCheckpointPosition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasCheckpointType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDelegationStrategy a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDependencyType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasDirectiveFunction a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasEdgeMapping a owl:DatatypeProperty ;
    rdfs:comment "JSON mapping of routing labels to target node names for conditional edges." ;
    rdfs:domain agentoscin:ConditionalStep ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasEnvironmentConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasExpectedOutput a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasGuardrail a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Guardrail ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasGuardrailType a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasHumanCheckpoint a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:HumanCheckpoint ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasImplementationReference a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasInputSchema a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasKnowledge a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:KnowledgeBase ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMaxReasoningAttempts a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMaxRetries a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMaxTurns a owl:DatatypeProperty ;
    rdfs:domain agentoscin:TurnLimitTermination ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasOperator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasOutputSchema a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Schema ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPersistenceScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Memory ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningEnabled a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningOrigin a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReference a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasRoutingLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:ConditionalStep ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSchemaDefinition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Schema ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSourceAttribute a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSourceFramework a owl:DatatypeProperty ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSubCondition a owl:ObjectProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range agentoscin:TerminationCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasSubPattern a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasRelatedPattern .

agentoscin:hasSystemConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasTeamGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasGoal .

agentoscin:hasTeamMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasTerminationCondition a owl:ObjectProperty ;
    rdfs:domain agentoscin:Team ;
    rdfs:range agentoscin:TerminationCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasTitle a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasToolConfig a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasConfig .

agentoscin:hasTriggerExpression a owl:DatatypeProperty ;
    rdfs:domain agentoscin:EventBasedTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasValidationLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasWorkflowPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasWorkflowStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:humanParticipatedIn a owl:ObjectProperty ;
    rdfs:domain agentoscin:HumanAgent ;
    rdfs:range agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:interactsWith a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:isMandatory a owl:DatatypeProperty ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:memoryBoundTo a owl:ObjectProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agentoscin:AgenticSystem,
        agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:nextPattern a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasRelatedPattern .

agentoscin:nextStep a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:relatedStep .

agentoscin:operatesIn a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:Environment ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:orchestratesTeam a owl:ObjectProperty ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agentoscin:Team ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedByAgent a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:LLMAgent ;
    rdfs:subPropertyOf agentoscin:performedBy .

agentoscin:producedResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:promptContext a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptInputData a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptInstruction a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:promptOutputIndicator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Prompt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:requiresCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:requiresResource a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:stepOrder a owl:DatatypeProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:taskPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:taskToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:useLanguageModel a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LanguageModel ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:AgentPrompt_primary_researcher a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "An expert web researcher."^^xsd:string ;
    agentoscin:promptInstruction "Primary Researcher: Perform extensive web research."^^xsd:string .

ex:AgentPrompt_senior_analyst a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "A senior analyst specializing in large dataset processing."^^xsd:string ;
    agentoscin:promptInstruction "Senior Data Analyst: Analyze the data provided by the researcher."^^xsd:string .

ex:Config_allow_delegation_Agent_senior_analyst a agentoscin:Config ;
    agentoscin:configKey "allow_delegation"^^xsd:string ;
    agentoscin:configValue "false"^^xsd:string .

ex:Config_verbose_Agent_primary_researcher a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:Config_verbose_Team_ComprehensiveCrew a agentoscin:Config ;
    agentoscin:configKey "verbose"^^xsd:string ;
    agentoscin:configValue "true"^^xsd:string .

ex:CrewStep_ComprehensiveCrew_data_gathering a agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_data_gathering ;
    agentoscin:hasTitle "data_gathering"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_ComprehensiveCrew_analysis_phase ;
    agentoscin:stepOrder 1 .

ex:FlowStep_initialize_system a agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "initialize_system"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_verification_router ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_MasterOrchestratorFlow a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_initialize_system,
        ex:FlowStep_run_crew_pipeline,
        ex:FlowStep_terminate,
        ex:FlowStep_verification_router .

ex:Goal_primary_researcher a agentoscin:Goal ;
    agentoscin:hasDescription "Perform extensive web research."^^xsd:string .

ex:Goal_senior_analyst a agentoscin:Goal ;
    agentoscin:hasDescription "Analyze the data provided by the researcher."^^xsd:string .

ex:HumanCheckpoint_analysis_phase a agentoscin:HumanCheckpoint ;
    agentoscin:hasCheckpointPosition "AfterExecution"^^xsd:string ;
    agentoscin:hasCheckpointType "Review"^^xsd:string ;
    agentoscin:isMandatory true .

ex:MemoryBinding_AgentPrivate_primary_researcher a agentoscin:MemoryBinding ;
    agentoscin:bindsMemory ex:Memory_AgentPrivate_primary_researcher ;
    agentoscin:hasMemoryScope "AgentPrivate"^^xsd:string .

ex:MemoryBinding_GroupShared_ComprehensiveCrew a agentoscin:MemoryBinding ;
    agentoscin:bindsMemory ex:Memory_GroupShared_ComprehensiveCrew ;
    agentoscin:hasMemoryScope "GroupShared"^^xsd:string .

ex:Memory_AgentPrivate_primary_researcher a agentoscin:Memory ;
    agentoscin:hasPersistenceScope "Persistent"^^xsd:string .

ex:Memory_GroupShared_ComprehensiveCrew a agentoscin:Memory ;
    agentoscin:hasPersistenceScope "Persistent"^^xsd:string .

ex:Orchestration_MasterOrchestratorFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasTitle "MasterOrchestratorFlow"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_MasterOrchestratorFlow .

ex:Schema_AnalysisOutput a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"type\":\"object\",\"properties\":{\"findings\":{\"type\":\"string\",\"description\":\"Key insights derived from data.\"},\"confidence_score\":{\"type\":\"number\",\"description\":\"Score between 0.0 and 1.0\"}},\"required\":[\"findings\",\"confidence_score\"]}"^^xsd:string .

ex:TaskPrompt_analysis_phase a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Analyze the raw data report."^^xsd:string ;
    agentoscin:promptOutputIndicator "A final analysis report."^^xsd:string .

ex:TaskPrompt_data_gathering a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Search the web for information."^^xsd:string ;
    agentoscin:promptOutputIndicator "A detailed report of raw data."^^xsd:string .

ex:Task_analysis_phase a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A final analysis report."^^xsd:string ;
    agentoscin:hasHumanCheckpoint ex:HumanCheckpoint_analysis_phase ;
    agentoscin:hasOutputSchema ex:Schema_AnalysisOutput ;
    agentoscin:performedByAgent ex:Agent_senior_analyst ;
    agentoscin:taskPrompt ex:TaskPrompt_analysis_phase .

ex:Task_data_gathering a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A detailed report of raw data."^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_primary_researcher ;
    agentoscin:taskPrompt ex:TaskPrompt_data_gathering ;
    agentoscin:taskToolUsage ex:Tool_web_search .

ex:Team_ComprehensiveCrew a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:HierarchicalPattern ;
    agentoscin:hasAgentMember ex:Agent_primary_researcher,
        ex:Agent_senior_analyst ;
    agentoscin:hasSystemConfig ex:Config_verbose_Team_ComprehensiveCrew ;
    agentoscin:hasTeamMemoryBinding ex:MemoryBinding_GroupShared_ComprehensiveCrew ;
    agentoscin:hasTerminationCondition ex:Termination_ComprehensiveCrew ;
    agentoscin:hasTitle "ComprehensiveCrew"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_ComprehensiveCrew .

ex:Termination_ComprehensiveCrew a agentoscin:TaskCompletionTermination .

ex:Tool_DatabaseTool a agentoscin:Tool ;
    agentoscin:hasReference "external:DatabaseTool"^^xsd:string ;
    agentoscin:hasTitle "DatabaseTool"^^xsd:string .

ex:WorkflowPattern_ComprehensiveCrew a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_ComprehensiveCrew_analysis_phase,
        ex:CrewStep_ComprehensiveCrew_data_gathering .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern .

agentoscin:HierarchicalPattern a agentoscin:CoordinationPattern .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:CrewStep_ComprehensiveCrew_analysis_phase a agentoscin:EndStep ;
    agentoscin:hasAssociatedTask ex:Task_analysis_phase ;
    agentoscin:hasTitle "analysis_phase"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_run_crew_pipeline a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "run_crew_pipeline"^^xsd:string ;
    agentoscin:stepOrder 3 .

ex:FlowStep_terminate a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "terminate"^^xsd:string ;
    agentoscin:stepOrder 4 .

ex:FlowStep_verification_router a agentoscin:ConditionalStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasRoutingLogic """        if self.state.topic:
            return "execute_crew"
        return "halt_system\""""^^xsd:string ;
    agentoscin:hasTitle "verification_router"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_run_crew_pipeline,
        ex:FlowStep_terminate ;
    agentoscin:stepOrder 2 .

