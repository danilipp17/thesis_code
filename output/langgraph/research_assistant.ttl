    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:stepOrder a owl:DatatypeProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:taskPrompt a owl:ObjectProperty ;
    rdfs:subPropertyOf agentoscin:hasPrompt .

agentoscin:taskToolUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf agentoscin:toolUsage .

agentoscin:useLanguageModel a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:LanguageModel ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:AgentPrompt_researcher a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a research assistant. Your goal is to gather comprehensive information on the given topic. Use the search_web tool to find information and save_notes to record your findings."^^xsd:string ;
    agentoscin:promptInstruction "researcher: Research agent that gathers information using tools."^^xsd:string .

ex:AgentPrompt_writer a agentoscin:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agentoscin:promptContext "You are a professional writer. Your goal is to produce a clear, concise summary based on the research provided. Write in a formal academic style."^^xsd:string ;
    agentoscin:promptInstruction "writer: Writer agent that produces a summary from research notes."^^xsd:string .

ex:CrewStep_langgraph_team_0_task_researcher a agentoscin:StartStep ;
    agentoscin:hasAssociatedTask ex:Task_task_researcher ;
    agentoscin:hasTitle "task_researcher"^^xsd:string ;
    agentoscin:nextStep ex:CrewStep_langgraph_team_0_task_writer ;
    agentoscin:stepOrder 1 .

ex:FlowWorkflowPattern_StateGraph a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:FlowStep_researcher,
        ex:FlowStep_writer .

ex:Goal_researcher a agentoscin:Goal ;
    agentoscin:hasDescription "Research agent that gathers information using tools."^^xsd:string .

ex:Goal_writer a agentoscin:Goal ;
    agentoscin:hasDescription "Writer agent that produces a summary from research notes."^^xsd:string .

ex:Orchestration_StateGraph a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Custom ;
    agentoscin:hasOutputSchema ex:StateSchema_StateGraph ;
    agentoscin:hasTitle "StateGraph"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:FlowWorkflowPattern_StateGraph .

ex:RoutingTermination_langgraph_team_0_0 a agentoscin:RoutingTermination .

ex:StateSchema_StateGraph a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"messages\": \"Annotated[list, add_messages]\", \"research_notes\": \"str\", \"final_summary\": \"str\"}"^^xsd:string ;
    agentoscin:hasTitle "ResearchState"^^xsd:string .

ex:TaskPrompt_task_researcher a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform researcher responsibilities"^^xsd:string .

ex:TaskPrompt_task_writer a agentoscin:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agentoscin:promptInstruction "Perform writer responsibilities"^^xsd:string .

ex:Task_task_writer a agentoscin:Task ;
    agentoscin:dependsOn ex:Task_task_researcher ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_writer ;
    agentoscin:taskPrompt ex:TaskPrompt_task_writer .

ex:Team_langgraph_team_0 a agentoscin:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Hierarchical ;
    agentoscin:hasAgentMember ex:Agent_researcher,
        ex:Agent_writer ;
    agentoscin:hasTerminationCondition ex:RoutingTermination_langgraph_team_0_0 ;
    agentoscin:hasTitle "StateGraph"^^xsd:string ;
    agentoscin:hasWorkflowPattern ex:WorkflowPattern_langgraph_team_0 .

ex:Tool_save_notes a agentoscin:Tool ;
    agentoscin:hasDescription "Save research notes for later use."^^xsd:string ;
    agentoscin:hasImplementationReference "research_assistant.save_notes"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\": \"object\", \"properties\": {\"notes\": {\"type\": \"string\"}}, \"required\": [\"notes\"]}"^^xsd:string ;
    agentoscin:hasTitle "save_notes"^^xsd:string .

ex:Tool_search_web a agentoscin:Tool ;
    agentoscin:hasDescription "Search the web for information on a given topic."^^xsd:string ;
    agentoscin:hasImplementationReference "research_assistant.search_web"^^xsd:string ;
    agentoscin:hasInputSchema "{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}"^^xsd:string ;
    agentoscin:hasTitle "search_web"^^xsd:string .

ex:WorkflowPattern_langgraph_team_0 a agentoscin:WorkflowPattern ;
    agentoscin:hasWorkflowStep ex:CrewStep_langgraph_team_0_task_researcher,
        ex:CrewStep_langgraph_team_0_task_writer .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:Hierarchical a agentoscin:CoordinationPattern,
        owl:NamedIndividual .

agentoscin:HumanAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

agentoscin:Model a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:StatisticalModel a owl:Class ;
    rdfs:subClassOf agentoscin:Model .

agentoscin:TaskCompletionTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasCapability a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Capability ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:performedBy a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:relatedStep a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowStep ;
    rdfs:range agentoscin:WorkflowStep ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:resourceUsage a owl:ObjectProperty ;
    rdfs:domain agentoscin:Tool ;
    rdfs:range agentoscin:Resource ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:CrewStep_langgraph_team_0_task_writer a agentoscin:EndStep ;
    agentoscin:hasAssociatedTask ex:Task_task_writer ;
    agentoscin:hasTitle "task_writer"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:FlowStep_researcher a agentoscin:ConditionalStep,
        agentoscin:StartStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasEdgeMapping "{\"researcher\": \"researcher\", \"writer\": \"writer\"}"^^xsd:string ;
    agentoscin:hasRoutingLogic """last_message = state['messages'][-1]
if hasattr(last_message, 'tool_calls') and last_message.tool_calls:
    return 'researcher'
return 'writer'"""^^xsd:string ;
    agentoscin:hasTitle "researcher"^^xsd:string ;
    agentoscin:nextStep ex:FlowStep_researcher,
        ex:FlowStep_writer ;
    agentoscin:stepOrder 1 .

ex:FlowStep_writer a agentoscin:EndStep,
        agentoscin:WorkflowStep ;
    agentoscin:hasTitle "writer"^^xsd:string ;
    agentoscin:stepOrder 2 .

ex:LM_gpt_4o a agentoscin:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

ex:Task_task_researcher a agentoscin:Task ;
    agentoscin:hasDelegationStrategy "TopologyDetermined"^^xsd:string ;
    agentoscin:performedByAgent ex:Agent_researcher ;
    agentoscin:taskPrompt ex:TaskPrompt_task_researcher .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:EndStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:EventBasedTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Instance a owl:Class ;
    rdfs:subClassOf agentoscin:Resource .

agentoscin:LanguageModel a owl:Class ;
    rdfs:subClassOf agentoscin:StatisticalModel .

agentoscin:Memory a owl:Class ;
    rdfs:subClassOf agentoscin:KnowledgeBase .

agentoscin:Plan a owl:Class .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:StartStep a owl:Class ;
    rdfs:subClassOf agentoscin:WorkflowStep .

agentoscin:Step a owl:Class .

agentoscin:System a owl:Class .

agentoscin:TurnLimitTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasGoal a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Goal ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPrompt a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Task ;
    rdfs:range agentoscin:Prompt ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasRelatedPattern a owl:ObjectProperty ;
    rdfs:domain agentoscin:WorkflowPattern ;
    rdfs:range agentoscin:WorkflowPattern ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:toolUsage a owl:ObjectProperty ;
    rdfs:range agentoscin:Tool ;
    rdfs:subPropertyOf owl:topObjectProperty .

ex:Agent_researcher a agentoscin:LLMAgent ;
    agentoscin:agentID "researcher"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_researcher ;
    agentoscin:agentRole "researcher"^^xsd:string ;
    agentoscin:agentToolUsage ex:Tool_save_notes,
        ex:Tool_search_web ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_researcher ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

ex:Agent_writer a agentoscin:LLMAgent ;
    agentoscin:agentID "writer"^^xsd:string ;
    agentoscin:agentPrompt ex:AgentPrompt_writer ;
    agentoscin:agentRole "writer"^^xsd:string ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasAgentGoal ex:Goal_writer ;
    agentoscin:hasReasoningEnabled false ;
    agentoscin:useLanguageModel ex:LM_gpt_4o .

agentoscin:Capability a owl:Class .

agentoscin:CompositeTermination a owl:Class ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Environment a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:KnowledgeBase a owl:Class ;
    rdfs:subClassOf agentoscin:Instance .

agentoscin:Objective a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Agent a owl:Class .

agentoscin:Config a owl:Class .

agentoscin:Context a owl:Class .

agentoscin:Goal a owl:Class ;
    rdfs:subClassOf agentoscin:Context .

agentoscin:Schema a owl:Class .

agentoscin:hasConfig a owl:ObjectProperty ;
    rdfs:domain agentoscin:Agent,
        agentoscin:AgenticSystem,
        agentoscin:Capability,
        agentoscin:Config,
        agentoscin:Context,
        agentoscin:CoordinationPattern,
        agentoscin:Guardrail,
        agentoscin:HumanCheckpoint,
        agentoscin:MemoryBinding,
        agentoscin:Orchestration,
        agentoscin:Plan,
        agentoscin:Prompt,
        agentoscin:ReasoningPattern,
        agentoscin:Resource,
        agentoscin:Schema,
        agentoscin:Step,
        agentoscin:System,
        agentoscin:Task,
        agentoscin:TerminationCondition,
        agentoscin:Tool ;
    rdfs:range agentoscin:Config ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:Guardrail a owl:Class .

agentoscin:HumanCheckpoint a owl:Class .

agentoscin:Orchestration a owl:Class ;
    rdfs:subClassOf agentoscin:Team .

agentoscin:WorkflowPattern a owl:Class ;
    rdfs:subClassOf agentoscin:Plan .

agentoscin:AgenticSystem a owl:Class .

agentoscin:MemoryBinding a owl:Class .

agentoscin:ReasoningPattern a owl:Class .

agentoscin:Resource a owl:Class .

agentoscin:TerminationCondition a owl:Class .

agentoscin:CoordinationPattern a owl:Class .

agentoscin:Tool a owl:Class .

agentoscin:Team a owl:Class ;
    rdfs:subClassOf agentoscin:System .

agentoscin:WorkflowStep a owl:Class ;
    rdfs:subClassOf agentoscin:Step .

agentoscin:Prompt a owl:Class .

agentoscin:Task a owl:Class .

agentoscin:LLMAgent a owl:Class ;
    rdfs:subClassOf agentoscin:Agent .

[] a owl:AllDisjointClasses ;
    owl:members ( agentoscin:CompositeTermination agentoscin:EventBasedTermination agentoscin:RoutingTermination agentoscin:TaskCompletionTermination agentoscin:TurnLimitTermination ) .

