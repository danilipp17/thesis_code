    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasMemoryScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasObjective a owl:ObjectProperty ;
    rdfs:domain agentoscin:LLMAgent,
        agentoscin:Team ;
    rdfs:range agentoscin:Objective ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasOperator a owl:DatatypeProperty ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasOutputSchema a owl:ObjectProperty ;
    rdfs:domain agentoscin:Task ;
    rdfs:range agentoscin:Schema ;
    rdfs:subPropertyOf owl:topObjectProperty .

agentoscin:hasPersistenceScope a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Memory ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningEnabled a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReasoningOrigin a owl:DatatypeProperty ;
    rdfs:domain agentoscin:LLMAgent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasReference a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasRoutingLogic a owl:DatatypeProperty ;
    rdfs:domain agentoscin:ConditionalStep ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

agentoscin:hasSchemaDefinition a owl:DatatypeProperty ;
    rdfs:domain agentoscin:Schema ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

